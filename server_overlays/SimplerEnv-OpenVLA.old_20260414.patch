+#!/usr/bin/env python3
+"""Hybrid main_quant entry for SimplerEnv-OpenVLA.
+
+Supports two execution branches:
+
+1) Native branch (new):
+   - Keep entrypoint as `main_quant.py`
+   - Run SimplerEnv-OpenVLA's native OpenVLA evaluator stack
+   - Enabled by `--native-openvla` or env `FORCE_NATIVE_OPENVLA=1`
+
+2) Upstream forwarding branch (existing behavior):
+   - Forward to `/data5/cgk_lyy_0/zwt/SimplerEnv/openvla-oft/main_quant.py`
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import os
+import runpy
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Dict, Iterable, List, Tuple
+
+import numpy as np
+
+
+def _resolve_upstream_main_quant() -> Path:
+    this_dir = Path(__file__).resolve().parent
+
+    candidates = [
+        this_dir.parent / "SimplerEnv" / "openvla-oft" / "main_quant.py",
+        Path(os.environ.get("OPENVLA_MAIN_QUANT_PATH", "")) if os.environ.get("OPENVLA_MAIN_QUANT_PATH") else None,
+    ]
+
+    for c in candidates:
+        if c and c.is_file():
+            return c
+
+    raise FileNotFoundError(
+        "Cannot find upstream main_quant.py. Expected at "
+        f"{this_dir.parent / 'SimplerEnv' / 'openvla-oft' / 'main_quant.py'} "
+        "or set OPENVLA_MAIN_QUANT_PATH."
+    )
+
+
+def _parse_kv_list_to_dict(items: Iterable[str] | None) -> Dict:
+    out: Dict = {}
+    if not items:
+        return out
+    for kv in items:
+        if "=" not in kv:
+            continue
+        k, v = kv.split("=", 1)
+        try:
+            out[k] = ast.literal_eval(v)
+        except Exception:
+            out[k] = v
+    return out
+
+
+def _to_quat_list(flat_quats: List[float] | List[List[float]]) -> List[np.ndarray]:
+    if len(flat_quats) == 0:
+        return []
+    if isinstance(flat_quats[0], (list, tuple, np.ndarray)):
+        return [np.asarray(q, dtype=np.float64) for q in flat_quats]  # type: ignore[index]
+    if len(flat_quats) % 4 != 0:
+        raise ValueError(f"robot_init_quats length must be divisible by 4, got {len(flat_quats)}")
+    arr = []
+    for i in range(0, len(flat_quats), 4):
+        arr.append(np.asarray(flat_quats[i : i + 4], dtype=np.float64))
+    return arr
+
+
+def _build_eval_args_from_task(task: dict, fallback_model: str | None) -> SimpleNamespace:
+    args = SimpleNamespace()
+    args.policy_model = "openvla"
+    args.ckpt_path = task.get("model") or fallback_model
+    if not args.ckpt_path:
+        raise ValueError("Missing model path: task['model'] and --model are both empty")
+
+    args.policy_setup = task.get("policy_setup", "widowx_bridge")
+    args.robot = task.get("robot", "widowx")
+    args.env_name = task.get("env_name")
+    args.scene_name = task.get("scene_name")
+    args.action_scale = float(task.get("action_scale", 1.0))
+    args.control_freq = int(task.get("control_freq", 3))
+    args.sim_freq = int(task.get("sim_freq", 513))
+    args.max_episode_steps = int(task.get("max_episode_steps", 80))
+    args.enable_raytracing = bool(task.get("enable_raytracing", False))
+    args.additional_env_save_tags = task.get("additional_env_save_tags", None)
+    args.rgb_overlay_path = task.get("rgb_overlay_path", None)
+    args.obs_camera_name = task.get("obs_camera_name", None)
+    args.logging_dir = task.get("logging_dir", "./results")
+
+    args.obj_variation_mode = task.get("obj_variation_mode", "episode")
+    args.obj_episode_range = task.get("obj_episode_range", [0, 1])
+    args.obj_init_xs = np.asarray(task.get("obj_init_xs", []), dtype=np.float64)
+    args.obj_init_ys = np.asarray(task.get("obj_init_ys", []), dtype=np.float64)
+
+    args.robot_init_xs = np.asarray(task.get("robot_init_xs", [0.0]), dtype=np.float64)
+    args.robot_init_ys = np.asarray(task.get("robot_init_ys", [0.0]), dtype=np.float64)
+    args.robot_init_quats = _to_quat_list(task.get("robot_init_quats", [1.0, 0.0, 0.0, 0.0]))
+
+    add_kwargs = task.get("additional_env_build_kwargs", {})
+    if isinstance(add_kwargs, dict):
+        args.additional_env_build_kwargs = dict(add_kwargs)
+    elif isinstance(add_kwargs, list):
+        args.additional_env_build_kwargs = _parse_kv_list_to_dict(add_kwargs)
+    else:
+        args.additional_env_build_kwargs = {}
+
+    if not args.env_name or not args.scene_name:
+        raise ValueError(f"Invalid task: env_name/scene_name missing in {task}")
+
+    return args
+
+
+def _apply_policy_runtime_config(model: "OpenVLAInference", policy_setup: str, unnorm_key: str | None) -> None:
+    model.policy_setup = policy_setup
+    if policy_setup == "widowx_bridge":
+        model.sticky_gripper_num_repeat = 1
+        model.unnorm_key = "bridge_orig" if unnorm_key is None else unnorm_key
+    elif policy_setup == "google_robot":
+        model.sticky_gripper_num_repeat = 15
+        model.unnorm_key = "fractal20220817_data" if unnorm_key is None else unnorm_key
+    else:
+        raise NotImplementedError(
+            f"Policy setup {policy_setup} not supported for openvla native eval."
+        )
+
+
+def _run_native_openvla(tasks: List[dict], fallback_model: str | None) -> None:
+    from simpler_env.evaluation.maniskill2_evaluator import maniskill2_evaluator
+    from simpler_env.policies.openvla.openvla_model import OpenVLAInference
+
+    # Reuse heavyweight model per checkpoint to avoid OOM when task groups
+    # switch policy_setup / unnorm_key in one batched run.
+    model_cache: Dict[str, OpenVLAInference] = {}
+
+    for i, task in enumerate(tasks):
+        label = str(task.get("result_label", f"SimplerEnv Native OpenVLA #{i+1}"))
+        args = _build_eval_args_from_task(task, fallback_model)
+        unnorm_key = task.get("unnorm_key", None)
+
+        cache_key = args.ckpt_path
+        if cache_key not in model_cache:
+            model_cache[cache_key] = OpenVLAInference(
+                saved_model_path=args.ckpt_path,
+                unnorm_key=unnorm_key,
+                policy_setup=args.policy_setup,
+                action_scale=args.action_scale,
+            )
+        model = model_cache[cache_key]
+        # Update lightweight runtime configs per task while reusing model weights.
+        model.action_scale = args.action_scale
+        _apply_policy_runtime_config(model, args.policy_setup, unnorm_key)
+
+        print(f"\n[{label}]")
+        success_arr = maniskill2_evaluator(model, args)
+        n = len(success_arr)
+        avg_entire = float(np.mean(success_arr)) if n > 0 else 0.0
+        # Native evaluator没有partial定义，这里与entire对齐输出，兼容现有汇总脚本
+        avg_partial = avg_entire
+        print(f"[{label}] Entire  success: {avg_entire:.4f} ({avg_entire*100:.1f}%) — {int(np.sum(success_arr))}/{n}")
+        print(f"[{label}] Partial success: {avg_partial:.4f} ({avg_partial*100:.1f}%) — {int(np.sum(success_arr))}/{n}")
+
+
+def _dispatch_native_or_forward() -> None:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--native-openvla", action="store_true")
+    parser.add_argument("--simplerenv_tasks_json", type=str, default=None)
+    parser.add_argument("--model", type=str, default=None)
+    known, _ = parser.parse_known_args()
+
+    force_native = os.environ.get("FORCE_NATIVE_OPENVLA", "0") == "1"
+    if known.native_openvla or force_native:
+        if known.simplerenv_tasks_json:
+            with open(known.simplerenv_tasks_json, "r", encoding="utf-8") as f:
+                payload = json.load(f)
+            if not isinstance(payload, list):
+                raise ValueError("--simplerenv_tasks_json must be a JSON list")
+            tasks = payload
+            print(f"[SimplerEnv-Native] Loaded {len(tasks)} tasks from {known.simplerenv_tasks_json}")
+        else:
+            # Single-task minimal mode: require env/scene via CLI unknown args is not parsed here.
+            raise ValueError("Native branch requires --simplerenv_tasks_json")
+
+        _run_native_openvla(tasks=tasks, fallback_model=known.model)
+        return
+
+    upstream = _resolve_upstream_main_quant()
+    upstream_repo = upstream.parent
+    if str(upstream_repo) not in sys.path:
+        sys.path.insert(0, str(upstream_repo))
+
+    sys.argv[0] = str(upstream)
+    runpy.run_path(str(upstream), run_name="__main__")
+
+
+def main() -> None:
+    _dispatch_native_or_forward()
+
+
+if __name__ == "__main__":
+    main()
