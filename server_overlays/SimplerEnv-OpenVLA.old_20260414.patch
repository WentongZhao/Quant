@@ -0,0 +1,260 @@
+#!/usr/bin/env python3
+"""FP evaluation entrypoint for SimplerEnv-OpenVLA.
+
+Design goals:
+1) Keep a single extensible evaluation framework (task-batch, shared model cache).
+2) FP-only for now (native OpenVLA checkpoint inference).
+3) Stay outside `simpler_env/` so future backends can be integrated here.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import copy
+import json
+import os
+from types import SimpleNamespace
+from typing import Any, Dict, Iterable, List, Tuple
+
+import numpy as np
+
+from simpler_env.evaluation.maniskill2_evaluator import maniskill2_evaluator
+from simpler_env.policies.openvla.openvla_model import OpenVLAInference
+
+
+RESERVED_ENV_BUILD_KWARGS = {
+    "obs_mode",
+    "robot",
+    "sim_freq",
+    "control_mode",
+    "control_freq",
+    "max_episode_steps",
+    "scene_name",
+    "camera_cfgs",
+    "rgb_overlay_path",
+}
+
+
+def _parse_kv_list_to_dict(items: Iterable[str] | None) -> Dict[str, Any]:
+    out: Dict[str, Any] = {}
+    if not items:
+        return out
+    for kv in items:
+        if "=" not in kv:
+            raise ValueError(f"Invalid additional_env_build_kwargs entry '{kv}', expected key=value")
+        k, v = kv.split("=", 1)
+        if k in RESERVED_ENV_BUILD_KWARGS:
+            raise ValueError(f"additional_env_build_kwargs cannot override reserved key '{k}'")
+        try:
+            out[k] = ast.literal_eval(v)
+        except Exception:
+            out[k] = v
+    return out
+
+
+def _to_quat_list(flat_quats: List[float] | List[List[float]]) -> List[np.ndarray]:
+    if len(flat_quats) == 0:
+        return []
+    if isinstance(flat_quats[0], (list, tuple, np.ndarray)):
+        return [np.asarray(q, dtype=np.float64) for q in flat_quats]  # type: ignore[index]
+    if len(flat_quats) % 4 != 0:
+        raise ValueError(f"robot_init_quats length must be divisible by 4, got {len(flat_quats)}")
+    arr: List[np.ndarray] = []
+    for i in range(0, len(flat_quats), 4):
+        arr.append(np.asarray(flat_quats[i : i + 4], dtype=np.float64))
+    return arr
+
+
+def _apply_policy_runtime_config(model: OpenVLAInference, policy_setup: str, unnorm_key: str | None) -> None:
+    model.policy_setup = policy_setup
+    if policy_setup == "widowx_bridge":
+        model.sticky_gripper_num_repeat = 1
+        model.unnorm_key = "bridge_orig" if unnorm_key is None else unnorm_key
+    elif policy_setup == "google_robot":
+        model.sticky_gripper_num_repeat = 15
+        model.unnorm_key = "fractal20220817_data" if unnorm_key is None else unnorm_key
+    else:
+        raise NotImplementedError(f"Policy setup {policy_setup} not supported for OpenVLA FP eval.")
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(formatter_class=argparse.RawTextHelpFormatter)
+    parser.add_argument("--model", type=str, required=True, help="OpenVLA checkpoint path.")
+    parser.add_argument("--policy_model", type=str, default="openvla", choices=["openvla"])
+    parser.add_argument("--policy_setup", type=str, default="google_robot", choices=["google_robot", "widowx_bridge"])
+    parser.add_argument("--unnorm_key", type=str, default=None)
+    parser.add_argument("--action_scale", type=float, default=1.0)
+    parser.add_argument("--robot", type=str, default="google_robot_static")
+    parser.add_argument("--env_name", type=str, default=None)
+    parser.add_argument("--scene_name", type=str, default=None)
+    parser.add_argument("--robot_init_xs", type=float, nargs="+", default=[0.35])
+    parser.add_argument("--robot_init_ys", type=float, nargs="+", default=[0.20])
+    parser.add_argument("--robot_init_quats", type=float, nargs="+", default=[0.0, 0.0, 0.0, 1.0])
+    parser.add_argument("--control_freq", type=int, default=3)
+    parser.add_argument("--sim_freq", type=int, default=513)
+    parser.add_argument("--max_episode_steps", type=int, default=80)
+    parser.add_argument("--rgb_overlay_path", type=str, default=None)
+    parser.add_argument("--obs_camera_name", type=str, default=None)
+    parser.add_argument("--logging_dir", type=str, default="./results")
+    parser.add_argument("--enable_raytracing", action="store_true")
+    parser.add_argument("--additional_env_save_tags", type=str, default=None)
+    parser.add_argument("--obj_variation_mode", type=str, default="episode", choices=["xy", "episode"])
+    parser.add_argument("--obj_init_xs", type=float, nargs="+", default=[])
+    parser.add_argument("--obj_init_ys", type=float, nargs="+", default=[])
+    parser.add_argument("--obj_episode_range", type=int, nargs=2, default=[0, 1])
+    parser.add_argument("--additional_env_build_kwargs", nargs="*", default=[])
+    parser.add_argument(
+        "--simplerenv_tasks_json",
+        type=str,
+        default=None,
+        help="Optional JSON list of task dicts. Task keys can override CLI fields.",
+    )
+    return parser.parse_args()
+
+
+def _load_task_list(task_json_path: str) -> list[dict]:
+    with open(task_json_path, "r", encoding="utf-8") as f:
+        payload = json.load(f)
+    if not isinstance(payload, list):
+        raise ValueError("--simplerenv_tasks_json must point to a JSON list")
+    if len(payload) == 0:
+        raise ValueError("--simplerenv_tasks_json contains an empty task list")
+    for i, item in enumerate(payload):
+        if not isinstance(item, dict):
+            raise ValueError(f"Task entry #{i} must be an object/dict")
+    return payload
+
+
+def _build_task_args(base_args: argparse.Namespace, task_dict: dict, idx: int) -> tuple[argparse.Namespace, str]:
+    args_i = copy.deepcopy(base_args)
+    label = str(task_dict.get("result_label", f"SimplerEnv FP Evaluation #{idx + 1}"))
+
+    blocked_keys = {"simplerenv_tasks_json", "policy_model", "result_label"}
+    for key, value in task_dict.items():
+        if key in blocked_keys:
+            continue
+        if not hasattr(args_i, key):
+            raise ValueError(f"Unknown task key in --simplerenv_tasks_json: {key}")
+        setattr(args_i, key, value)
+
+    return args_i, label
+
+
+def _validate_eval_args(args: argparse.Namespace) -> None:
+    if args.policy_model != "openvla":
+        raise NotImplementedError("Only --policy_model openvla is supported in FP mode.")
+    if args.action_scale <= 0:
+        raise ValueError("--action_scale must be positive")
+    if not args.env_name or not args.scene_name:
+        raise ValueError("--env_name and --scene_name are required")
+    if len(args.robot_init_quats) == 0:
+        raise ValueError("--robot_init_quats cannot be empty")
+    if args.obj_variation_mode == "xy":
+        if len(args.obj_init_xs) == 0 or len(args.obj_init_ys) == 0:
+            raise ValueError("obj_init_xs and obj_init_ys are required when --obj_variation_mode=xy")
+    else:
+        if len(args.obj_episode_range) != 2 or not (0 <= args.obj_episode_range[0] < args.obj_episode_range[1]):
+            raise ValueError("obj_episode_range must be [start, end] with 0 <= start < end")
+
+
+def _make_runtime_args(args: argparse.Namespace) -> SimpleNamespace:
+    run_args = SimpleNamespace()
+    run_args.policy_model = args.policy_model
+    run_args.ckpt_path = args.model
+    run_args.policy_setup = args.policy_setup
+    run_args.robot = args.robot
+    run_args.env_name = args.env_name
+    run_args.scene_name = args.scene_name
+    run_args.action_scale = float(args.action_scale)
+    run_args.control_freq = int(args.control_freq)
+    run_args.sim_freq = int(args.sim_freq)
+    run_args.max_episode_steps = int(args.max_episode_steps)
+    run_args.enable_raytracing = bool(args.enable_raytracing)
+    run_args.additional_env_save_tags = args.additional_env_save_tags
+    run_args.rgb_overlay_path = args.rgb_overlay_path
+    run_args.obs_camera_name = args.obs_camera_name
+    run_args.logging_dir = args.logging_dir
+    run_args.obj_variation_mode = args.obj_variation_mode
+    run_args.obj_episode_range = list(args.obj_episode_range)
+    run_args.obj_init_xs = np.asarray(args.obj_init_xs, dtype=np.float64)
+    run_args.obj_init_ys = np.asarray(args.obj_init_ys, dtype=np.float64)
+    run_args.robot_init_xs = np.asarray(args.robot_init_xs, dtype=np.float64)
+    run_args.robot_init_ys = np.asarray(args.robot_init_ys, dtype=np.float64)
+    run_args.robot_init_quats = _to_quat_list(list(args.robot_init_quats))
+
+    add_kwargs = args.additional_env_build_kwargs
+    if isinstance(add_kwargs, dict):
+        run_args.additional_env_build_kwargs = dict(add_kwargs)
+    elif isinstance(add_kwargs, list):
+        run_args.additional_env_build_kwargs = _parse_kv_list_to_dict(add_kwargs)
+    else:
+        run_args.additional_env_build_kwargs = {}
+
+    if "renderer_kwargs" not in run_args.additional_env_build_kwargs and not os.environ.get("DISPLAY"):
+        run_args.additional_env_build_kwargs["renderer_kwargs"] = {"offscreen_only": True}
+
+    return run_args
+
+
+def _normalize_eval_results(eval_results: Any) -> Tuple[np.ndarray, np.ndarray]:
+    if isinstance(eval_results, dict) and "entire" in eval_results and "partial" in eval_results:
+        entire = np.asarray(eval_results["entire"], dtype=np.float32)
+        partial = np.asarray(eval_results["partial"], dtype=np.float32)
+        return entire, partial
+
+    arr = np.asarray(eval_results, dtype=np.float32)
+    return arr, arr
+
+
+def _run_task(
+    task_args: argparse.Namespace,
+    label: str,
+    model_cache: Dict[str, OpenVLAInference],
+) -> None:
+    _validate_eval_args(task_args)
+    runtime_args = _make_runtime_args(task_args)
+    unnorm_key = task_args.unnorm_key
+
+    cache_key = str(task_args.model)
+    if cache_key not in model_cache:
+        model_cache[cache_key] = OpenVLAInference(
+            saved_model_path=task_args.model,
+            unnorm_key=unnorm_key,
+            policy_setup=task_args.policy_setup,
+            action_scale=task_args.action_scale,
+        )
+
+    model = model_cache[cache_key]
+    model.action_scale = task_args.action_scale
+    _apply_policy_runtime_config(model, task_args.policy_setup, unnorm_key)
+
+    os.makedirs(task_args.logging_dir, exist_ok=True)
+    print(f"\n[{label}]")
+    eval_results = maniskill2_evaluator(model, runtime_args)
+    entire_arr, partial_arr = _normalize_eval_results(eval_results)
+
+    n = len(entire_arr)
+    avg_entire = float(np.mean(entire_arr)) if n > 0 else 0.0
+    avg_partial = float(np.mean(partial_arr)) if n > 0 else 0.0
+    print(f"[{label}] Entire  success: {avg_entire:.4f} ({avg_entire * 100:.1f}%) — {int(np.sum(entire_arr))}/{n}")
+    print(f"[{label}] Partial success: {avg_partial:.4f} ({avg_partial * 100:.1f}%) — {int(np.sum(partial_arr))}/{n}")
+
+
+def main() -> None:
+    args = _parse_args()
+
+    if args.simplerenv_tasks_json:
+        tasks = _load_task_list(args.simplerenv_tasks_json)
+        print(f"[SimplerEnv-FP] Loaded {len(tasks)} tasks from {args.simplerenv_tasks_json}")
+    else:
+        tasks = [{}]
+
+    model_cache: Dict[str, OpenVLAInference] = {}
+    for i, task_dict in enumerate(tasks):
+        task_args, label = _build_task_args(args, task_dict, i)
+        _run_task(task_args, label, model_cache)
+
+
+if __name__ == "__main__":
+    main()
