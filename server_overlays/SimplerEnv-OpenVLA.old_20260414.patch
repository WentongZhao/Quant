+MODELING_FILE="${MODEL_PATH}/modeling_prismatic.py"
+if [[ -f "${MODELING_FILE}" ]]; then
+    LINE_COUNT=$(wc -l < "${MODELING_FILE}")
+    if (( LINE_COUNT > 600 )); then
+        echo "[ERROR] ${MODELING_FILE} has ${LINE_COUNT} lines — looks like OFT version!"
+        echo "[ERROR] Expected ~562 lines (original openvla-7b)."
+        echo "[ERROR] Restoring from backup..."
+
+        # 尝试从已知的原版 backup 恢复
+        BACKUP_CANDIDATES=(
+            "${MODEL_PATH}/modeling_prismatic.py.back.20260330_221013"
+            "${MODEL_PATH}/modeling_prismatic.py.back.20260331_202934"
+        )
+        RESTORED=0
+        for bk in "${BACKUP_CANDIDATES[@]}"; do
+            if [[ -f "$bk" ]]; then
+                bk_lines=$(wc -l < "$bk")
+                if (( bk_lines < 600 )); then
+                    cp "$bk" "${MODELING_FILE}"
+                    echo "[FIXED] Restored from ${bk} (${bk_lines} lines)"
