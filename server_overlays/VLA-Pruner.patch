+import os
+import torch
+
+if not torch.cuda.is_available():
+    raise SystemExit("[ERROR] CUDA is not available in this environment.")
+if torch.cuda.device_count() < 1:
+    raise SystemExit("[ERROR] No CUDA device is visible to torch.")
+
+props = torch.cuda.get_device_properties(0)
+total_gb = props.total_memory / (1024 ** 3)
+print(f"[INFO] torch device[0]: {props.name}, total_memory={total_gb:.2f} GiB")
+
+# 24GB-class sanity check to avoid accidentally running on a 20GB card.
+if props.total_memory < 22 * (1024 ** 3):
+    raise SystemExit(
+        "[ERROR] Detected <22GiB VRAM on torch device[0]. "
+        "This is likely not the intended 24GB GPU; aborting to avoid OOM."
+    )
+
+free_bytes, total_bytes = torch.cuda.mem_get_info(0)
+free_gb = free_bytes / (1024 ** 3)
+min_free_gb_raw = os.getenv("MIN_FREE_GB", "20")
+try:
+    min_free_gb = float(min_free_gb_raw)
+except ValueError:
+    raise SystemExit(f"[ERROR] MIN_FREE_GB must be a number, got: {min_free_gb_raw!r}")
+print(f"[INFO] torch device[0] free_memory={free_gb:.2f} GiB")
+if free_gb < min_free_gb:
+    raise SystemExit(
+        f"[ERROR] Free VRAM ({free_gb:.2f} GiB) < MIN_FREE_GB ({min_free_gb:.2f} GiB). "
+        "Another process is occupying this GPU; stop it or pick another GPU."
+    )
