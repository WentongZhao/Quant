index 0000000..d6f66a4
--- /dev/null
+++ b/src/openvla/vla_pruner_srcipts/run_vla_pruner/run_oft_libero_spatial.sh
@@ -0,0 +1,473 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Independent VLA-Pruner evaluation script for OFT LIBERO-Spatial checkpoint.
+# This script does NOT depend on or modify SimplerEnv/openvla-oft/quant.sh.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+OPENVLA_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+cd "${OPENVLA_DIR}"
+WORKSPACE_DIR="$(cd "${OPENVLA_DIR}/../../.." && pwd)"
+OPENVLA_OFT_DIR_CANDIDATE="${WORKSPACE_DIR}/openvla-oft"
+LOCAL_TRANSFORMERS_SRC="${OPENVLA_DIR}/transformers/src"
+
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-7}"
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
+# Enforce offline/local-only loading by default; set to 0 explicitly if network loading is desired.
+export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
+export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
+export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
+# Use repo-local LIBERO config to avoid cross-env path contamination from ~/.libero/config.yaml.
+export LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${OPENVLA_DIR}/.libero}"
+
+CHECKPOINT_COMPAT_DEFAULT="${CHECKPOINT_COMPAT_DEFAULT:-/data5/cgk_lyy_0/models/openvla-7b-finetuned-libero-spatial}"
+CHECKPOINT="${CHECKPOINT:-${CHECKPOINT_COMPAT_DEFAULT}}"
+CHECKPOINT_FALLBACK="${CHECKPOINT_FALLBACK:-${CHECKPOINT_COMPAT_DEFAULT}}"
+TASK_SUITE_NAME="${TASK_SUITE_NAME:-libero_spatial}"
+# Reduce default rollout count for faster iteration.
+# Override via: NUM_TRIALS_PER_TASK=50 bash run_oft_libero_spatial.sh
+NUM_TRIALS_PER_TASK="${NUM_TRIALS_PER_TASK:-20}"
+SEED="${SEED:-7}"
+if [[ -d "${OPENVLA_OFT_DIR_CANDIDATE}" ]]; then
+    OPENVLA_OFT_DIR="${OPENVLA_OFT_DIR:-${OPENVLA_OFT_DIR_CANDIDATE}}"
+else
+    OPENVLA_OFT_DIR="${OPENVLA_OFT_DIR:-${OPENVLA_DIR}}"
+fi
+LOCAL_LOG_DIR="${LOCAL_LOG_DIR:-${OPENVLA_OFT_DIR}/experiments/logs}"
+SUMMARY_DIR="${SUMMARY_DIR:-${LOCAL_LOG_DIR}/inference_summaries}"
+export ROLLOUT_ROOT="${ROLLOUT_ROOT:-${OPENVLA_OFT_DIR}/rollouts_dev}"
+OFT_STRICT_COMPAT="${OFT_STRICT_COMPAT:-1}"
+AUTO_SWITCH_TO_COMPAT="${AUTO_SWITCH_TO_COMPAT:-1}"
+FORCE_INCOMPATIBLE_OFT="${FORCE_INCOMPATIBLE_OFT:-0}"
+LOAD_IN_8BIT="${LOAD_IN_8BIT:-False}"
+LOAD_IN_4BIT="${LOAD_IN_4BIT:-False}"
+MIN_FREE_GB="${MIN_FREE_GB:-20}"
+export MIN_FREE_GB
+USE_LOCAL_FASTV_TRANSFORMERS="${USE_LOCAL_FASTV_TRANSFORMERS:-1}"
+FASTV_STRICT="${FASTV_STRICT:-1}"
+
+# all | baseline | fastv | pruner
+MODE="${MODE:-all}"
+
+# space-separated list, e.g. "0.875 0.75 0.5"
+FASTV_RS="${FASTV_RS:-0.875 0.75 0.5}"
+
+# fastv | prefill
+PRUNER_SELECTOR="${PRUNER_SELECTOR:-fastv}"
+
+read -r -a FASTV_R_LIST <<< "${FASTV_RS}"
+declare -a TIMING_LINES=()
+declare -a SUMMARY_RECORDS=()
+SCRIPT_START_TS="$(date +%s)"
+
+if [[ ! -d "${CHECKPOINT}" ]]; then
+    echo "[ERROR] CHECKPOINT does not exist: ${CHECKPOINT}"
+    exit 1
+fi
+
+if [[ "${PRUNER_SELECTOR}" != "fastv" && "${PRUNER_SELECTOR}" != "prefill" ]]; then
+    echo "[ERROR] PRUNER_SELECTOR must be one of: fastv, prefill"
+    exit 1
+fi
+
+if [[ "${USE_LOCAL_FASTV_TRANSFORMERS}" == "1" ]]; then
+    if [[ ! -d "${LOCAL_TRANSFORMERS_SRC}" ]]; then
+        echo "[ERROR] Local transformers source not found: ${LOCAL_TRANSFORMERS_SRC}"
+        exit 1
+    fi
+    export PYTHONPATH="${LOCAL_TRANSFORMERS_SRC}:${PYTHONPATH:-}"
+fi
+
+if [[ "${LOAD_IN_8BIT}" == "True" && "${LOAD_IN_4BIT}" == "True" ]]; then
+    echo "[ERROR] LOAD_IN_8BIT and LOAD_IN_4BIT cannot both be True."
+    exit 1
+fi
+
+check_oft_checkpoint_compat() {
+    local has_action_head=0
+    local has_proprio_projector=0
+    local has_noisy_action_projector=0
+
+    if find "${CHECKPOINT}" -maxdepth 1 -type f -name "action_head*checkpoint*" | grep -q .; then
+        has_action_head=1
+    fi
+    if find "${CHECKPOINT}" -maxdepth 1 -type f -name "proprio_projector*checkpoint*" | grep -q .; then
+        has_proprio_projector=1
+    fi
+    if find "${CHECKPOINT}" -maxdepth 1 -type f -name "noisy_action_projector*checkpoint*" | grep -q .; then
+        has_noisy_action_projector=1
+    fi
+
+    if [[ "${has_action_head}" == "1" || "${has_proprio_projector}" == "1" || "${has_noisy_action_projector}" == "1" ]]; then
+        echo "[WARN] Detected OFT sidecar checkpoints under ${CHECKPOINT}:"
+        echo "       action_head=${has_action_head}, proprio_projector=${has_proprio_projector}, noisy_action_projector=${has_noisy_action_projector}"
+        echo "[WARN] Current VLA-Pruner eval entry (experiments/robot/libero/run_libero_eval.py)"
+        echo "       does not load OFT sidecar modules, which often leads to near-zero success."
+        if [[ "${AUTO_SWITCH_TO_COMPAT}" == "1" && "${CHECKPOINT}" != "${CHECKPOINT_FALLBACK}" && -d "${CHECKPOINT_FALLBACK}" ]]; then
+            echo "[INFO] Auto-switching to VLA-Pruner compatible checkpoint:"
+            echo "       ${CHECKPOINT_FALLBACK}"
+            CHECKPOINT="${CHECKPOINT_FALLBACK}"
+        elif [[ "${FORCE_INCOMPATIBLE_OFT}" == "1" ]]; then
+            echo "[WARN] Continuing with likely-incompatible OFT checkpoint."
+            echo "[WARN] This may produce all-fail episodes (220 steps each)."
+        else
+            echo "[ERROR] Refusing to run with likely-incompatible OFT checkpoint."
+            echo "[HINT] Use a non-OFT checkpoint for this entry, e.g.:"
+            echo "       CHECKPOINT=${CHECKPOINT_COMPAT_DEFAULT}"
+            echo "[HINT] Or enable auto switch/fallback:"
+            echo "       AUTO_SWITCH_TO_COMPAT=1 CHECKPOINT_FALLBACK=${CHECKPOINT_COMPAT_DEFAULT}"
+            echo "[HINT] If you still want to force this run:"
+            echo "       FORCE_INCOMPATIBLE_OFT=1"
+            exit 1
+        fi
+    fi
+}
+
+format_duration() {
+    local total_sec="$1"
+    printf "%02d:%02d:%02d" $((total_sec / 3600)) $(((total_sec % 3600) / 60)) $((total_sec % 60))
+}
+
+sanitize_id() {
+    local raw="$1"
+    raw="${raw// /_}"
+    raw="${raw//\//_}"
+    raw="${raw//:/_}"
+    raw="${raw//\%/pct}"
+    raw="${raw//\./_}"
+    echo "${raw}"
+}
+
+append_timing() {
+    local run_label="$1"
+    local elapsed_sec="$2"
+    TIMING_LINES+=("${run_label}|${elapsed_sec}")
+}
+
+append_summary_record() {
+    local run_label="$1"
+    local summary_json="$2"
+    SUMMARY_RECORDS+=("${run_label}|${summary_json}")
+}
+
+print_inference_summary() {
+    if [[ "${#SUMMARY_RECORDS[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Inference Comparison ================"
+    printf "%-42s %-12s %-10s %-12s\n" "run" "inferences" "episodes" "avg_inf/ep"
+
+    for record in "${SUMMARY_RECORDS[@]}"; do
+        local run_label summary_json
+        IFS='|' read -r run_label summary_json <<< "${record}"
+        if [[ ! -f "${summary_json}" ]]; then
+            printf "%-42s %-12s %-10s %-12s\n" "${run_label}" "NA" "NA" "NA"
+            continue
+        fi
+        python - <<PY
+import json
+run_label = ${run_label@Q}
+summary_json = ${summary_json@Q}
+with open(summary_json, "r", encoding="utf-8") as f:
+    d = json.load(f)
+print(f"{run_label:<42} {d['total_inferences']:<12} {d['total_episodes']:<10} {d['avg_inferences_per_episode']:<12.2f}")
+PY
+    done
+    echo "======================================================"
+
+    for record in "${SUMMARY_RECORDS[@]}"; do
+        local run_label summary_json
+        IFS='|' read -r run_label summary_json <<< "${record}"
+        if [[ ! -f "${summary_json}" ]]; then
+            continue
+        fi
+        echo
+        echo "---- Task Avg Inferences: ${run_label} ----"
+        python - <<PY
+import json
+summary_json = ${summary_json@Q}
+with open(summary_json, "r", encoding="utf-8") as f:
+    d = json.load(f)
+for row in d["tasks"]:
+    print(f"task_{row['task_id']:02d}  avg_inf/ep={row['avg_inferences_per_episode']:.2f}  inferences={row['inferences']}  episodes={row['episodes']}  {row['task_description']}")
+PY
+    done
+}
+
+print_timing_summary() {
+    if [[ "${#TIMING_LINES[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Runtime Summary ================"
