+import os
+import sys
+
+def parse_semver(version: str):
+    parts = []
+    for chunk in version.split("."):
+        num = ""
+        for ch in chunk:
+            if ch.isdigit():
+                num += ch
+            else:
+                break
+        parts.append(int(num or "0"))
+    while len(parts) < 3:
+        parts.append(0)
+    return tuple(parts[:3])
+
+require_fastv = os.getenv("REQUIRE_FASTV", "0") == "1"
+fastv_strict = os.getenv("FASTV_STRICT", "1") == "1"
+use_local = os.getenv("USE_LOCAL_FASTV_TRANSFORMERS", "1") == "1"
+
+import tokenizers
+tokenizers_ver = tokenizers.__version__
