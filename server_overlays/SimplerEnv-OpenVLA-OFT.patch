+    )
+    weight_scales = weight_scales.max(dim=0)[0].clamp(min=1e-5)
+    scales = (
+        (act_scales.pow(alpha) / weight_scales.pow(1 - alpha))
+        .clamp(min=1e-5)
+        .to(device)
+        .to(dtype)
+    )
+
+    ln.weight.div_(scales)
+    if getattr(ln, "bias", None) is not None:
