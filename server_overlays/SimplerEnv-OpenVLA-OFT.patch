+from __future__ import annotations
+
+import copy
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Optional
+
+
+def _repo_root() -> Path:
+    return Path(__file__).resolve().parents[3]
+
+
+def _vendor_oft_root() -> Path:
+    return _repo_root() / "vendor" / "openvla-oft"
+
+
+def ensure_oft_on_path() -> Path:
+    root = _vendor_oft_root()
+    root_str = str(root)
+    if root_str not in sys.path:
+        sys.path.insert(0, root_str)
+    return root
+
+
+def lazy_import_oft_runtime() -> SimpleNamespace:
+    ensure_oft_on_path()
+
+    from prismatic.vla.constants import NUM_ACTIONS_CHUNK, PROPRIO_DIM
+    from experiments.robot.libero.run_libero_eval import GenerateConfig, check_unnorm_key
+    from experiments.robot.openvla_utils import (
+        get_action_head,
+        get_noisy_action_projector,
+        get_processor,
+        get_proprio_projector,
+        get_vla,
+    )
+    from qvla.calibration.get_libero import get_libero_calib_dataset
+    from qvla.quantization.quant_wrapper import qwrapper
+
+    return SimpleNamespace(
+        NUM_ACTIONS_CHUNK=NUM_ACTIONS_CHUNK,
+        PROPRIO_DIM=PROPRIO_DIM,
+        GenerateConfig=GenerateConfig,
+        check_unnorm_key=check_unnorm_key,
+        get_vla=get_vla,
+        get_processor=get_processor,
+        get_action_head=get_action_head,
+        get_proprio_projector=get_proprio_projector,
+        get_noisy_action_projector=get_noisy_action_projector,
+        get_libero_calib_dataset=get_libero_calib_dataset,
+        qwrapper=qwrapper,
+    )
+
+
+@dataclass
+class LoadedOFTRuntime:
+    oft: Any
+    cfg: Any
+    vla: Any
+    processor: Any
+    action_head: Optional[Any]
+    proprio_projector: Optional[Any]
+    noisy_action_projector: Optional[Any]
+
+
+def bootstrap_model_load_args_from_tasks(args: Any, tasks: list[dict]) -> Any:
+    out = copy.deepcopy(args)
+    if not tasks:
+        return out
+
+    first = tasks[0]
+    if not getattr(out, "unnorm_key", None):
+        out.unnorm_key = first.get("unnorm_key", out.unnorm_key)
+    if first.get("task_suite_name"):
+        out.task_suite_name = first["task_suite_name"]
+
+    base_num_images = int(getattr(out, "num_images", 1))
+    out.num_images = max(int(task.get("num_images", base_num_images)) for task in tasks)
+    base_use_proprio = bool(getattr(out, "use_proprio", False))
+    out.use_proprio = any(bool(task.get("use_proprio", base_use_proprio)) for task in tasks)
+    return out
+
+
+def build_generate_config(args: Any, oft: Any) -> Any:
+    return oft.GenerateConfig(
+        pretrained_checkpoint=args.model,
+        use_l1_regression=bool(getattr(args, "use_l1_regression", False)),
+        use_diffusion=bool(getattr(args, "use_diffusion", False)),
+        use_film=bool(getattr(args, "use_film", False)),
+        num_images_in_input=int(getattr(args, "num_images", 1)),
+        use_proprio=bool(getattr(args, "use_proprio", False)),
+        center_crop=True,
+        num_open_loop_steps=oft.NUM_ACTIONS_CHUNK,
+        unnorm_key=getattr(args, "unnorm_key", None) or "",
+        load_in_8bit=bool(getattr(args, "load_in_8bit", False)),
+        load_in_4bit=bool(getattr(args, "load_in_4bit", False)),
+        task_suite_name=getattr(args, "task_suite_name", "libero_spatial"),
+        num_trials_per_task=int(getattr(args, "num_trials_per_task", 50)),
+        seed=int(getattr(args, "seed", 7)),
+    )
+
+
+def load_oft_runtime(args: Any, tasks: Optional[list[dict]] = None) -> LoadedOFTRuntime:
+    oft = lazy_import_oft_runtime()
+    load_args = bootstrap_model_load_args_from_tasks(args, tasks or [])
+    cfg = build_generate_config(load_args, oft)
+
+    vla = oft.get_vla(cfg)
+    oft.check_unnorm_key(cfg, vla)
+    processor = oft.get_processor(cfg)
+
+    action_head = None
+    if cfg.use_l1_regression or cfg.use_diffusion:
+        action_head = oft.get_action_head(cfg, llm_dim=vla.llm_dim)
+
+    proprio_projector = None
+    if cfg.use_proprio:
+        proprio_projector = oft.get_proprio_projector(cfg, llm_dim=vla.llm_dim, proprio_dim=oft.PROPRIO_DIM)
+
+    noisy_action_projector = None
+    if cfg.use_diffusion:
+        noisy_action_projector = oft.get_noisy_action_projector(cfg, llm_dim=vla.llm_dim)
+
+    return LoadedOFTRuntime(
+        oft=oft,
+        cfg=cfg,
+        vla=vla,
+        processor=processor,
+        action_head=action_head,
+        proprio_projector=proprio_projector,
+        noisy_action_projector=noisy_action_projector,
+    )
