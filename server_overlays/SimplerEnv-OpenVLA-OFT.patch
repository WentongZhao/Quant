+    # 6b) Backgrounds
+    local -a bg=("modern_bedroom_no_roof" "modern_office_no_roof")
+    local -a bg_l=(bedroom office)
+    for j in "${!bg[@]}"; do
+        for env_name in "${DRAWER_ALL_ENVS[@]}"; do
+            _init_drawer_variant
