+def _print_calib_selection(args: argparse.Namespace, debug: dict) -> None:
+    instrs = list(debug.get("instruction", []))
+    traj_ids = list(debug.get("traj_index", []))
+    timesteps = list(debug.get("timestep", []))
+    ds_names = list(debug.get("dataset_name", []))
+
+    if not instrs:
+        print("\n[calibration selection] No debug metadata returned.", flush=True)
+        return
+
+    h = hashlib.sha256()
+    for traj, t, instr in zip(traj_ids, timesteps, instrs):
+        h.update(f"{traj}\t{t}\t{instr}\n".encode("utf-8"))
+    fingerprint = h.hexdigest()[:16]
+
+    print("\n[calibration selection settings]", flush=True)
+    print(
+        f"n_samples={int(args.n_samples)}  seed={int(args.seed)}  shuffle={not bool(args.deterministic)}  "
+        f"calib_sampling={args.calib_sampling}  calib_prompt_balance={bool(args.calib_prompt_balance)}",
+        flush=True,
+    )
+    print(f"selection_fingerprint_sha256[:16]={fingerprint}", flush=True)
+
+    counts: dict[str, int] = {}
+    for s in instrs:
+        s = str(s)
+        counts[s] = counts.get(s, 0) + 1
+    top = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+    print("\n[selected prompts]", flush=True)
+    for s, c in top[: min(20, len(top))]:
+        print(f"{c:4d}  {s}", flush=True)
+    if len(top) > 20:
+        print(f"... ({len(top) - 20} more prompts)", flush=True)
+
+    n = min(int(args.calib_print_samples), len(instrs)) if int(args.calib_print_samples) > 0 else len(instrs)
+    print("\n[selected samples] (traj_index, timestep -> instruction)", flush=True)
+    for i in range(n):
+        ds = ds_names[i] if i < len(ds_names) else ""
+        print(f"{i:4d}  traj={traj_ids[i]}  t={timesteps[i]}  ds={ds}  prompt={instrs[i]}", flush=True)
+
+
+def _run_simplerenv_eval(
+    args: argparse.Namespace,
+    cfg: Any,
+    vla,
+    processor,
+    action_head,
+    proprio_projector,
+    result_label: str,
+    ckpt_fallback: str,
+    policy_model_fallback: str,
+    shared_model=None,
+) -> None:
+    import torch.distributed as dist
+
+    # For distributed training, only rank0 runs final eval.
+    if dist.is_available() and dist.is_initialized() and dist.get_rank() != 0:
+        return
+
+    # Keep OpenVLA-on-SimplerEnv wired through main_quant.py instead of
+    # simpler_env/main_inference.py. The latter expects each policy class to
+    # self-load from ckpt_path + policy_model, while the OpenVLA SimplerEnv path
+    # needs the already-materialized in-memory objects produced here
+    # (vla / processor / cfg / action_head / proprio_projector), potentially
+    # after quantization. Wrapping those objects at this point avoids reloading
+    # the model and preserves the quantized instance used for evaluation.
+
+    if args.env_name is None:
+        raise ValueError("--env_name must be specified for SimplerEnv evaluation")
+
+    robot_name_lower = str(args.robot).lower()
+    if args.policy_setup == "google_robot":
+        if "google_robot" not in robot_name_lower:
+            raise ValueError(
+                f"--policy_setup=google_robot requires a Google robot variant for --robot, "
+                f"but got --robot={args.robot!r}"
+            )
+    elif args.policy_setup == "widowx_bridge":
+        if "widowx" not in robot_name_lower:
+            raise ValueError(
+                f"--policy_setup=widowx_bridge requires a WidowX robot variant for --robot, "
+                f"but got --robot={args.robot!r}"
+            )
+
+    flat_quats = args.robot_init_quats
+    if len(flat_quats) % 4 != 0:
+        raise ValueError(f"robot_init_quats must have length divisible by 4, got {len(flat_quats)}")
+
+    robot_init_quats = []
+    for i in range(0, len(flat_quats), 4):
+        quat = np.array([flat_quats[i], flat_quats[i + 1], flat_quats[i + 2], flat_quats[i + 3]])
+        robot_init_quats.append(quat)
+
+    additional_env_build_kwargs = {}
+    if args.additional_env_build_kwargs:
+        reserved_keys = RESERVED_ENV_BUILD_KWARGS
+        for kv in args.additional_env_build_kwargs:
+            if "=" not in kv:
+                raise ValueError(f"Invalid additional_env_build_kwargs entry '{kv}', expected key=value")
+            k, v = kv.split("=", 1)
+            if k in reserved_keys:
+                raise ValueError(f"additional_env_build_kwargs cannot override reserved key '{k}'")
+            try:
+                v_eval = ast.literal_eval(v)
+            except Exception:
+                v_eval = v
+            additional_env_build_kwargs[k] = v_eval
+
+    if "renderer_kwargs" not in additional_env_build_kwargs and not os.environ.get("DISPLAY"):
+        additional_env_build_kwargs["renderer_kwargs"] = {"offscreen_only": True}
+
+    args.additional_env_build_kwargs = additional_env_build_kwargs
+
+    if args.obj_variation_mode == "xy":
+        if not args.obj_init_xs or not args.obj_init_ys:
+            raise ValueError("obj_init_xs and obj_init_ys must be specified for obj_variation_mode=xy")
+        # NOTE: xy mode uses Cartesian-product semantics in maniskill2_evaluator:
+        # every x in obj_init_xs is paired with every y in obj_init_ys.
+        args.obj_init_xs = np.array(args.obj_init_xs)
+        args.obj_init_ys = np.array(args.obj_init_ys)
+    elif args.obj_variation_mode == "episode":
+        if len(args.obj_episode_range) != 2 or not (0 <= args.obj_episode_range[0] < args.obj_episode_range[1]):
+            raise ValueError("obj_episode_range must be [start, end] with 0 <= start < end")
+
+    if shared_model is None:
+        model = OpenVLAOFTInference(
+            vla=vla,
+            processor=processor,
+            cfg=cfg,
+            action_head=action_head,
+            proprio_projector=proprio_projector,
+            noisy_action_projector=getattr(args, "_noisy_action_projector", None),
+            policy_setup=args.policy_setup,
+            action_scale=args.action_scale,
+        )
+    else:
+        model = shared_model
+        model.set_task_runtime(
+            policy_setup=args.policy_setup,
+            action_scale=args.action_scale,
+            unnorm_key=args.unnorm_key,
+            num_images=args.num_images,
+            use_proprio=args.use_proprio,
+        )
+
+    # Override args attributes for maniskill2_evaluator compatibility.
+    args.robot_init_xs = np.array(args.robot_init_xs)
+    args.robot_init_ys = np.array(args.robot_init_ys)
+    args.robot_init_quats = robot_init_quats
+    args.ckpt_path = getattr(args, "model", None) or ckpt_fallback
+    args.policy_model = getattr(args, "policy_model", None) or policy_model_fallback
+    # Respect explicit CLI override when provided; otherwise let the evaluator
+    # fall back to SimplerEnv's default control-mode inference.
+    args.control_mode = str(args.control_mode).strip() or None if args.control_mode is not None else None
+
+    os.makedirs(args.logging_dir, exist_ok=True)
+
+    print(f"\n[{result_label}]")
+    eval_results = maniskill2_evaluator(model, args)
+    if isinstance(eval_results, dict) and "entire" in eval_results and "partial" in eval_results:
+        entire_arr = np.asarray(eval_results["entire"], dtype=np.float32)
+        partial_arr = np.asarray(eval_results["partial"], dtype=np.float32)
+    else:
+        arr = np.asarray(eval_results, dtype=np.float32)
+        entire_arr = arr
+        partial_arr = arr
+    n_episodes = len(entire_arr)
+    avg_entire = float(np.mean(entire_arr)) if n_episodes > 0 else 0.0
+    avg_partial = float(np.mean(partial_arr)) if n_episodes > 0 else 0.0
+    print(f"[{result_label}] Entire  success: {avg_entire:.4f} ({avg_entire*100:.1f}%) — {int(np.sum(entire_arr))}/{n_episodes}")
+    print(f"[{result_label}] Partial success: {avg_partial:.4f} ({avg_partial*100:.1f}%) — {int(np.sum(partial_arr))}/{n_episodes}")
+
+
+def cli_quant(args: Union[argparse.Namespace, None] = None) -> None:
+    if not args:
+        args = parse_quant_args()
+
+    args_list = []
+    if args.config:
+        if not os.path.exists(args.config):
+            raise ValueError(f"Config file does not exist: {args.config}")
+
+        with open(args.config, "r") as file:
+            config_args = yaml.safe_load(file)
+        config_args = [config_args] if not isinstance(config_args, list) else config_args
+        for cfg_dict in config_args:
+            args_copy = argparse.Namespace(**vars(args))
+            for key, value in cfg_dict.items():
+                setattr(args_copy, key, value)
+            args_list.append(args_copy)
+    else:
+        args_list.append(args)
+
+    for cfg_args in args_list:
+        cli_quant_single(cfg_args)
+
+
+def _load_simplerenv_task_list(task_json_path: str) -> list[dict]:
+    with open(task_json_path, "r", encoding="utf-8") as f:
+        payload = json.load(f)
+    if not isinstance(payload, list):
+        raise ValueError("--simplerenv_tasks_json must point to a JSON list")
+    tasks: list[dict] = []
+    for i, item in enumerate(payload):
+        if not isinstance(item, dict):
+            raise ValueError(f"Task entry #{i} must be an object/dict")
+        tasks.append(item)
+    if len(tasks) == 0:
+        raise ValueError("--simplerenv_tasks_json contains an empty task list")
+    return tasks
+
+
+def _build_task_args_from_dict(base_args: argparse.Namespace, task_dict: dict, idx: int) -> tuple[argparse.Namespace, str]:
+    args_i = copy.deepcopy(base_args)
+    # Optional human-readable label for logs
+    label = task_dict.get("result_label", f"SimplerEnv FP Evaluation #{idx+1}")
+
+    # Allow overriding any existing argparse field (except control flags)
+    blocked_keys = {"fp_simplerenv_only", "eval_simplerenv", "simplerenv_tasks_json", "config"}
+    for key, value in task_dict.items():
+        if key in blocked_keys or key == "result_label":
+            continue
+        if not hasattr(args_i, key):
+            raise ValueError(f"Unknown task key in --simplerenv_tasks_json: {key}")
+        setattr(args_i, key, value)
+
+    # Convenience: allow additional_env_build_kwargs as dict in JSON
+    if isinstance(getattr(args_i, "additional_env_build_kwargs", None), dict):
+        args_i.additional_env_build_kwargs = [f"{k}={v!r}" for k, v in args_i.additional_env_build_kwargs.items()]
+
+    return args_i, str(label)
+
+
+def cli_quant_single(args: argparse.Namespace) -> None:
+    oft = _lazy_import_oft_runtime()
+
+    # torchrun/DDP: ensure each rank uses its own local GPU (CUDA_VISIBLE_DEVICES remaps to cuda:0..).
+    if torch.cuda.is_available() and "LOCAL_RANK" in os.environ:
+        torch.cuda.set_device(int(os.environ["LOCAL_RANK"]))
+
+    # Reproducibility: calibration sampling (python/tf) + gradient analysis/backward (torch/numpy).
+    _set_reproducibility(args.seed)
+
+    batched_tasks = None
+    if getattr(args, "simplerenv_tasks_json", None):
+        batched_tasks = _load_simplerenv_task_list(args.simplerenv_tasks_json)
+        args = bootstrap_model_load_args_from_tasks(args, batched_tasks)
+
+    cfg = _build_generate_config(args)
+
+    # sanity-check action_scale
+    if args.action_scale <= 0:
+        raise ValueError("--action_scale must be positive")
+
+    # --- Model + processors ---
+    vla = oft.get_vla(cfg)
+    # Resolve unnorm_key if not explicitly provided
+    oft.check_unnorm_key(cfg, vla)
+    args.unnorm_key = cfg.unnorm_key
+    processor = oft.get_processor(cfg)
+    proprio_projector = (
+        oft.get_proprio_projector(cfg, llm_dim=vla.llm_dim, proprio_dim=oft.PROPRIO_DIM) if args.use_proprio else None
+    )
+    action_head = None
+    if cfg.use_l1_regression or cfg.use_diffusion:
+        action_head = oft.get_action_head(cfg, llm_dim=vla.llm_dim)
+    noisy_action_projector = None
+    if cfg.use_diffusion:
+        noisy_action_projector = oft.get_noisy_action_projector(cfg, llm_dim=vla.llm_dim)
+
+    # Ensure deterministic behavior (no dropout) for gradient importance runs.
+    vla.eval()
+    if proprio_projector is not None:
+        proprio_projector.eval()
+    if action_head is not None:
+        action_head.eval()
+
+    if args.fp_simplerenv_only:
+        if not args.eval_simplerenv:
+            raise ValueError("--fp_simplerenv_only requires --eval_simplerenv")
+        if args.eval_libero:
+            raise ValueError("--fp_simplerenv_only cannot be used together with --eval_libero")
+        if not args.simplerenv_tasks_json:
+            raise NotImplementedError(
+                "simplerenv_fp now requires --simplerenv_tasks_json. "
+                "For official benchmark subsets, use --eval_mode simplerenv_official."
+            )
+
+        # Build one shared model so multiple tasks can run without reloading weights.
+        shared_model = OpenVLAOFTInference(
+            vla=vla,
+            processor=processor,
+            cfg=cfg,
+            action_head=action_head,
+            proprio_projector=proprio_projector,
+            noisy_action_projector=noisy_action_projector,
+            policy_setup=args.policy_setup,
+            action_scale=args.action_scale,
+        )
+
+        tasks = batched_tasks if batched_tasks is not None else _load_simplerenv_task_list(args.simplerenv_tasks_json)
+        print(f"[SimplerEnv] Loaded {len(tasks)} tasks from {args.simplerenv_tasks_json}")
+        for i, task_dict in enumerate(tasks):
+            task_args, label = _build_task_args_from_dict(args, task_dict, i)
+            shared_model.set_task_runtime(
+                policy_setup=task_args.policy_setup,
+                action_scale=task_args.action_scale,
+                unnorm_key=getattr(task_args, "unnorm_key", None),
+                num_images=getattr(task_args, "num_images", None),
+                use_proprio=getattr(task_args, "use_proprio", None),
+            )
+            _run_simplerenv_eval(
+                args=task_args,
+                cfg=cfg,
+                vla=vla,
+                processor=processor,
+                action_head=action_head,
+                proprio_projector=proprio_projector,
+                result_label=label,
+                ckpt_fallback="openvla_oft_fp",
+                policy_model_fallback="openvla_oft",
+                shared_model=shared_model,
+            )
+        return
+
+    calib_return_mode = "embeds"
+    if args.method == "smoothquant" and args.sq_target == "vision":
+        calib_return_mode = "raw"
+
+    calib_out = oft.get_libero_calib_dataset(
+        data_path=args.data,
+        model=vla,
+        processor=processor,
+        proprio_projector=proprio_projector,
+        n_samples=args.n_samples,
+        rotate=args.rotate_images,
+        shuffle=not args.deterministic,
+        unnorm_key=args.unnorm_key,
+        seed=args.seed,
+        calib_sampling=args.calib_sampling,
+        calib_prompt_balance=args.calib_prompt_balance,
+        return_mode=calib_return_mode,
+        return_debug=bool(args.calib_print_selection),
+    )
+
+    if bool(args.calib_print_selection):
+        prompt_inputs, prompt_kwargs, debug = calib_out
+        _print_calib_selection(args, debug)
+    else:
+        prompt_inputs, prompt_kwargs = calib_out
+
+    vla = oft.qwrapper(
+        vla,
+        prompt_inputs,
+        prompt_kwargs,
+        args,
+        action_head=action_head,
+        grad_loss_type="l1_regression",
+    )
+
+    if args.eval_simplerenv:
+        shared_model = OpenVLAOFTInference(
+            vla=vla,
+            processor=processor,
+            cfg=cfg,
+            action_head=action_head,
+            proprio_projector=proprio_projector,
+            noisy_action_projector=noisy_action_projector,
+            policy_setup=args.policy_setup,
+            action_scale=args.action_scale,
+        )
+        if batched_tasks:
+            print(f"[SimplerEnv] Loaded {len(batched_tasks)} tasks from {args.simplerenv_tasks_json}")
+            for i, task_dict in enumerate(batched_tasks):
+                task_args, label = _build_task_args_from_dict(args, task_dict, i)
+                shared_model.set_task_runtime(
+                    policy_setup=task_args.policy_setup,
+                    action_scale=task_args.action_scale,
+                    unnorm_key=getattr(task_args, "unnorm_key", None),
+                    num_images=getattr(task_args, "num_images", None),
+                    use_proprio=getattr(task_args, "use_proprio", None),
+                )
+                _run_simplerenv_eval(
+                    args=task_args,
+                    cfg=cfg,
+                    vla=vla,
+                    processor=processor,
+                    action_head=action_head,
+                    proprio_projector=proprio_projector,
+                    result_label=label,
+                    ckpt_fallback="openvla_oft_quant",
+                    policy_model_fallback="openvla_oft",
+                    shared_model=shared_model,
+                )
+        else:
+            _run_simplerenv_eval(
+                args=args,
+                cfg=cfg,
+                vla=vla,
+                processor=processor,
+                action_head=action_head,
+                proprio_projector=proprio_projector,
+                result_label="SimplerEnv Evaluation",
+                ckpt_fallback="openvla_oft_quant",
+                policy_model_fallback="openvla_oft",
+                shared_model=shared_model,
+            )
+
+
+if __name__ == "__main__":
+    parsed_args = parse_quant_args()
+    if not _dispatch_unified_mode(parsed_args):
+        cli_quant(parsed_args)
