+def _resolve_eval_mode(args: argparse.Namespace) -> str | None:
+    if getattr(args, "eval_mode", None):
+        return args.eval_mode
+    if bool(getattr(args, "fp_simplerenv_only", False)) and bool(getattr(args, "eval_simplerenv", False)):
+        return "simplerenv_fp"
+    if bool(getattr(args, "eval_simplerenv", False)):
+        return "simplerenv_quant"
+    if bool(getattr(args, "eval_libero", False)):
+        return "libero_quant"
+    return None
+
+
+def _normalize_unified_args(args: argparse.Namespace, mode: str) -> argparse.Namespace:
+    args_copy = argparse.Namespace(**vars(args))
+    args_copy.eval_mode = mode
+
+    if mode == "simplerenv_fp":
+        args_copy.eval_simplerenv = True
+        args_copy.fp_simplerenv_only = True
+        args_copy.eval_libero = False
+        return args_copy
+
+    if mode == "simplerenv_quant":
+        args_copy.eval_simplerenv = True
+        args_copy.fp_simplerenv_only = False
+        args_copy.eval_libero = False
+        return args_copy
+
+    if mode == "libero_quant":
+        args_copy.eval_simplerenv = False
+        args_copy.fp_simplerenv_only = False
+        args_copy.eval_libero = True
+        return args_copy
+
+    if mode == "libero_fp":
+        raise NotImplementedError("libero_fp is reserved as a unified interface, but native FP LIBERO eval is not wired here.")
+
+    if mode == "simplerenv_official":
+        return args_copy
+
+    raise NotImplementedError(f"Unsupported eval_mode={mode}")
+
+
+def _validate_quant_requirements(args: argparse.Namespace, mode: str) -> None:
+    if mode in {"simplerenv_quant", "libero_quant"}:
+        if not getattr(args, "data", ""):
+            raise ValueError(f"{mode} requires --data for LIBERO calibration.")
+        method = str(getattr(args, "method", "")).strip()
+        if method in {"", "fp"}:
+            raise ValueError(f"{mode} requires a quantization --method such as mbq / awq / smoothquant / rtn.")
+
+
+def _validate_backend_mode_pair(args: argparse.Namespace, mode: str) -> None:
+    backend = str(args.model_backend)
+
+    if backend == "openvla":
+        if mode in {"simplerenv_fp", "simplerenv_official"}:
+            return
+        raise NotImplementedError(
+            f"The pair eval_mode={mode} + model_backend=openvla is not implemented in openvla-oft/main_quant.py yet."
+        )
+
+    if backend == "openvla_oft":
+        if mode in {"simplerenv_fp", "simplerenv_quant", "libero_quant"}:
+            return
+        raise NotImplementedError(
+            f"The pair eval_mode={mode} + model_backend=openvla_oft is not implemented in openvla-oft/main_quant.py yet."
+        )
+
+    raise NotImplementedError(f"Unknown model_backend={backend}")
+
+
+def _run_simplerenv_official_mode(args: argparse.Namespace) -> None:
+    repo_root = os.path.dirname(os.path.abspath(__file__))
+    scripts_dir = os.path.join(repo_root, "scripts")
+    if not os.path.isdir(scripts_dir):
+        raise FileNotFoundError(f"Clean scripts directory not found: {scripts_dir}")
+
+    ckpt_path = str(args.model)
+    policy_model = "openvla"
+    action_ensemble_temp = str(args.action_ensemble_temp)
+    logging_dir = str(args.logging_dir)
+    env = os.environ.copy()
+    python_bin_dir = os.path.dirname(os.path.realpath(__import__("sys").executable))
+    env["PATH"] = python_bin_dir + os.pathsep + env.get("PATH", "")
+    env["CUDA_DEVICE_ORDER"] = "PCI_BUS_ID"
+
+    if args.benchmark_subset != "all":
+        script_name = OFFICIAL_SIMPLERENV_SCRIPT_BY_SUBSET[args.benchmark_subset]
+        script_path = os.path.join(scripts_dir, script_name)
+        if not os.path.exists(script_path):
+            raise FileNotFoundError(f"Official SimplerEnv script not found: {script_path}")
+        cmd = [
+            "bash",
+            script_path,
+            ckpt_path,
+            policy_model,
+            action_ensemble_temp,
+            logging_dir,
+            str(args.gpu_id),
+        ]
+        print(f"[main_quant] forwarding official SimplerEnv benchmark: {' '.join(cmd)}")
+        subprocess.run(cmd, check=True, cwd=repo_root, env=env)
+        return
+
+    os.makedirs(logging_dir, exist_ok=True)
+    for script_name in OFFICIAL_SIMPLERENV_ALL_SCRIPTS:
+        script_path = os.path.join(scripts_dir, script_name)
+        if not os.path.exists(script_path):
+            raise FileNotFoundError(f"Official SimplerEnv script not found: {script_path}")
+        cmd = [
+            "bash",
+            script_path,
+            ckpt_path,
+            policy_model,
+            action_ensemble_temp,
+            logging_dir,
+            str(args.gpu_id),
+        ]
+        print(f"[main_quant] forwarding official SimplerEnv benchmark: {' '.join(cmd)}")
+        subprocess.run(cmd, check=True, cwd=repo_root, env=env)
+
+
+def _delegate_vendor_oft_mode() -> None:
+    vendor_main = os.path.join(os.path.dirname(os.path.abspath(__file__)), "vendor", "openvla-oft", "main_quant.py")
+    cmd = [sys.executable, vendor_main, *sys.argv[1:]]
+    print(f"[main_quant] delegating to vendor openvla-oft: {' '.join(cmd)}")
+    subprocess.run(cmd, check=True, cwd=os.path.dirname(vendor_main), env=os.environ.copy())
+
+
+def _dispatch_unified_mode(args: argparse.Namespace) -> bool:
+    mode = _resolve_eval_mode(args)
+    if mode is None:
+        return False
+
+    print(f"[main_quant] eval_mode={mode} model_backend={args.model_backend}")
+    _validate_backend_mode_pair(args, mode)
+    norm_args = _normalize_unified_args(args, mode)
+
+    if mode == "simplerenv_official":
+        _run_simplerenv_official_mode(norm_args)
+        return True
+
+    if mode == "libero_quant":
+        _delegate_vendor_oft_mode()
+        return True
+
+    _validate_quant_requirements(norm_args, mode)
+    cli_quant(norm_args)
+    return True
+
