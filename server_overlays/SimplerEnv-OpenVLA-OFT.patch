+# ---------- 1. Coke Can Visual Matching (pick_coke_can_visual_matching.sh) ----------
+run_google_coke_visual_matching() {
+    echo "[INFO] === Coke Can Visual Matching (4 URDF × 3 orientations) ==="
+    local -a opts=("lr_switch=True" "laid_vertically=True" "upright=True")
+    local -a labs=(horizontal vertical standing)
+    for uv in "${VISUAL_MATCHING_URDF_VERSIONS[@]}"; do
+        for i in "${!opts[@]}"; do
+            _init_coke_xy
+            ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+            RGB_OVERLAY_PATH="${SIMPLERENV_ROOT}/ManiSkill2_real2sim/data/real_inpainting/google_coke_can_real_eval_1.png"
+            ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}" "urdf_version=${uv}")
+            CURRENT_TASK_LABEL="coke_vm_${labs[$i]}_urdf_${uv}"
+            run_current_task
+        done
+    done
+}
+
+# ---------- 2. Coke Can Variant Aggregation (pick_coke_can_variant_agg.sh) ----------
+run_google_coke_variant_agg() {
+    echo "[INFO] === Coke Can Variant Aggregation ==="
+    local -a opts=("lr_switch=True" "laid_vertically=True" "upright=True")
+    local -a labs=(horizontal vertical standing)
+
+    # 2a) Base
+    for i in "${!opts[@]}"; do
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+        CURRENT_TASK_LABEL="coke_var_base_${labs[$i]}"
+        run_current_task
+    done
+
+    # 2b) Table textures
+    local -a t_scenes=("Baked_sc1_staging_objaverse_cabinet1_h870" "Baked_sc1_staging_objaverse_cabinet2_h870")
+    local -a t_labels=(table1 table2)
+    for j in "${!t_scenes[@]}"; do
+        for i in "${!opts[@]}"; do
+            _init_coke_xy
+            ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+            SCENE_NAME="${t_scenes[$j]}"
+            ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+            CURRENT_TASK_LABEL="coke_var_${t_labels[$j]}_${labs[$i]}"
+            run_current_task
+        done
+    done
+
+    # 2c) Distractors (无 more + 有 more)
+    for i in "${!opts[@]}"; do
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanDistractorInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+        CURRENT_TASK_LABEL="coke_var_distractor_${labs[$i]}"
+        run_current_task
+
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanDistractorInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}" "distractor_config=more")
+        CURRENT_TASK_LABEL="coke_var_distractor_more_${labs[$i]}"
+        run_current_task
+    done
+
+    # 2d) Backgrounds
+    local -a bg=("google_pick_coke_can_1_v4_alt_background" "google_pick_coke_can_1_v4_alt_background_2")
+    local -a bg_l=(bg1 bg2)
+    for j in "${!bg[@]}"; do
+        for i in "${!opts[@]}"; do
+            _init_coke_xy
+            ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+            SCENE_NAME="${bg[$j]}"
+            ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+            CURRENT_TASK_LABEL="coke_var_${bg_l[$j]}_${labs[$i]}"
+            run_current_task
+        done
+    done
+
+    # 2e) Lightings
+    for i in "${!opts[@]}"; do
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}" "slightly_darker_lighting=True")
+        CURRENT_TASK_LABEL="coke_var_darker_${labs[$i]}"
+        run_current_task
+
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}" "slightly_brighter_lighting=True")
+        CURRENT_TASK_LABEL="coke_var_brighter_${labs[$i]}"
+        run_current_task
+    done
+
+    # 2f) Camera orientations
+    local -a c_envs=("GraspSingleOpenedCokeCanAltGoogleCameraInScene-v0" "GraspSingleOpenedCokeCanAltGoogleCamera2InScene-v0")
+    local -a c_l=(altcam1 altcam2)
+    for j in "${!c_envs[@]}"; do
+        for i in "${!opts[@]}"; do
+            _init_coke_xy
+            ENV_NAME="${c_envs[$j]}"
+            ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+            CURRENT_TASK_LABEL="coke_var_${c_l[$j]}_${labs[$i]}"
+            run_current_task
+        done
+    done
+}
