+
+# logs & scales on data disk
+LOG_BASE="${PROJECT_DIR}/smoothquant_logs/libero_10"
+SCALE_BASE="${PROJECT_DIR}/smoothquant_scales/libero_10"
+
+# ====== GPU ======
+export CUDA_VISIBLE_DEVICES=0
+
+# ====== Calib ======
+CALIB_SAMPLING=proprio_stratified
+CALIB_TAG=proprio_stratified
+N_SAMPLES=256
+SEED=7
+
+# ====== SmoothQuant ======
+SQ_ALPHA=0.5
+SQ_SCALE_MODE=max
+
+mkdir -p "$LOG_BASE" "$SCALE_BASE"
+
+cd "$PROJECT_DIR"
+
+run_one() {
+  local w_bit="$1"
+  local a_bit="$2"
+  local cfg_tag="w${w_bit}a${a_bit}kv16"
+  local scale_dir="${SCALE_BASE}/${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}"
+  mkdir -p "$scale_dir"
+
+  # 1) build scales
+  python3 main_quant.py \
+    --model "$MODEL_DIR" \
+    --data "$DATA_DIR" \
+    --method smoothquant \
+    --alpha "$SQ_ALPHA" \
+    --sq_scale_mode "$SQ_SCALE_MODE" \
+    --w_bit "$w_bit" --a_bit "$a_bit" --k_bit 16 --v_bit 16 \
+    --scale_path "${scale_dir}/scale.pt" \
+    --run_process \
+    --deterministic \
+    # --calib_sampling "$CALIB_SAMPLING" \
+    # --use_l1_regression \
+    --calib_prompt_balance \
+    --n_samples "$N_SAMPLES" \
+    --omni_batch_size 1 \
+    --task_suite_name libero_10 \
+    --seed "$SEED" |& tee "${LOG_BASE}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_scale.log"
+
+  # 2) eval
+  python3 main_quant.py \
+    --model "$MODEL_DIR" \
+    --data "$DATA_DIR" \
+    --method smoothquant \
+    --alpha "$SQ_ALPHA" \
+    --sq_scale_mode "$SQ_SCALE_MODE" \
+    --w_bit "$w_bit" --a_bit "$a_bit" --k_bit 16 --v_bit 16 \
+    --scale_path "${scale_dir}/scale.pt" \
+    --pseudo_quant \
+    --deterministic \
+    # --calib_sampling "$CALIB_SAMPLING" \
+    # --use_l1_regression \
+    --calib_prompt_balance \
+    --n_samples "$N_SAMPLES" \
+    --omni_batch_size 1 \
+    --eval_libero \
+    --task_suite_name libero_10 \
+    --num_trials_per_task 50 \
+    --seed "$SEED" |& tee "${LOG_BASE}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_eval.log"
+}
+
+# run w4a4 and w8a8
+run_one 4 4
+run_one 8 8
