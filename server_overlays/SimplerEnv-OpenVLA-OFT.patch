+# ---------- 5. Drawer Visual Matching (drawer_visual_matching.sh) ----------
+run_google_drawer_visual_matching() {
+    echo "[INFO] === Drawer Visual Matching (4 URDF × 6 envs × 9 positions) ==="
+    for uv in "${VISUAL_MATCHING_URDF_VERSIONS[@]}"; do
+        for env_name in "${DRAWER_ALL_ENVS[@]}"; do
+            for pos in "${DRAWER_VM_POSITIONS[@]}"; do
+                IFS=',' read -r plabel rx ry osuffix qx qy qz qw <<< "${pos}"
+                init_google_robot_base
+                ENV_NAME="${env_name}"
+                SCENE_NAME="dummy_drawer"
+                MAX_EPISODE_STEPS=113
+                ENABLE_RAYTRACING=1
+                ROBOT_INIT_XS=("${rx}")
+                ROBOT_INIT_YS=("${ry}")
+                ROBOT_INIT_QUATS=("${qx}" "${qy}" "${qz}" "${qw}")
+                OBJ_VARIATION_MODE="xy"
+                OBJ_INIT_XS=(0.0)
+                OBJ_INIT_YS=(0.0)
+                RGB_OVERLAY_PATH="${SIMPLERENV_ROOT}/ManiSkill2_real2sim/data/real_inpainting/open_drawer_${osuffix}.png"
+                ADDITIONAL_ENV_BUILD_KWARGS=("station_name=mk_station_recolor" "light_mode=simple" "disable_bad_material=True" "urdf_version=${uv}")
+                CURRENT_TASK_LABEL="drawer_vm_${env_name%%Custom*}_${plabel}_${uv}"
+                run_current_task
+            done
+        done
+    done
+}
