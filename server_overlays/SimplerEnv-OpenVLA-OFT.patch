+        # Note: Only batch size == 1 supported right now
+        mask_extension = (
+            torch.ones((attention_mask.shape[0], input_ids.shape[-1] - attention_mask.shape[-1]))
+            .to(attention_mask.device)
+            .to(attention_mask.dtype)
+        )
