new file mode 100755
index 0000000..6232060
--- /dev/null
+++ b/run_full_eval_pipeline.sh
@@ -0,0 +1,138 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$SCRIPT_DIR"
+PY="/data5/cgk_lyy_0/miniconda3/envs/sim-openvla/bin/python"
+PY_BIN_DIR="$(dirname "$PY")"
+MODEL="/data5/cgk_lyy_0/models/openvla-7b"
+UUID_DEFAULT="GPU-cda45e74-0adb-38a1-001d-21ab5c262e6b"
+CUDA_UUID="${CUDA_UUID:-$UUID_DEFAULT}"
+
+# Ensure helper executables from the same conda env, such as ffmpeg, are discoverable.
+export PATH="$PY_BIN_DIR:$PATH"
+
+TS="$(date +%Y%m%d_%H%M%S)"
+RUN_DIR="$ROOT/eval_logs/pipeline_$TS"
+mkdir -p "$RUN_DIR"
+
+DIFF_BEFORE="$RUN_DIR/diff_before.patch"
+DIFF_AFTER="$RUN_DIR/diff_after.patch"
+
+cd "$ROOT"
+git status --short > "$RUN_DIR/git_status_before.txt" || true
+git diff > "$DIFF_BEFORE" || true
+
+log_note() {
+  printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$RUN_DIR/pipeline.log"
+}
+
+wait_for_gpu_free() {
+  local uuid="$1"
+  local max_used_mb="${2:-1024}"
+  log_note "wait_for_gpu_free uuid=$uuid threshold=${max_used_mb}MiB"
+  while true; do
+    local used
+    used=$(nvidia-smi --query-gpu=uuid,memory.used --format=csv,noheader,nounits | awk -F', ' -v u="$uuid" '$1==u{print $2}')
+    if [[ -z "${used:-}" ]]; then
+      log_note "WARN gpu uuid not found in nvidia-smi: $uuid"
+      break
+    fi
+    if (( used <= max_used_mb )); then
+      log_note "gpu ready uuid=$uuid used=${used}MiB"
+      break
+    fi
+    log_note "gpu busy uuid=$uuid used=${used}MiB; sleep 60s"
+    sleep 60
+  done
+}
+
+run_stage() {
+  local stage="$1"
+  local json_file="$2"
+  local out_log="$3"
+
+  log_note "START stage=$stage json=$json_file"
+
+  wait_for_gpu_free "$CUDA_UUID" 1024
+
+  # Preflight: print the actual visible CUDA device in this stage.
+  CUDA_VISIBLE_DEVICES="$CUDA_UUID" CUDA_DEVICE_ORDER=PCI_BUS_ID "$PY" - <<'PYCHK' >> "$RUN_DIR/pipeline.log" 2>&1
+import torch, os
+print(f"[preflight] CUDA_VISIBLE_DEVICES={os.environ.get('CUDA_VISIBLE_DEVICES')}")
+print(f"[preflight] cuda_available={torch.cuda.is_available()} count={torch.cuda.device_count()}")
+if torch.cuda.is_available() and torch.cuda.device_count() > 0:
+    print(f"[preflight] device0={torch.cuda.get_device_name(0)}")
+PYCHK
+
+  CUDA_VISIBLE_DEVICES="$CUDA_UUID"   CUDA_DEVICE_ORDER=PCI_BUS_ID   PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True   "$PY" "$ROOT/main_quant.py" --eval_mode simplerenv_fp --model "$MODEL" --simplerenv_tasks_json "$json_file" > "$out_log" 2>&1 &
+  local pid=$!
+
+  log_note "PID stage=$stage pid=$pid"
+
+  local heartbeat_sec=1800
+  local poll_sec=5
+  local elapsed=0
+
+  while true; do
+    if ! kill -0 "$pid" 2>/dev/null; then
+      break
+    fi
+
+    sleep "$poll_sec"
+    elapsed=$((elapsed + poll_sec))
+
+    if (( elapsed % heartbeat_sec == 0 )); then
+      {
+        echo "===== [$(date '+%F %T')] heartbeat stage=$stage ====="
+        tail -n 40 "$out_log" || true
+        echo
+      } >> "$RUN_DIR/monitor.log"
+      log_note "heartbeat stage=$stage (last 40 lines appended to monitor.log)"
+    fi
+  done
+
+  set +e
+  wait "$pid"
+  local rc=$?
+  set -e
+
+  log_note "END stage=$stage rc=$rc"
+  return "$rc"
+}
+
+all_zero() {
+  local out_log="$1"
+  awk '/Entire  success:/{c++; if ($4+0 > 0) nz=1} END{exit !(c>0 && nz==0)}' "$out_log"
+}
+
+GOOGLE_JSON="$ROOT/eval_logs/google_full_tasks.json"
+WIDOW_JSON="$ROOT/eval_logs/widow_full_tasks.json"
+DEBUG_GOOGLE_JSON="$ROOT/eval_logs/debug_google_3eps.json"
+DEBUG_WIDOW_JSON="$ROOT/eval_logs/debug_widow_3eps.json"
+
+GOOGLE_LOG="$RUN_DIR/google_full.log"
+WIDOW_LOG="$RUN_DIR/widow_full.log"
+DBG_GOOGLE_LOG="$RUN_DIR/debug_google.log"
+DBG_WIDOW_LOG="$RUN_DIR/debug_widow.log"
+
+run_stage "google_full" "$GOOGLE_JSON" "$GOOGLE_LOG"
+if all_zero "$GOOGLE_LOG"; then
+  log_note "google_full detected ALL ZERO; running debug closed-loop"
+  run_stage "debug_google" "$DEBUG_GOOGLE_JSON" "$DBG_GOOGLE_LOG" || true
+else
+  log_note "google_full not all-zero"
+fi
+
+run_stage "widow_full" "$WIDOW_JSON" "$WIDOW_LOG"
+if all_zero "$WIDOW_LOG"; then
+  log_note "widow_full detected ALL ZERO; running debug closed-loop"
+  run_stage "debug_widow" "$DEBUG_WIDOW_JSON" "$DBG_WIDOW_LOG" || true
+else
+  log_note "widow_full not all-zero"
+fi
+
+git status --short > "$RUN_DIR/git_status_after.txt" || true
+git diff > "$DIFF_AFTER" || true
+
+log_note "PIPELINE DONE run_dir=$RUN_DIR"
