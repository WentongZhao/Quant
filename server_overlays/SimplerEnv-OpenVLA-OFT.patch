+#!/usr/bin/env bash
+set -euo pipefail
+
+# 推荐入口说明：
+# - OpenVLA 的 SimplerEnv 评测通过 main_quant.py 完成，而不是 simpler_env/main_inference.py。
+# - 原因是这里要直接复用 main_quant.py 中已经加载/量化完成的内存模型对象，
+#   避免重新从 checkpoint 构造策略时丢失量化状态。
+# - 本脚本只是对 main_quant.py 的常用参数做一层封装。
+
+# 当前脚本所在目录（避免仓库移动后路径错乱）
+ICML_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SIMPLERENV_ROOT="$(cd "${ICML_DIR}/.." && pwd)"
+REPO_ROOT="$(cd "${SIMPLERENV_ROOT}/.." && pwd)"
+cd "${ICML_DIR}"
+
+export DISPLAY=""
+export TOKENIZERS_PARALLELISM=false
+export OMP_NUM_THREADS=8
+export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
+export PYTHONPATH="${ICML_DIR}:${ICML_DIR}/LIBERO:${ICML_DIR}/LIBERO/libero:${SIMPLERENV_ROOT}:${SIMPLERENV_ROOT}/ManiSkill2_real2sim:${PYTHONPATH:-}"
+export MS2_RENDERER_LOG_LEVEL=error
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-7}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+
+CALIB_SAMPLING=proprio_stratified
+CALIB_TAG=proprio_stratified
+N_SAMPLES=256
+SEED=7
+
+# SmoothQuant knobs
+SQ_ALPHA=0.5
+SQ_SCALE_MODE=max
+
+LOG_BASE="${ICML_DIR}/smoothquant_logs"
+SCALE_BASE="${ICML_DIR}/smoothquant_scales"
+
+# 评测后端：
+#   libero     -> 跑 LIBERO 评测
+#   simplerenv -> 跑 SimplerEnv 评测
+EVAL_BACKEND="simplerenv"
+
+# 运行模式：
+#   fp    -> 只跑原模型基线评测
+#   quant -> 只跑量化流程
+#   all   -> 先跑原模型，再跑量化
+MODE="fp"
+
+# SimplerEnv evaluation config
+GOOGLE_ONLY=0
+POLICY_SETUP="widowx_bridge"
+ROBOT="widowx"
+ENV_NAME="PutCarrotOnPlateInScene-v0"
+SCENE_NAME="bridge_table_1_v1"
+LOGGING_DIR="${ICML_DIR}/simplerenv_results"
+RGB_OVERLAY_PATH="${SIMPLERENV_ROOT}/ManiSkill2_real2sim/data/real_inpainting/bridge_real_eval_1.png"
+OBS_CAMERA_NAME=""
+ACTION_SCALE="${ACTION_SCALE:-1.0}"
+ENABLE_RAYTRACING=0
+ADDITIONAL_ENV_SAVE_TAGS=""
+ADDITIONAL_ENV_BUILD_KWARGS=()
+CONTROL_FREQ=5
+SIM_FREQ=500
+MAX_EPISODE_STEPS=60
+ROBOT_INIT_XS=(0.147)
+ROBOT_INIT_YS=(0.028)
+ROBOT_INIT_QUATS=(0.0 0.0 0.0 1.0)
+OBJ_VARIATION_MODE="episode"
+OBJ_INIT_XS=()
+OBJ_INIT_YS=()
+OBJ_EPISODE_START=0
+OBJ_EPISODE_END=24
+
+# Action un-normalization key:
+# - If user explicitly exports UNNORM_KEY, treat it as a global override for all tasks.
+# - Otherwise auto-select by policy setup (widowx_bridge/google_robot).
+if [[ -n "${UNNORM_KEY+x}" ]]; then
+    UNNORM_KEY_GLOBAL_OVERRIDE="${UNNORM_KEY}"
+else
+    UNNORM_KEY_GLOBAL_OVERRIDE=""
+fi
+UNNORM_KEY_WIDOWX_DEFAULT="${UNNORM_KEY_WIDOWX_DEFAULT:-bridge_orig}"
+UNNORM_KEY_GOOGLE_DEFAULT="${UNNORM_KEY_GOOGLE_DEFAULT:-fractal20220817_data}"
+UNNORM_KEY="${UNNORM_KEY_GLOBAL_OVERRIDE:-${UNNORM_KEY_WIDOWX_DEFAULT}}"
+
+# Model / data config
+# 按需改成你本机实际路径；这里保留占位默认值。
+MODEL_PATH="${MODEL_PATH:-/data5/cgk_lyy_0/models/openvla-7b}"
+DATA_PATH="${DATA_PATH:-/data5/cgk_lyy_0/datasets/libero_10_no_noops/1.0.0}"
+# 仅用于日志/输出分组标签；不代表在跑 LIBERO benchmark。
+TASK_NAME="openvla_base"
+# 任务组：
+#   single      -> 仅跑当前 ENV_NAME/SCENE_NAME/ROBOT 配置
+#   widowx_all  -> 依次跑 Spoon/Carrot/Stack/Eggplant 四个 WidowX 任务
+#   google_sheet -> 依次跑表格里的 Google 任务列
+TASK_GROUP="${TASK_GROUP:-google_sheet}"
+
+# 输出分组标签（仅影响日志/scale目录命名，不影响评测后端与 task_suite_name）
+# - libero 后端：默认沿用 TASK_NAME
+# - simplerenv 后端：默认命名为 simplerenv_<TASK_NAME>_<TASK_GROUP>
+# 可通过环境变量 OUTPUT_TAG 手动覆盖。
+OUTPUT_TAG="${OUTPUT_TAG:-}"
+if [[ -z "${OUTPUT_TAG}" ]]; then
+    if [[ "${EVAL_BACKEND}" == "simplerenv" ]]; then
+        OUTPUT_TAG="simplerenv_${TASK_NAME}_${TASK_GROUP}"
+    else
+        OUTPUT_TAG="${TASK_NAME}"
+    fi
+fi
+
+# ============ 全量 Google 评测配置 ============
+# Visual Matching URDF 变体 (对齐参考脚本中的 urdf_version_arr)
+VISUAL_MATCHING_URDF_VERSIONS=(
+    None
+    "recolor_tabletop_visual_matching_1"
+    "recolor_tabletop_visual_matching_2"
+    "recolor_cabinet_visual_matching_1"
+)
+
+# Drawer Visual Matching 9 个机器人位置
+# 格式: label,robot_x,robot_y,overlay_suffix,qx,qy,qz,qw
+# (quat 由参考脚本中的 rpy_range 的 yaw 值预计算而来)
+# Quaternion format: w,x,y,z (SAPIEN convention).
+# For non-zero yaw positions, computed as: euler2quat(0,0,yaw) * quat_center([0,0,0,1])
+# = [-sin(yaw/2), 0, 0, cos(yaw/2)]  in [w,x,y,z]
+DRAWER_VM_POSITIONS=(
+    "A0,0.644,-0.179,a0,0.015,0.0,0.0,0.999888"
+    "A1,0.765,-0.182,a1,0.01,0.0,0.0,0.99995"
+    "A2,0.889,-0.203,a2,0.03,0.0,0.0,0.99955"
+    "B0,0.652,0.009,b0,0.0,0.0,0.0,1.0"
+    "B1,0.752,0.009,b1,0.0,0.0,0.0,1.0"
+    "B2,0.851,0.035,b2,0.0,0.0,0.0,1.0"
+    "C0,0.665,0.224,c0,0.0,0.0,0.0,1.0"
+    "C1,0.765,0.222,c1,0.0125,0.0,0.0,0.999922"
+    "C2,0.865,0.222,c2,0.0125,0.0,0.0,0.999922"
+)
+
+# Apple-Drawer Visual Matching 3 个位置 (A0, B0, C0)
+APPLE_DRAWER_VM_POSITIONS=(
+    "A0,0.644,-0.179,a0,0.015,0.0,0.0,0.999888"
+    "B0,0.652,0.009,b0,0.0,0.0,0.0,1.0"
+    "C0,0.665,0.224,c0,0.0,0.0,0.0,1.0"
+)
+
+# Drawer 全部 6 个环境 (Open/Close × Top/Middle/Bottom)
+DRAWER_ALL_ENVS=(
+    OpenTopDrawerCustomInScene-v0
+    OpenMiddleDrawerCustomInScene-v0
+    OpenBottomDrawerCustomInScene-v0
+    CloseTopDrawerCustomInScene-v0
+    CloseMiddleDrawerCustomInScene-v0
+    CloseBottomDrawerCustomInScene-v0
+)
+
+# 汇总输出
+declare -a TASK_SUMMARY_LINES=()
+declare -a TASK_ORDER=()
+declare -A TASK_SEEN=()
+CURRENT_TASK_LABEL=""
+
+# FP + SimplerEnv batching (single Python process, single model load)
+USE_BATCH_SIMPLERENV_FP="${USE_BATCH_SIMPLERENV_FP:-1}"
+# 0: 使用 openvla-oft/main_quant.py 分支
+# 1: 使用 SimplerEnv-OpenVLA/main_quant.py 的原生 OpenVLA 分支
+USE_NATIVE_OPENVLA_BRANCH="${USE_NATIVE_OPENVLA_BRANCH:-0}"
+declare -a BATCH_FP_TASK_LABELS=()
+declare -a BATCH_FP_LOG_FILES=()
+BATCH_FP_JSON_PATH=""
+BATCH_FP_LOG_PATH=""
+
+# Fast-dev evaluation mode (for quick iteration)
+FAST_DEV="${FAST_DEV:-0}"
+FAST_DEV_EPISODES="${FAST_DEV_EPISODES:-10}"   # for obj_variation_mode=episode
+FAST_DEV_XY_N="${FAST_DEV_XY_N:-2}"            # keep first N entries for obj/robot XY arrays
+FAST_DEV_ROBOT_N="${FAST_DEV_ROBOT_N:-1}"      # keep first N robot init positions
+FAST_DEV_BANNER_PRINTED=0
+
+set_default_unnorm_key_for_policy_setup() {
+    if [[ -n "${UNNORM_KEY_GLOBAL_OVERRIDE}" ]]; then
+        UNNORM_KEY="${UNNORM_KEY_GLOBAL_OVERRIDE}"
+        return 0
+    fi
+
+    case "${POLICY_SETUP}" in
+        widowx_bridge)
+            UNNORM_KEY="${UNNORM_KEY_WIDOWX_DEFAULT}"
+            ;;
+        google_robot)
+            UNNORM_KEY="${UNNORM_KEY_GOOGLE_DEFAULT}"
+            ;;
+        *)
+            echo "[ERROR] Unknown POLICY_SETUP=${POLICY_SETUP} when selecting default UNNORM_KEY."
+            exit 1
+            ;;
+    esac
+}
+
+detect_model_feature_flags() {
+    USE_L1_REGRESSION=0
+    USE_PROPRIO=0
+    NUM_IMAGES="${NUM_IMAGES:-1}"
+
+    if find "${MODEL_PATH}" -maxdepth 1 -type f -name 'action_head*checkpoint*' | grep -q .; then
+        USE_L1_REGRESSION=1
+        NUM_IMAGES="${NUM_IMAGES_OVERRIDE:-2}"
+    fi
+
+    if find "${MODEL_PATH}" -maxdepth 1 -type f -name 'proprio_projector*checkpoint*' | grep -q .; then
+        USE_PROPRIO=1
+        NUM_IMAGES="${NUM_IMAGES_OVERRIDE:-2}"
+    fi
+
+    echo "[INFO] Model feature detection: USE_L1_REGRESSION=${USE_L1_REGRESSION}, USE_PROPRIO=${USE_PROPRIO}, NUM_IMAGES=${NUM_IMAGES}"
+}
+
+build_model_args() {
+    local -n out_args_ref="$1"
+    out_args_ref=()
+
+    if [[ "${USE_L1_REGRESSION}" == "1" ]]; then
+        out_args_ref+=(--use_l1_regression)
+    fi
+
+    if [[ "${USE_PROPRIO}" == "1" ]]; then
+        out_args_ref+=(--use_proprio)
+    fi
+}
+
+validate_eval_scope() {
+    if [[ "${EVAL_BACKEND}" != "simplerenv" ]]; then
+        return 0
+    fi
+
+    if [[ "${GOOGLE_ONLY}" == "1" ]]; then
+        if [[ "${POLICY_SETUP}" != "google_robot" ]]; then
+            echo "[ERROR] GOOGLE_ONLY=1 时，POLICY_SETUP 必须为 google_robot，当前为 ${POLICY_SETUP}"
+            exit 1
+        fi
+
+        if [[ "${ROBOT}" != "google_robot_static" ]]; then
+            echo "[ERROR] GOOGLE_ONLY=1 时，ROBOT 必须为 google_robot_static，当前为 ${ROBOT}"
+            exit 1
+        fi
+
+        if [[ "${ENV_NAME}" == *widow* || "${ENV_NAME}" == *Widow* || "${SCENE_NAME}" == *widow* || "${SCENE_NAME}" == *Widow* ]]; then
+            echo "[ERROR] GOOGLE_ONLY=1 时，不允许使用 WidowX 相关环境或场景。"
+            echo "        当前 ENV_NAME=${ENV_NAME}, SCENE_NAME=${SCENE_NAME}"
+            exit 1
+        fi
+    fi
+}
+
+build_eval_args() {
+    local task="$1"
+    local -n out_args_ref="$2"
+
+    case "${EVAL_BACKEND}" in
+        libero)
+            out_args_ref=(
+                --eval_libero
+                --task_suite_name "${task}"
+                --num_trials_per_task 50
+            )
+            ;;
+        simplerenv)
+            if [[ -z "${ENV_NAME}" ]]; then
+                echo "[ERROR] ENV_NAME must be set when EVAL_BACKEND=simplerenv"
+                exit 1
+            fi
+            out_args_ref=(
+                --num_images "${NUM_IMAGES}"
+                --eval_simplerenv
+                --task_suite_name "${task}"
+                --unnorm_key "${UNNORM_KEY}"
+                --policy_setup "${POLICY_SETUP}"
+                --action_scale "${ACTION_SCALE}"
+                --robot "${ROBOT}"
+                --env_name "${ENV_NAME}"
+                --scene_name "${SCENE_NAME}"
+                --robot_init_xs "${ROBOT_INIT_XS[@]}"
+                --robot_init_ys "${ROBOT_INIT_YS[@]}"
+                --robot_init_quats "${ROBOT_INIT_QUATS[@]}"
+                --control_freq "${CONTROL_FREQ}"
+                --sim_freq "${SIM_FREQ}"
+                --max_episode_steps "${MAX_EPISODE_STEPS}"
+                --logging_dir "${LOGGING_DIR}"
+            )
+
+            if [[ -n "${RGB_OVERLAY_PATH}" ]]; then
+                out_args_ref+=(--rgb_overlay_path "${RGB_OVERLAY_PATH}")
+            fi
+
+            if [[ -n "${OBS_CAMERA_NAME}" ]]; then
+                out_args_ref+=(--obs_camera_name "${OBS_CAMERA_NAME}")
+            fi
+
+            if [[ "${ENABLE_RAYTRACING}" == "1" ]]; then
+                out_args_ref+=(--enable_raytracing)
+            fi
+
+            if [[ -n "${ADDITIONAL_ENV_SAVE_TAGS}" ]]; then
+                out_args_ref+=(--additional_env_save_tags "${ADDITIONAL_ENV_SAVE_TAGS}")
+            fi
+
+            if [[ "${#ADDITIONAL_ENV_BUILD_KWARGS[@]}" -gt 0 ]]; then
+                out_args_ref+=(--additional_env_build_kwargs "${ADDITIONAL_ENV_BUILD_KWARGS[@]}")
+            fi
+
+            out_args_ref+=(--obj_variation_mode "${OBJ_VARIATION_MODE}")
+            if [[ "${OBJ_VARIATION_MODE}" == "xy" ]]; then
+                out_args_ref+=(--obj_init_xs "${OBJ_INIT_XS[@]}" --obj_init_ys "${OBJ_INIT_YS[@]}")
+            else
+                out_args_ref+=(--obj_episode_range "${OBJ_EPISODE_START}" "${OBJ_EPISODE_END}")
+            fi
+            ;;
+        *)
+            echo "[ERROR] Unknown EVAL_BACKEND=${EVAL_BACKEND}. Use libero / simplerenv"
+            exit 1
+            ;;
+    esac
+}
+
+sanitize_tag() {
+    local raw="$1"
+    raw="${raw// /_}"
+    raw="${raw//\//_}"
+    raw="${raw//:/_}"
+    echo "${raw}"
+}
+
+apply_fast_dev_overrides() {
+    if [[ "${FAST_DEV}" != "1" ]]; then
+        return 0
+    fi
+
+    if [[ "${FAST_DEV_BANNER_PRINTED}" == "0" ]]; then
+        echo "[INFO] FAST_DEV=1 enabled: episodes<=${FAST_DEV_EPISODES}, xy_n=${FAST_DEV_XY_N}, robot_n=${FAST_DEV_ROBOT_N}"
+        FAST_DEV_BANNER_PRINTED=1
+    fi
+
+    local nxy="${FAST_DEV_XY_N}"
+    local nrobot="${FAST_DEV_ROBOT_N}"
+
+    # Reduce robot init grid (often a major multiplicative factor)
+    if [[ "${#ROBOT_INIT_XS[@]}" -gt "${nrobot}" ]]; then
+        ROBOT_INIT_XS=("${ROBOT_INIT_XS[@]:0:${nrobot}}")
+    fi
+    if [[ "${#ROBOT_INIT_YS[@]}" -gt "${nrobot}" ]]; then
+        ROBOT_INIT_YS=("${ROBOT_INIT_YS[@]:0:${nrobot}}")
+    fi
+    # Flattened quaternion array in groups of 4 values
+    local q_keep=$(( nrobot * 4 ))
+    if [[ "${#ROBOT_INIT_QUATS[@]}" -gt "${q_keep}" ]]; then
+        ROBOT_INIT_QUATS=("${ROBOT_INIT_QUATS[@]:0:${q_keep}}")
+    fi
+
+    if [[ "${OBJ_VARIATION_MODE}" == "xy" ]]; then
+        if [[ "${#OBJ_INIT_XS[@]}" -gt "${nxy}" ]]; then
+            OBJ_INIT_XS=("${OBJ_INIT_XS[@]:0:${nxy}}")
+        fi
+        if [[ "${#OBJ_INIT_YS[@]}" -gt "${nxy}" ]]; then
+            OBJ_INIT_YS=("${OBJ_INIT_YS[@]:0:${nxy}}")
+        fi
+    elif [[ "${OBJ_VARIATION_MODE}" == "episode" ]]; then
+        local start="${OBJ_EPISODE_START}"
+        local end="${OBJ_EPISODE_END}"
+        local fast_end=$(( start + FAST_DEV_EPISODES ))
+        if (( fast_end < end )); then
+            OBJ_EPISODE_END="${fast_end}"
+        fi
+    fi
+}
+
+get_eval_tag() {
+    if [[ -n "${CURRENT_TASK_LABEL}" ]]; then
+        sanitize_tag "${CURRENT_TASK_LABEL}"
+    else
+        sanitize_tag "${POLICY_SETUP}_${ROBOT}_${ENV_NAME}_${SCENE_NAME}"
+    fi
+}
+
+extract_simplerenv_avg_success() {
+    local log_file="$1"
+    local result_label="${2:-}"
+    if [[ ! -f "${log_file}" ]]; then
+        echo "NA|NA"
+        return 0
+    fi
+
+    local entire partial
+    if [[ -n "${result_label}" ]]; then
+        entire="$(grep -F "[${result_label}] Entire  success:" "${log_file}" | tail -n 1 | grep -oP '(?<=Entire  success: )[0-9.]+' || true)"
+        partial="$(grep -F "[${result_label}] Partial success:" "${log_file}" | tail -n 1 | grep -oP '(?<=Partial success: )[0-9.]+' || true)"
+    else
+        entire="$(grep -oP '(?<=Entire  success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+        partial="$(grep -oP '(?<=Partial success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+    fi
+
+    # Fallback for old format: "Average success: X.XXXX"
+    if [[ -z "${entire}" ]]; then
+        entire="$(grep -oP '(?<=Average success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+    fi
+    [[ -z "${entire}" ]] && entire="NA"
+    [[ -z "${partial}" ]] && partial="NA"
+    echo "${entire}|${partial}"
+}
+
+append_task_summary() {
+    local task_label="$1"
+    local run_kind="$2"
+    local cfg_tag="$3"
+    local log_file="$4"
+    local result_label="${5:-}"
+    local success_pair
+    success_pair="$(extract_simplerenv_avg_success "${log_file}" "${result_label}")"
+    local entire partial
+    IFS='|' read -r entire partial <<< "${success_pair}"
+
+    if [[ -z "${TASK_SEEN[${task_label}]+x}" ]]; then
+        TASK_ORDER+=("${task_label}")
+        TASK_SEEN["${task_label}"]=1
+    fi
+
+    TASK_SUMMARY_LINES+=("${task_label}|${run_kind}|${cfg_tag}|${entire}|${partial}|${log_file}")
+}
+
+should_batch_fp_eval() {
+    [[ "${USE_BATCH_SIMPLERENV_FP}" == "1" && "${EVAL_BACKEND}" == "simplerenv" && "${MODE}" == "fp" ]]
+}
+
+enqueue_fp_eval_task() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local task_label="$4"
+
+    mkdir -p "${LOG_BASE}/${OUTPUT_TAG}"
+    if [[ -z "${BATCH_FP_JSON_PATH}" ]]; then
+        BATCH_FP_JSON_PATH="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_batch_tasks_$(date +%Y%m%d_%H%M%S).json"
+        echo "[]" > "${BATCH_FP_JSON_PATH}"
+    fi
+    if [[ -z "${BATCH_FP_LOG_PATH}" ]]; then
+        BATCH_FP_LOG_PATH="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_batch.log"
+    fi
+
+    local robot_init_xs_csv robot_init_ys_csv robot_init_quats_csv obj_init_xs_csv obj_init_ys_csv
+    local obj_episode_range_csv add_kwargs_sep add_kwargs_blob
+    robot_init_xs_csv="$(IFS=,; echo "${ROBOT_INIT_XS[*]}")"
+    robot_init_ys_csv="$(IFS=,; echo "${ROBOT_INIT_YS[*]}")"
+    robot_init_quats_csv="$(IFS=,; echo "${ROBOT_INIT_QUATS[*]}")"
+    obj_init_xs_csv="$(IFS=,; echo "${OBJ_INIT_XS[*]:-}")"
+    obj_init_ys_csv="$(IFS=,; echo "${OBJ_INIT_YS[*]:-}")"
+    obj_episode_range_csv="${OBJ_EPISODE_START},${OBJ_EPISODE_END}"
+    add_kwargs_sep=$'\x1f'
+    add_kwargs_blob="$(IFS="${add_kwargs_sep}"; echo "${ADDITIONAL_ENV_BUILD_KWARGS[*]:-}")"
+
+    python3 - "${BATCH_FP_JSON_PATH}" "${task_label}" "${task}" "${model}" "${data}" \
+        "${UNNORM_KEY}" "${NUM_IMAGES}" "${POLICY_SETUP}" "${ACTION_SCALE}" "${ROBOT}" \
+        "${ENV_NAME}" "${SCENE_NAME}" "${robot_init_xs_csv}" "${robot_init_ys_csv}" "${robot_init_quats_csv}" \
+        "${CONTROL_FREQ}" "${SIM_FREQ}" "${MAX_EPISODE_STEPS}" "${RGB_OVERLAY_PATH}" "${OBS_CAMERA_NAME}" \
+        "${ENABLE_RAYTRACING}" "${ADDITIONAL_ENV_SAVE_TAGS}" "${OBJ_VARIATION_MODE}" "${obj_init_xs_csv}" "${obj_init_ys_csv}" \
+        "${obj_episode_range_csv}" "${add_kwargs_blob}" "${add_kwargs_sep}" <<'PY'
+import json, sys
+
+(
+    path, result_label, task_suite_name, model_path, data_path,
+    unnorm_key, num_images, policy_setup, action_scale, robot,
+    env_name, scene_name, robot_init_xs_csv, robot_init_ys_csv, robot_init_quats_csv,
+    control_freq, sim_freq, max_episode_steps, rgb_overlay_path, obs_camera_name,
+    enable_raytracing, additional_env_save_tags, obj_variation_mode, obj_init_xs_csv, obj_init_ys_csv,
+    obj_episode_range_csv, add_kwargs_blob, add_kwargs_sep,
+) = sys.argv[1:]
+
+def f_list(csv):
+    return [float(x) for x in csv.split(',') if x != '']
+
+def i_list(csv):
+    return [int(x) for x in csv.split(',') if x != '']
+
+obj = {
+    "result_label": result_label,
+    "task_suite_name": task_suite_name,
+    "model": model_path,
+    "data": data_path,
+    "unnorm_key": unnorm_key,
+    "num_images": int(num_images),
+    "policy_setup": policy_setup,
+    "action_scale": float(action_scale),
+    "robot": robot,
+    "env_name": env_name,
+    "scene_name": scene_name,
+    "robot_init_xs": f_list(robot_init_xs_csv),
+    "robot_init_ys": f_list(robot_init_ys_csv),
+    "robot_init_quats": f_list(robot_init_quats_csv),
+    "control_freq": int(control_freq),
+    "sim_freq": int(sim_freq),
+    "max_episode_steps": int(max_episode_steps),
+    "obj_variation_mode": obj_variation_mode,
+    "obj_init_xs": f_list(obj_init_xs_csv),
+    "obj_init_ys": f_list(obj_init_ys_csv),
+    "obj_episode_range": i_list(obj_episode_range_csv),
+    "enable_raytracing": str(enable_raytracing) == "1",
+    "additional_env_build_kwargs": [x for x in add_kwargs_blob.split(add_kwargs_sep) if x],
+}
+
+if rgb_overlay_path:
+    obj["rgb_overlay_path"] = rgb_overlay_path
+if obs_camera_name:
+    obj["obs_camera_name"] = obs_camera_name
+if additional_env_save_tags:
+    obj["additional_env_save_tags"] = additional_env_save_tags
+
+with open(path, 'r', encoding='utf-8') as f:
+    arr = json.load(f)
+arr.append(obj)
+with open(path, 'w', encoding='utf-8') as f:
+    json.dump(arr, f, ensure_ascii=False)
+PY
+
+    BATCH_FP_TASK_LABELS+=("${task_label}")
+    BATCH_FP_LOG_FILES+=("${BATCH_FP_LOG_PATH}")
+}
+
+flush_fp_batch_eval() {
+    if ! should_batch_fp_eval; then
+        return 0
+    fi
+    if [[ -z "${BATCH_FP_JSON_PATH}" || "${#BATCH_FP_TASK_LABELS[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    local model_args=()
+    build_model_args model_args
+
+    echo "[INFO] Running batched FP SimplerEnv eval (${#BATCH_FP_TASK_LABELS[@]} tasks, single model load) ..."
+    if [[ "${USE_NATIVE_OPENVLA_BRANCH}" == "1" ]]; then
+        echo "[INFO] USE_NATIVE_OPENVLA_BRANCH=1: dispatch to sibling SimplerEnv-OpenVLA-clean/main_quant.py"
+        python3 "${REPO_ROOT}/SimplerEnv-OpenVLA-clean/main_quant.py" \
+            --native-openvla \
+            --model "${MODEL_PATH}" \
+            --simplerenv_tasks_json "${BATCH_FP_JSON_PATH}" \
+            |& tee "${BATCH_FP_LOG_PATH}"
+    else
+        python3 main_quant.py \
+            --model "${MODEL_PATH}" \
+            --data "${DATA_PATH}" \
+            "${model_args[@]}" \
+            --eval_simplerenv \
+            --fp_simplerenv_only \
+            --simplerenv_tasks_json "${BATCH_FP_JSON_PATH}" \
+            --seed "${SEED}" \
+            --deterministic \
+            |& tee "${BATCH_FP_LOG_PATH}"
+    fi
+
+    local i task_label log_file
+    for i in "${!BATCH_FP_TASK_LABELS[@]}"; do
+        task_label="${BATCH_FP_TASK_LABELS[$i]}"
+        log_file="${BATCH_FP_LOG_FILES[$i]}"
+        append_task_summary "${task_label}" "fp" "-" "${log_file}" "${task_label}"
+    done
+
+    # reset batch state
+    BATCH_FP_TASK_LABELS=()
+    BATCH_FP_LOG_FILES=()
+    BATCH_FP_JSON_PATH=""
+    BATCH_FP_LOG_PATH=""
+}
+
+print_task_only_summary() {
+    if [[ "${#TASK_ORDER[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Final Task Success ======================"
+    for task_label in "${TASK_ORDER[@]}"; do
+        local parts=()
+        for record in "${TASK_SUMMARY_LINES[@]}"; do
+            local r_task run_kind cfg_tag entire partial log_file
+            IFS='|' read -r r_task run_kind cfg_tag entire partial log_file <<< "${record}"
+            if [[ "${r_task}" != "${task_label}" ]]; then
+                continue
+            fi
+
+            if [[ "${run_kind}" == "fp" ]]; then
+                parts+=("fp: entire=${entire} partial=${partial}")
+            else
+                parts+=("${cfg_tag}: entire=${entire} partial=${partial}")
+            fi
+        done
+
+        echo "${task_label}: ${parts[*]}"
+    done
+    echo "=========================================================="
+}
+
+print_task_summary() {
+    if [[ "${#TASK_SUMMARY_LINES[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Per-task Success Summary ================"
+    printf "%-30s %-10s %-12s %-10s %-10s\n" "task" "run" "config" "entire" "partial"
+    for record in "${TASK_SUMMARY_LINES[@]}"; do
+        local task_label run_kind cfg_tag entire partial log_file
+        IFS='|' read -r task_label run_kind cfg_tag entire partial log_file <<< "${record}"
+        printf "%-30s %-10s %-12s %-10s %-10s\n" "${task_label}" "${run_kind}" "${cfg_tag}" "${entire}" "${partial}"
+    done
+    echo "=========================================================="
+
+    print_task_only_summary
+}
+
+check_gpu() {
+    echo "[INFO] Checking GPU availability..."
+    nvidia-smi || { echo "[ERROR] No GPU detected by nvidia-smi. Abort."; exit 1; }
+    python3 - <<'PY'
+import torch
+print("cuda available =", torch.cuda.is_available())
+print("device count   =", torch.cuda.device_count())
+if not torch.cuda.is_available():
+    raise SystemExit("[ERROR] torch cannot see CUDA.")
+PY
+}
+
+check_vulkan() {
+    if [[ "${EVAL_BACKEND}" != "simplerenv" ]]; then
+        return 0
+    fi
+
+    echo "[INFO] Checking Vulkan availability for headless SimplerEnv eval..."
+
+    if ! command -v vulkaninfo >/dev/null 2>&1; then
+        echo "[WARN] vulkaninfo not found; skipping Vulkan preflight. If SimplerEnv still crashes,"
+        echo "       install vulkan-tools and verify the NVIDIA Vulkan driver inside this environment."
+        return 0
+    fi
+
+    local vulkan_summary
+    if ! vulkan_summary="$(vulkaninfo --summary 2>&1)"; then
+        echo "[ERROR] Vulkan preflight failed. SimplerEnv evaluation needs a working Vulkan renderer."
+        echo "${vulkan_summary}"
+        echo "[HINT] SAPIEN does not support CPU rendering for this path. Check VK_ICD_FILENAMES,"
+        echo "       the NVIDIA driver install, and whether the container exposes Vulkan libraries."
+        exit 1
+    fi
+
+    if ! grep -qiE "driverName[[:space:]]*=[[:space:]]*NVIDIA|deviceName[[:space:]]*=[[:space:]]*NVIDIA" <<<"${vulkan_summary}"; then
+        echo "[ERROR] Vulkan preflight did not find an NVIDIA Vulkan device."
+        echo "${vulkan_summary}"
+        echo "[HINT] This usually means the container cannot see the real Vulkan driver."
+        exit 1
+    fi
+
+    echo "[INFO] Vulkan preflight passed."
+}
+
+run_fp_eval() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local eval_args=()
+    local extra_args=()
+    local model_args=()
+    local eval_tag
+    local task_label
+    local log_file
+    eval_tag="$(get_eval_tag)"
+    task_label="${CURRENT_TASK_LABEL:-$(sanitize_tag "${ENV_NAME}")}"
+
+    apply_fast_dev_overrides
+
+    build_eval_args "${task}" eval_args
+    build_model_args model_args
+    if [[ "${EVAL_BACKEND}" == "simplerenv" ]]; then
+        extra_args+=(--fp_simplerenv_only)
+    fi
+
+    if should_batch_fp_eval; then
+        echo "[INFO] Queue FP task for batch eval: ${task_label}"
+        enqueue_fp_eval_task "${task}" "${model}" "${data}" "${task_label}"
+        return 0
+    fi
+
+    mkdir -p "${LOG_BASE}/${OUTPUT_TAG}"
+    log_file="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_${eval_tag}.log"
+
+    echo "[INFO] Eval config: policy_setup=${POLICY_SETUP}, robot=${ROBOT}, env=${ENV_NAME}, scene=${SCENE_NAME}"
+    echo "[INFO] Eval config: robot_init_xs=${ROBOT_INIT_XS[*]}, robot_init_ys=${ROBOT_INIT_YS[*]}, robot_init_quats=${ROBOT_INIT_QUATS[*]}"
+    echo "[INFO] Eval config: obj_variation_mode=${OBJ_VARIATION_MODE}, obj_init_xs=${OBJ_INIT_XS[*]:-}, obj_init_ys=${OBJ_INIT_YS[*]:-}, obj_episode_range=[${OBJ_EPISODE_START}, ${OBJ_EPISODE_END}), unnorm_key=${UNNORM_KEY}, num_images=${NUM_IMAGES}"
+    echo "[INFO] Eval config: overlay=${RGB_OVERLAY_PATH:-None}, raytracing=${ENABLE_RAYTRACING}, additional_kwargs=${ADDITIONAL_ENV_BUILD_KWARGS[*]:-None}"
+
+    echo "[INFO] Running FP baseline eval for ${task} with backend=${EVAL_BACKEND} ..."
+    python3 main_quant.py \
+        --model "${model}" \
+        --data "${data}" \
+        "${model_args[@]}" \
+        "${eval_args[@]}" \
+        "${extra_args[@]}" \
+        --seed "${SEED}" \
+        --deterministic \
+        |& tee "${log_file}"
+
+    append_task_summary "${task_label}" "fp" "-" "${log_file}"
+}
+
+run_one_setting() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local w_bit="$4"
+    local a_bit="$5"
+    local cfg_tag="w${w_bit}a${a_bit}kv16"
+    local eval_args=()
+    local model_args=()
+    local eval_tag
+    local task_label
+    local eval_log_file
+    eval_tag="$(get_eval_tag)"
+    task_label="${CURRENT_TASK_LABEL:-$(sanitize_tag "${ENV_NAME}")}"
+
+    apply_fast_dev_overrides
+
+    build_eval_args "${task}" eval_args
+    build_model_args model_args
+
+    local scale_dir="${SCALE_BASE}/${OUTPUT_TAG}/${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}"
+    mkdir -p "${scale_dir}" "${LOG_BASE}/${OUTPUT_TAG}"
+
+    # 1) 生成 scale（若已存在则复用，避免多任务重复校准）
+    if [[ -f "${scale_dir}/scale.pt" ]]; then
+        echo "[INFO] Reusing existing scale: ${scale_dir}/scale.pt"
+    else
+        echo "[INFO] Generating scale for ${task} ${cfg_tag} ..."
+        python3 main_quant.py \
+            --model "${model}" \
+            --data "${data}" \
+            "${model_args[@]}" \
+            --method smoothquant \
+            --alpha "${SQ_ALPHA}" \
+            --sq_scale_mode "${SQ_SCALE_MODE}" \
+            --w_bit "${w_bit}" --a_bit "${a_bit}" \
+            --scale_path "${scale_dir}/scale.pt" \
+            --run_process \
+            --deterministic \
+            --calib_sampling "${CALIB_SAMPLING}" \
+            --calib_prompt_balance \
+            --n_samples "${N_SAMPLES}" \
+            --task_suite_name "${task}" \
+            --seed "${SEED}" \
+            |& tee "${LOG_BASE}/${OUTPUT_TAG}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_scale.log"
+    fi
+
+    # 2) pseudo quant + eval
+    echo "[INFO] Running pseudo-quant eval for ${task} ${cfg_tag} ..."
+    eval_log_file="${LOG_BASE}/${OUTPUT_TAG}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_eval_${eval_tag}.log"
+    python3 main_quant.py \
+        --model "${model}" \
+        --data "${data}" \
+        "${model_args[@]}" \
+        --method smoothquant \
+        --alpha "${SQ_ALPHA}" \
+        --sq_scale_mode "${SQ_SCALE_MODE}" \
+        --w_bit "${w_bit}" --a_bit "${a_bit}" \
+        --scale_path "${scale_dir}/scale.pt" \
+        --pseudo_quant \
+        --deterministic \
+        --calib_sampling "${CALIB_SAMPLING}" \
+        --calib_prompt_balance \
+        --n_samples "${N_SAMPLES}" \
+        "${eval_args[@]}" \
+        --seed "${SEED}" \
+        |& tee "${eval_log_file}"
+
+    append_task_summary "${task_label}" "quant" "${cfg_tag}" "${eval_log_file}"
+}
+
+run_quant_suite() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+
+    run_one_setting "${task}" "${model}" "${data}" 4 4
+    run_one_setting "${task}" "${model}" "${data}" 8 8
+}
+
+run_suite() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+
+    case "${MODE}" in
+        fp)
+            run_fp_eval "${task}" "${model}" "${data}"
+            ;;
+        quant)
+            run_quant_suite "${task}" "${model}" "${data}"
+            ;;
+        all)
+            run_fp_eval "${task}" "${model}" "${data}"
+            run_quant_suite "${task}" "${model}" "${data}"
+            ;;
+        *)
+            echo "[ERROR] Unknown MODE=${MODE}. Use fp / quant / all"
+            exit 1
+            ;;
+    esac
+}
+
