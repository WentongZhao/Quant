+def _make_runtime_args(args: argparse.Namespace) -> SimpleNamespace:
+    run_args = SimpleNamespace()
+    run_args.policy_model = args.policy_model
+    run_args.ckpt_path = args.model
+    run_args.policy_setup = args.policy_setup
+    run_args.robot = args.robot
+    run_args.env_name = args.env_name
+    run_args.scene_name = args.scene_name
+    run_args.action_scale = float(args.action_scale)
+    run_args.control_freq = int(args.control_freq)
+    run_args.sim_freq = int(args.sim_freq)
+    run_args.max_episode_steps = int(args.max_episode_steps)
+    run_args.enable_raytracing = bool(args.enable_raytracing)
+    run_args.additional_env_save_tags = args.additional_env_save_tags
+    run_args.rgb_overlay_path = args.rgb_overlay_path
+    run_args.obs_camera_name = args.obs_camera_name
+    run_args.logging_dir = args.logging_dir
+    run_args.obj_variation_mode = args.obj_variation_mode
+    run_args.obj_episode_range = list(args.obj_episode_range)
+    run_args.obj_init_xs = np.asarray(args.obj_init_xs, dtype=np.float64)
+    run_args.obj_init_ys = np.asarray(args.obj_init_ys, dtype=np.float64)
+    run_args.robot_init_xs = np.asarray(args.robot_init_xs, dtype=np.float64)
+    run_args.robot_init_ys = np.asarray(args.robot_init_ys, dtype=np.float64)
+    run_args.robot_init_quats = _to_quat_list(list(args.robot_init_quats))
+
+    add_kwargs = args.additional_env_build_kwargs
+    if isinstance(add_kwargs, dict):
+        run_args.additional_env_build_kwargs = dict(add_kwargs)
+    elif isinstance(add_kwargs, list):
+        run_args.additional_env_build_kwargs = _parse_kv_list_to_dict(add_kwargs)
+    else:
+        run_args.additional_env_build_kwargs = {}
+
+    if "renderer_kwargs" not in run_args.additional_env_build_kwargs and not os.environ.get("DISPLAY"):
+        run_args.additional_env_build_kwargs["renderer_kwargs"] = {"offscreen_only": True}
+
+    return run_args
+
