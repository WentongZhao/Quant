+def _validate_eval_args(args: argparse.Namespace) -> None:
+    if args.policy_model != "openvla":
+        raise NotImplementedError("Only --policy_model openvla is supported in FP mode.")
+    if args.action_scale <= 0:
+        raise ValueError("--action_scale must be positive")
+    if not args.env_name or not args.scene_name:
+        raise ValueError("--env_name and --scene_name are required")
+    if len(args.robot_init_quats) == 0:
+        raise ValueError("--robot_init_quats cannot be empty")
+    if args.obj_variation_mode == "xy":
+        if len(args.obj_init_xs) == 0 or len(args.obj_init_ys) == 0:
+            raise ValueError("obj_init_xs and obj_init_ys are required when --obj_variation_mode=xy")
+    else:
+        if len(args.obj_episode_range) != 2 or not (0 <= args.obj_episode_range[0] < args.obj_episode_range[1]):
+            raise ValueError("obj_episode_range must be [start, end] with 0 <= start < end")
+
