+def _append_cli_arg(cmd: list[str], flag: str, value: Any) -> None:
+    if value is None:
+        return
+    cmd.extend([flag, str(value)])
+
+
+def _append_cli_multi_arg(cmd: list[str], flag: str, values: Iterable[Any] | None) -> None:
+    if values is None:
+        return
+    values_list = list(values)
+    if not values_list:
+        return
+    cmd.append(flag)
+    cmd.extend(str(v) for v in values_list)
+
