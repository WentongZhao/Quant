+def _run_openvla_oft_libero_quant_mode(args: argparse.Namespace, backend: str) -> None:
+    oft_root = _openvla_oft_repo_root()
+    oft_main = oft_root / "main_quant.py"
+    if not oft_main.exists():
+        raise FileNotFoundError(f"OpenVLA-OFT entrypoint not found: {oft_main}")
+    if not args.data:
+        raise ValueError("libero_quant requires --data for OpenVLA-OFT calibration/evaluation.")
+
+    method = str(args.method).strip()
+    if method in {"", "fp"}:
+        raise ValueError("libero_quant requires a quantization --method such as mbq / awq / smoothquant / rtn.")
+
+    model_path = args.openvla_oft_model or args.model
+    cmd = [
+        sys.executable,
+        str(oft_main),
+        "--model",
+        model_path,
+        "--data",
+        str(args.data),
+        "--method",
+        method,
+        "--eval_libero",
+        "--task_suite_name",
+        str(args.task_suite_name),
+        "--num_trials_per_task",
+        str(args.num_trials_per_task),
+        "--seed",
+        str(args.seed),
+        "--num_images",
+        str(args.num_images),
+        "--n_samples",
+        str(args.n_samples),
+        "--w_bit",
+        str(args.w_bit),
+        "--a_bit",
+        str(args.a_bit),
+        "--w_group",
+        str(args.w_group),
+    ]
+
+    if args.unnorm_key:
+        _append_cli_arg(cmd, "--unnorm_key", args.unnorm_key)
+    if args.scale_path:
+        _append_cli_arg(cmd, "--scale_path", args.scale_path)
+    if args.use_l1_regression:
+        cmd.append("--use_l1_regression")
+    if args.use_proprio:
+        cmd.append("--use_proprio")
+    if args.pseudo_quant:
+        cmd.append("--pseudo_quant")
+    if args.run_process:
+        cmd.append("--run_process")
+    if args.deterministic:
+        cmd.append("--deterministic")
+    if args.rotate_images:
+        cmd.append("--rotate_images")
+
+    print(f"[main_quant] forwarding LIBERO quant to OpenVLA-OFT: {' '.join(cmd)}")
+    subprocess.run(cmd, check=True, cwd=str(oft_root))
+
