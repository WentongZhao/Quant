+        model.unnorm_key = "bridge_orig" if unnorm_key is None else unnorm_key
+    elif policy_setup == "google_robot":
+        model.sticky_gripper_num_repeat = 15
+        model.unnorm_key = "fractal20220817_data" if unnorm_key is None else unnorm_key
+    else:
+        raise NotImplementedError(f"Policy setup {policy_setup} not supported for OpenVLA FP eval.")
