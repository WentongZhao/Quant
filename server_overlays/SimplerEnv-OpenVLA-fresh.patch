+def _run_openvla_simplerenv_official_mode(args: argparse.Namespace, backend: str) -> None:
+    repo_root = _fresh_repo_root()
+    scripts_dir = repo_root / "scripts"
+    ckpt_path = str(Path(args.model).expanduser())
+    logging_dir = str(Path(args.logging_dir).expanduser())
+    gpu_id = str(args.gpu_id)
+    action_ensemble_temp = str(args.action_ensemble_temp)
+    policy_model = args.policy_model
+    env = os.environ.copy()
+    python_bin_dir = str(Path(sys.executable).resolve().parent)
+    env["PATH"] = python_bin_dir + os.pathsep + env.get("PATH", "")
+    # Force CUDA ordinal mapping to follow PCI bus order so --gpu_id matches nvidia-smi index.
+    env["CUDA_DEVICE_ORDER"] = "PCI_BUS_ID"
+
+    if args.benchmark_subset != "all":
+        script_name = OFFICIAL_SIMPLERENV_SCRIPT_BY_SUBSET[args.benchmark_subset]
+        script_path = scripts_dir / script_name
+        cmd = [
+            "bash",
+            str(script_path),
+            ckpt_path,
+            policy_model,
+            action_ensemble_temp,
+            logging_dir,
+            gpu_id,
+        ]
+        if not script_path.exists():
+            raise FileNotFoundError(f"Official SimplerEnv script not found: {script_path}")
+        print(f"[main_quant] forwarding official SimplerEnv benchmark: {' '.join(cmd)}")
+        subprocess.run(cmd, check=True, cwd=str(repo_root), env=env)
+        return
+
+    os.makedirs(logging_dir, exist_ok=True)
+    for script_name in OFFICIAL_SIMPLERENV_ALL_SCRIPTS:
+        script_path = scripts_dir / script_name
+        if not script_path.exists():
+            raise FileNotFoundError(f"Official SimplerEnv script not found: {script_path}")
+        cmd = [
+            "bash",
+            str(script_path),
+            ckpt_path,
+            policy_model,
+            action_ensemble_temp,
+            logging_dir,
+            gpu_id,
+        ]
+        print(f"[main_quant] forwarding official SimplerEnv benchmark: {' '.join(cmd)}")
+        subprocess.run(cmd, check=True, cwd=str(repo_root), env=env)
+
+    metrics_cmd = [
+        sys.executable,
+        str(repo_root / "tools" / "calc_metrics_evaluation_videos.py"),
+        "--log-dir-root",
+        logging_dir,
+    ]
+    print(f"[main_quant] summarizing official SimplerEnv benchmark: {' '.join(metrics_cmd)}")
+    with open(Path(logging_dir) / "total.metrics", "a", encoding="utf-8") as metrics_file:
+        subprocess.run(metrics_cmd, check=True, cwd=str(repo_root), env=env, stdout=metrics_file)
+
+
+def _run_openvla_libero_fp_mode(args: argparse.Namespace, backend: str) -> None:
+    raise NotImplementedError(
+        "libero_fp with model_backend=openvla is now a first-class interface, "
+        "but the native OpenVLA LIBERO FP runner has not been wired yet."
+    )
+
+
+def _run_openvla_oft_libero_fp_mode(args: argparse.Namespace, backend: str) -> None:
+    raise NotImplementedError(
+        "libero_fp with model_backend=openvla_oft is now a first-class interface, "
+        "but the OpenVLA-OFT LIBERO FP runner has not been wired yet."
+    )
+
+
+def _run_task(task_args: argparse.Namespace, label: str, model_cache: Dict[str, OpenVLAInference]) -> None:
+    _validate_eval_args(task_args)
+    runtime_args = _make_runtime_args(task_args)
+    unnorm_key = task_args.unnorm_key
+
+    cache_key = str(task_args.model)
+    if cache_key not in model_cache:
+        model_cache[cache_key] = OpenVLAInference(
+            saved_model_path=task_args.model,
+            unnorm_key=unnorm_key,
+            policy_setup=task_args.policy_setup,
+            action_scale=task_args.action_scale,
+        )
+
+    model = model_cache[cache_key]
+    model.action_scale = task_args.action_scale
+    _apply_policy_runtime_config(model, task_args.policy_setup, unnorm_key)
+
+    os.makedirs(task_args.logging_dir, exist_ok=True)
+    print(f"\n[{label}]")
+    eval_results = maniskill2_evaluator(model, runtime_args)
+    entire_arr, partial_arr = _normalize_eval_results(eval_results)
+
+    n = len(entire_arr)
+    avg_entire = float(np.mean(entire_arr)) if n > 0 else 0.0
+    avg_partial = float(np.mean(partial_arr)) if n > 0 else 0.0
+    print(f"[{label}] Entire  success: {avg_entire:.4f} ({avg_entire * 100:.1f}%) — {int(np.sum(entire_arr))}/{n}")
+    print(f"[{label}] Partial success: {avg_partial:.4f} ({avg_partial * 100:.1f}%) — {int(np.sum(partial_arr))}/{n}")
+
+
+def _run_fp_eval(args: argparse.Namespace) -> None:
+    if args.simplerenv_tasks_json:
+        tasks = _load_task_list(args.simplerenv_tasks_json)
+        print(f"[SimplerEnv-FP] Loaded {len(tasks)} tasks from {args.simplerenv_tasks_json}")
+    else:
+        tasks = [{}]
+
+    model_cache = {}
+    for i, task_dict in enumerate(tasks):
+        task_args, label = _build_task_args(args, task_dict, i)
+        _run_task(task_args, label, model_cache)
+
+
+def _run_simplerenv_fp_mode(args: argparse.Namespace) -> None:
+    _run_fp_eval(args)
+
+
+def _run_placeholder_mode(args: argparse.Namespace, mode: str, backend: str) -> None:
+    raise NotImplementedError(
+        f"{mode} with model_backend={backend} has been promoted to a first-class interface, "
+        "but this backend pair is not wired yet."
+    )
+
+
+def _run_simplerenv_mode(args: argparse.Namespace, mode: str, backend: str) -> None:
+    if backend != "openvla":
+        _run_placeholder_mode(args, mode, backend)
+        return
+
+    if mode == "simplerenv_fp":
+        _run_simplerenv_fp_mode(args)
+        return
+    if mode == "simplerenv_official":
+        _run_openvla_simplerenv_official_mode(args, backend)
+        return
+
+    _run_placeholder_mode(args, mode, backend)
+
+
+def _run_libero_mode(args: argparse.Namespace, mode: str, backend: str) -> None:
+    if mode == "libero_fp" and backend == "openvla":
+        _run_openvla_libero_fp_mode(args, backend)
+        return
+    if mode == "libero_fp" and backend == "openvla_oft":
+        _run_openvla_oft_libero_fp_mode(args, backend)
+        return
+    if mode == "libero_quant" and backend == "openvla_oft":
+        _run_openvla_oft_libero_quant_mode(args, backend)
+        return
+    _run_placeholder_mode(args, mode, backend)
+
+
+def _run_openvla_oft_mode(args: argparse.Namespace, mode: str, backend: str) -> None:
+    _run_placeholder_mode(args, mode, backend)
+
+
+def _dispatch_eval_mode(args: argparse.Namespace) -> None:
+    mode = _resolve_eval_mode(args)
+    backend = _resolve_model_backend(args)
+    print(f"[main_quant] eval_mode={mode} model_backend={backend}")
+
+    if mode.startswith("simplerenv_"):
+        _run_simplerenv_mode(args, mode, backend)
+        return
+    if mode.startswith("libero_"):
+        _run_libero_mode(args, mode, backend)
+        return
+
+    _run_placeholder_mode(args, mode, backend)
+
+
+def main() -> None:
+    base_args = _parse_args()
+    args_list = _apply_config_overrides(base_args)
+
+    for args in args_list:
+        _dispatch_eval_mode(args)
+
+
+if __name__ == "__main__":
+    main()
