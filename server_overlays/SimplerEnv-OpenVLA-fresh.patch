+def _normalize_eval_results(eval_results: Any) -> Tuple[np.ndarray, np.ndarray]:
+    if isinstance(eval_results, dict) and "entire" in eval_results and "partial" in eval_results:
+        entire = np.asarray(eval_results["entire"], dtype=np.float32)
+        partial = np.asarray(eval_results["partial"], dtype=np.float32)
+        return entire, partial
+
+    arr = np.asarray(eval_results, dtype=np.float32)
+    return arr, arr
+
