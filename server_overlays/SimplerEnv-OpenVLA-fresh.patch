+def _apply_config_overrides(args: argparse.Namespace) -> list[argparse.Namespace]:
+    if not args.config:
+        return [args]
+
+    try:
+        import yaml
+    except ModuleNotFoundError as exc:
+        raise RuntimeError("--config requires PyYAML, which is not installed in this environment.") from exc
+
+    config_path = Path(args.config)
+    if not config_path.exists():
+        raise FileNotFoundError(f"Config file does not exist: {config_path}")
+
+    payload = yaml.safe_load(config_path.read_text())
+    items = payload if isinstance(payload, list) else [payload]
+
+    merged: list[argparse.Namespace] = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError("--config must contain a dict or a list of dicts")
+        cfg_args = copy.deepcopy(args)
+        for key, value in item.items():
+            if not hasattr(cfg_args, key):
+                raise ValueError(f"Unknown key in config: {key}")
+            setattr(cfg_args, key, value)
+        merged.append(cfg_args)
+    return merged
+
+
+def _load_task_list(task_json_path: str) -> list[dict]:
+    with open(task_json_path, "r", encoding="utf-8") as f:
+        payload = json.load(f)
+    if not isinstance(payload, list):
+        raise ValueError("--simplerenv_tasks_json must point to a JSON list")
+    if len(payload) == 0:
+        raise ValueError("--simplerenv_tasks_json contains an empty task list")
+    for i, item in enumerate(payload):
+        if not isinstance(item, dict):
+            raise ValueError(f"Task entry #{i} must be an object/dict")
+    return payload
+
+
+def _build_task_args(base_args: argparse.Namespace, task_dict: dict, idx: int) -> tuple[argparse.Namespace, str]:
+    args_i = copy.deepcopy(base_args)
+    label = str(task_dict.get("result_label", f"SimplerEnv FP Evaluation #{idx + 1}"))
+
+    blocked_keys = {"simplerenv_tasks_json", "policy_model", "result_label"}
+    for key, value in task_dict.items():
+        if key in blocked_keys:
+            continue
+        if not hasattr(args_i, key):
+            raise ValueError(f"Unknown task key in --simplerenv_tasks_json: {key}")
+        setattr(args_i, key, value)
+
+    return args_i, label
+
