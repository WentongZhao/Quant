+    else:
+        prompt_inputs, prompt_kwargs = calib_out
+
+    vla = oft.qwrapper(
+        vla,
+        prompt_inputs,
+        prompt_kwargs,
+        args,
+        action_head=action_head,
+        grad_loss_type="l1_regression",
+    )
+    if args.method == "ostquant":
+        if oft.patch_action_head_unrotate_r_res is None:
+            raise ImportError("ostquant is not available in this repo, but patch_action_head_unrotate_r_res was called")
+        oft.patch_action_head_unrotate_r_res(action_head, vla_model=vla)
+
+    if args.eval_libero:
