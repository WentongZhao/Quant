+detect_model_feature_flags() {
+    USE_L1_REGRESSION=0
+    USE_PROPRIO=0
+    NUM_IMAGES="${NUM_IMAGES:-1}"
+
+    if find "${MODEL_PATH}" -maxdepth 1 -type f -name 'action_head*checkpoint*' | grep -q .; then
+        USE_L1_REGRESSION=1
+        NUM_IMAGES="${NUM_IMAGES_OVERRIDE:-2}"
+    fi
+
+    if find "${MODEL_PATH}" -maxdepth 1 -type f -name 'proprio_projector*checkpoint*' | grep -q .; then
+        USE_PROPRIO=1
+        NUM_IMAGES="${NUM_IMAGES_OVERRIDE:-2}"
+    fi
+
+    echo "[INFO] Model feature detection: USE_L1_REGRESSION=${USE_L1_REGRESSION}, USE_PROPRIO=${USE_PROPRIO}, NUM_IMAGES=${NUM_IMAGES}"
