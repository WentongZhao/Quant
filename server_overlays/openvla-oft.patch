+
+# logs & scales on data disk
+LOG_BASE="${PROJECT_DIR}/smoothquant_logs/libero_10"
+SCALE_BASE="${PROJECT_DIR}/smoothquant_scales/libero_10"
+
+# ====== GPU ======
+export CUDA_VISIBLE_DEVICES=0
+
+# ====== Calib ======
+CALIB_SAMPLING=proprio_stratified
+CALIB_TAG=proprio_stratified
+N_SAMPLES=256
+SEED=7
+
+# ====== SmoothQuant ======
+SQ_ALPHA=0.5
+SQ_SCALE_MODE=max
+
+mkdir -p "$LOG_BASE" "$SCALE_BASE"
