+run_fp_eval() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local eval_args=()
+    local extra_args=()
+    local model_args=()
+    local eval_tag
+    local task_label
+    local log_file
+    eval_tag="$(get_eval_tag)"
+    task_label="${CURRENT_TASK_LABEL:-$(sanitize_tag "${ENV_NAME}")}"
+
+    apply_fast_dev_overrides
+
+    build_eval_args "${task}" eval_args
+    build_model_args model_args
+    if [[ "${EVAL_BACKEND}" == "simplerenv" ]]; then
+        extra_args+=(--fp_simplerenv_only)
+    fi
+
+    if should_batch_fp_eval; then
+        echo "[INFO] Queue FP task for batch eval: ${task_label}"
+        enqueue_fp_eval_task "${task}" "${model}" "${data}" "${task_label}"
+        return 0
+    fi
+
+    mkdir -p "${LOG_BASE}/${OUTPUT_TAG}"
+    log_file="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_${eval_tag}.log"
+
+    echo "[INFO] Eval config: policy_setup=${POLICY_SETUP}, robot=${ROBOT}, env=${ENV_NAME}, scene=${SCENE_NAME}"
+    echo "[INFO] Eval config: robot_init_xs=${ROBOT_INIT_XS[*]}, robot_init_ys=${ROBOT_INIT_YS[*]}, robot_init_quats=${ROBOT_INIT_QUATS[*]}"
+    echo "[INFO] Eval config: obj_variation_mode=${OBJ_VARIATION_MODE}, obj_init_xs=${OBJ_INIT_XS[*]:-}, obj_init_ys=${OBJ_INIT_YS[*]:-}, obj_episode_range=[${OBJ_EPISODE_START}, ${OBJ_EPISODE_END}), unnorm_key=${UNNORM_KEY}, num_images=${NUM_IMAGES}"
+    echo "[INFO] Eval config: overlay=${RGB_OVERLAY_PATH:-None}, raytracing=${ENABLE_RAYTRACING}, additional_kwargs=${ADDITIONAL_ENV_BUILD_KWARGS[*]:-None}"
+
+    echo "[INFO] Running FP baseline eval for ${task} with backend=${EVAL_BACKEND} ..."
+    python3 main_quant.py \
+        --model "${model}" \
+        --data "${data}" \
+        "${model_args[@]}" \
+        "${eval_args[@]}" \
+        "${extra_args[@]}" \
+        --seed "${SEED}" \
+        --deterministic \
+        |& tee "${log_file}"
+
+    append_task_summary "${task_label}" "fp" "-" "${log_file}"
+}
+
+run_one_setting() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local w_bit="$4"
+    local a_bit="$5"
+    local cfg_tag="w${w_bit}a${a_bit}kv16"
+    local eval_args=()
+    local model_args=()
+    local eval_tag
+    local task_label
+    local eval_log_file
+    eval_tag="$(get_eval_tag)"
+    task_label="${CURRENT_TASK_LABEL:-$(sanitize_tag "${ENV_NAME}")}"
+
+    apply_fast_dev_overrides
+
+    build_eval_args "${task}" eval_args
+    build_model_args model_args
+
+    local scale_dir="${SCALE_BASE}/${OUTPUT_TAG}/${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}"
+    mkdir -p "${scale_dir}" "${LOG_BASE}/${OUTPUT_TAG}"
+
+    # 1) 生成 scale（若已存在则复用，避免多任务重复校准）
+    if [[ -f "${scale_dir}/scale.pt" ]]; then
+        echo "[INFO] Reusing existing scale: ${scale_dir}/scale.pt"
+    else
+        echo "[INFO] Generating scale for ${task} ${cfg_tag} ..."
+        python3 main_quant.py \
+            --model "${model}" \
+            --data "${data}" \
+            "${model_args[@]}" \
+            --method smoothquant \
+            --alpha "${SQ_ALPHA}" \
+            --sq_scale_mode "${SQ_SCALE_MODE}" \
+            --w_bit "${w_bit}" --a_bit "${a_bit}" \
+            --scale_path "${scale_dir}/scale.pt" \
+            --run_process \
+            --deterministic \
+            --calib_sampling "${CALIB_SAMPLING}" \
+            --calib_prompt_balance \
+            --n_samples "${N_SAMPLES}" \
+            --task_suite_name "${task}" \
+            --seed "${SEED}" \
+            |& tee "${LOG_BASE}/${OUTPUT_TAG}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_scale.log"
+    fi
+
+    # 2) pseudo quant + eval
+    echo "[INFO] Running pseudo-quant eval for ${task} ${cfg_tag} ..."
+    eval_log_file="${LOG_BASE}/${OUTPUT_TAG}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_eval_${eval_tag}.log"
+    python3 main_quant.py \
+        --model "${model}" \
+        --data "${data}" \
+        "${model_args[@]}" \
+        --method smoothquant \
+        --alpha "${SQ_ALPHA}" \
+        --sq_scale_mode "${SQ_SCALE_MODE}" \
+        --w_bit "${w_bit}" --a_bit "${a_bit}" \
+        --scale_path "${scale_dir}/scale.pt" \
+        --pseudo_quant \
+        --deterministic \
+        --calib_sampling "${CALIB_SAMPLING}" \
+        --calib_prompt_balance \
+        --n_samples "${N_SAMPLES}" \
+        "${eval_args[@]}" \
+        --seed "${SEED}" \
+        |& tee "${eval_log_file}"
+
+    append_task_summary "${task_label}" "quant" "${cfg_tag}" "${eval_log_file}"
+}
+
+run_quant_suite() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+
+    run_one_setting "${task}" "${model}" "${data}" 4 4
+    run_one_setting "${task}" "${model}" "${data}" 8 8
+}
+
+run_suite() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+
+    case "${MODE}" in
+        fp)
+            run_fp_eval "${task}" "${model}" "${data}"
+            ;;
+        quant)
+            run_quant_suite "${task}" "${model}" "${data}"
+            ;;
+        all)
+            run_fp_eval "${task}" "${model}" "${data}"
+            run_quant_suite "${task}" "${model}" "${data}"
+            ;;
+        *)
+            echo "[ERROR] Unknown MODE=${MODE}. Use fp / quant / all"
+            exit 1
+            ;;
+    esac
+}
