+                    if int(getattr(task_args, "sticky_gripper_num_repeat", -1)) <= 0:
+                        task_args.sticky_gripper_num_repeat = auto_sticky
+                resolved_key = _resolve_oft_unnorm_key(
+                    getattr(task_args, "unnorm_key", None),
+                    available_unnorm_keys,
+                    getattr(task_args, "policy_setup", None),
+                )
+                if resolved_key != getattr(task_args, "unnorm_key", None):
+                    print(
+                        f"[main_quant] {label}: remap unnorm_key "
+                        f"{getattr(task_args, 'unnorm_key', None)!r} -> {resolved_key!r}"
+                    )
+                task_args.unnorm_key = resolved_key
+            if getattr(task_args, "unnorm_key", None):
+                cfg.unnorm_key = task_args.unnorm_key
+            if getattr(task_args, "task_suite_name", None):
+                cfg.task_suite_name = task_args.task_suite_name
+            if hasattr(shared_model, "set_task_runtime"):
+                shared_model.set_task_runtime(
+                    policy_setup=task_args.policy_setup,
+                    action_scale=task_args.action_scale,
+                    unnorm_key=getattr(task_args, "unnorm_key", None),
+                    num_images=getattr(task_args, "num_images", None),
+                    use_proprio=getattr(task_args, "use_proprio", None),
+                    action_xyz_scale=getattr(task_args, "action_xyz_scale", None),
+                    action_rot_scale=getattr(task_args, "action_rot_scale", None),
+                    gripper_delta_scale=getattr(task_args, "gripper_delta_scale", None),
+                    gripper_deadzone=getattr(task_args, "gripper_deadzone", None),
+                    sticky_gripper_num_repeat=getattr(task_args, "sticky_gripper_num_repeat", None),
+                )
+            _run_simplerenv_eval(
+                args=task_args,
+                cfg=cfg,
+                vla=vla,
+                processor=processor,
+                action_head=action_head,
+                proprio_projector=proprio_projector,
+                result_label=label,
+                ckpt_fallback=ckpt_fallback,
+                policy_model_fallback=policy_model_fallback,
+                shared_model=shared_model,
+            )
+        return
+
+    # --- Optional pre-eval (float, before quantization) ---
+    if args.method == "ostquant" and bool(getattr(args, "pre_eval", False)) and args.eval_libero:
+        import torch.distributed as dist
+
+        if (not dist.is_available()) or (not dist.is_initialized()) or dist.get_rank() == 0:
+            oft.validate_config(cfg)
+            oft.set_seed_everywhere(cfg.seed)
+            resize_size = oft.get_image_resize_size(cfg)
+            noisy_action_projector = None
+            if cfg.use_diffusion:
+                noisy_action_projector = oft.get_noisy_action_projector(cfg, vla.llm_dim)
+            log_file, _, _ = oft.setup_logging(cfg)
+            benchmark_dict = oft.benchmark.get_benchmark_dict()
+            task_suite = benchmark_dict[cfg.task_suite_name]()
+            num_tasks = task_suite.n_tasks
+            total_episodes, total_successes = 0, 0
+            for task_id in tqdm.tqdm(range(num_tasks)):
+                total_episodes, total_successes = oft.run_task(
+                    cfg,
+                    task_suite,
+                    task_id,
+                    vla,
+                    resize_size,
+                    processor,
+                    action_head,
+                    proprio_projector,
+                    noisy_action_projector,
+                    total_episodes,
+                    total_successes,
+                    log_file,
+                )
+            final_success_rate = float(total_successes) / float(total_episodes) if total_episodes > 0 else 0
+            print(
+                f"[Float Eval] Total episodes: {total_episodes}, successes: {total_successes}, "
+                f"success_rate: {final_success_rate:.4f} ({final_success_rate*100:.1f}%)"
+            )
+            if log_file:
+                log_file.close()
+
+    calib_return_mode = "embeds"
+    if args.method == "smoothquant" and args.sq_target == "vision":
+        calib_return_mode = "raw"
+
+    calib_out = oft.get_libero_calib_dataset(
+        data_path=args.data,
+        model=vla,
+        processor=processor,
+        proprio_projector=proprio_projector,
+        n_samples=args.n_samples,
+        rotate=args.rotate_images,
+        shuffle=not args.deterministic,
+        unnorm_key=args.unnorm_key,
+        seed=args.seed,
+        calib_sampling=args.calib_sampling,
+        calib_prompt_balance=args.calib_prompt_balance,
+        return_mode=calib_return_mode,
+        return_debug=bool(args.calib_print_selection),
+    )
+
+    if bool(args.calib_print_selection):
