+build_eval_args() {
+    local task="$1"
+    local -n out_args_ref="$2"
+
+    case "${EVAL_BACKEND}" in
+        libero)
+            out_args_ref=(
+                --eval_libero
+                --task_suite_name "${task}"
+                --num_trials_per_task 50
+            )
+            ;;
+        simplerenv)
+            if [[ -z "${ENV_NAME}" ]]; then
+                echo "[ERROR] ENV_NAME must be set when EVAL_BACKEND=simplerenv"
+                exit 1
+            fi
+            out_args_ref=(
+                --num_images "${NUM_IMAGES}"
+                --eval_simplerenv
+                --task_suite_name "${task}"
+                --unnorm_key "${UNNORM_KEY}"
+                --policy_setup "${POLICY_SETUP}"
+                --action_scale "${ACTION_SCALE}"
+                --robot "${ROBOT}"
+                --env_name "${ENV_NAME}"
+                --scene_name "${SCENE_NAME}"
+                --robot_init_xs "${ROBOT_INIT_XS[@]}"
+                --robot_init_ys "${ROBOT_INIT_YS[@]}"
+                --robot_init_quats "${ROBOT_INIT_QUATS[@]}"
+                --control_freq "${CONTROL_FREQ}"
+                --sim_freq "${SIM_FREQ}"
+                --max_episode_steps "${MAX_EPISODE_STEPS}"
+                --logging_dir "${LOGGING_DIR}"
+            )
+
+            if [[ -n "${RGB_OVERLAY_PATH}" ]]; then
+                out_args_ref+=(--rgb_overlay_path "${RGB_OVERLAY_PATH}")
+            fi
+
+            if [[ -n "${OBS_CAMERA_NAME}" ]]; then
+                out_args_ref+=(--obs_camera_name "${OBS_CAMERA_NAME}")
+            fi
+
+            if [[ "${ENABLE_RAYTRACING}" == "1" ]]; then
+                out_args_ref+=(--enable_raytracing)
+            fi
+
+            if [[ -n "${ADDITIONAL_ENV_SAVE_TAGS}" ]]; then
+                out_args_ref+=(--additional_env_save_tags "${ADDITIONAL_ENV_SAVE_TAGS}")
+            fi
+
+            if [[ "${#ADDITIONAL_ENV_BUILD_KWARGS[@]}" -gt 0 ]]; then
+                out_args_ref+=(--additional_env_build_kwargs "${ADDITIONAL_ENV_BUILD_KWARGS[@]}")
+            fi
+
+            out_args_ref+=(--obj_variation_mode "${OBJ_VARIATION_MODE}")
+            if [[ "${OBJ_VARIATION_MODE}" == "xy" ]]; then
+                out_args_ref+=(--obj_init_xs "${OBJ_INIT_XS[@]}" --obj_init_ys "${OBJ_INIT_YS[@]}")
+            else
+                out_args_ref+=(--obj_episode_range "${OBJ_EPISODE_START}" "${OBJ_EPISODE_END}")
+            fi
+            ;;
+        *)
+            echo "[ERROR] Unknown EVAL_BACKEND=${EVAL_BACKEND}. Use libero / simplerenv"
+            exit 1
+            ;;
+    esac
+}
