+#!/usr/bin/env bash
+set -euo pipefail
+
+# Minimal OpenVLA-OFT LIBERO eval launcher (single suite, minimal defaults).
+# Usage:
+#   TASK_SUITE_NAME=libero_spatial NUM_TRIALS_PER_TASK=1 \
+#   bash scripts/eval_libero_oft_minimal_fresh.sh
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "${ROOT_DIR}"
+
+export TOKENIZERS_PARALLELISM=false
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-7}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
+export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
+export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
+# Keep LIBERO path config isolated from other conda envs.
+export LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${ROOT_DIR}/.libero}"
+
+TASK_SUITE_NAME="${TASK_SUITE_NAME:-libero_spatial}"    # libero_spatial|libero_object|libero_goal|libero_10
+NUM_TRIALS_PER_TASK="${NUM_TRIALS_PER_TASK:-1}"
+TASK_ID_START="${TASK_ID_START:-0}"
+NUM_TASKS_TO_EVAL="${NUM_TASKS_TO_EVAL:--1}"
+SEED="${SEED:-7}"
+USE_WANDB="${USE_WANDB:-False}"
+CENTER_CROP="${CENTER_CROP:-True}"
+LOAD_IN_8BIT="${LOAD_IN_8BIT:-False}"
+LOAD_IN_4BIT="${LOAD_IN_4BIT:-False}"
+LOCAL_LOG_DIR="${LOCAL_LOG_DIR:-${ROOT_DIR}/experiments/logs}"
+MODEL_ROOT="${MODEL_ROOT:-/data5/cgk_lyy_0/models}"
+PRETRAINED_CHECKPOINT="${PRETRAINED_CHECKPOINT:-}"
+MIN_FREE_GB="${MIN_FREE_GB:-8}"
+
+if [[ "${LOAD_IN_8BIT}" == "True" && "${LOAD_IN_4BIT}" == "True" ]]; then
+    echo "[ERROR] LOAD_IN_8BIT and LOAD_IN_4BIT cannot both be True."
+    exit 1
+fi
+
+resolve_checkpoint() {
+    if [[ -n "${PRETRAINED_CHECKPOINT}" ]]; then
+        echo "${PRETRAINED_CHECKPOINT}"
+        return 0
+    fi
+
+    case "${TASK_SUITE_NAME}" in
+        libero_spatial) echo "${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-spatial" ;;
+        libero_object) echo "${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-object" ;;
+        libero_goal) echo "${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-goal" ;;
+        libero_10) echo "${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-10" ;;
+        *)
+            echo "[ERROR] Unsupported TASK_SUITE_NAME: ${TASK_SUITE_NAME}"
+            echo "[HINT] Use one of: libero_spatial, libero_object, libero_goal, libero_10"
+            exit 1
+            ;;
+    esac
+}
+
+CHECKPOINT="$(resolve_checkpoint)"
+
+if [[ "${HF_HUB_OFFLINE}" != "0" && "${HF_HUB_OFFLINE}" != "false" && ! -d "${CHECKPOINT}" ]]; then
+    echo "[ERROR] Offline mode is enabled but CHECKPOINT is not a local directory: ${CHECKPOINT}"
+    echo "[HINT] Set PRETRAINED_CHECKPOINT to a local path, or set HF_HUB_OFFLINE=0 to allow download."
+    exit 1
+fi
+
+prepare_libero_config() {
+    python - <<'PY'
+import os
+from pathlib import Path
+import libero
+
+benchmark_root = (Path(libero.__file__).resolve().parent / "libero").resolve()
+required = [
+    benchmark_root / "bddl_files",
+    benchmark_root / "init_files",
+    benchmark_root / "assets",
+]
+for p in required:
+    if not p.exists():
+        raise SystemExit(f"[ERROR] LIBERO required path missing: {p}")
+
+cfg_dir = Path(os.environ["LIBERO_CONFIG_PATH"]).expanduser()
+cfg_dir.mkdir(parents=True, exist_ok=True)
+cfg_path = cfg_dir / "config.yaml"
+
+path_map = {
+    "benchmark_root": benchmark_root,
+    "bddl_files": benchmark_root / "bddl_files",
+    "init_states": benchmark_root / "init_files",
+    "datasets": (benchmark_root / "../datasets").resolve(),
+    "assets": benchmark_root / "assets",
+}
+with open(cfg_path, "w", encoding="utf-8") as f:
+    for key in ["benchmark_root", "bddl_files", "init_states", "datasets", "assets"]:
+        f.write(f"{key}: {path_map[key]}\n")
+
+print(f"[INFO] LIBERO import ok: {libero.__file__}")
+print(f"[INFO] LIBERO benchmark_root: {benchmark_root}")
+print(f"[INFO] LIBERO config: {cfg_path}")
+PY
+}
+
+check_cuda() {
+    python - <<'PY'
+import os
+import torch
+
+print(f"[INFO] torch={torch.__version__}, cuda={torch.version.cuda}, cuda_available={torch.cuda.is_available()}")
+if not torch.cuda.is_available():
+    raise SystemExit("[ERROR] CUDA is not available in current environment.")
+
+free_bytes, total_bytes = torch.cuda.mem_get_info(0)
+free_gb = free_bytes / (1024 ** 3)
+total_gb = total_bytes / (1024 ** 3)
+min_free_gb = float(os.getenv("MIN_FREE_GB", "8"))
+print(f"[INFO] GPU0 free={free_gb:.2f} GiB / total={total_gb:.2f} GiB (MIN_FREE_GB={min_free_gb:.2f})")
+if free_gb < min_free_gb:
+    raise SystemExit(
+        f"[ERROR] Free VRAM too low ({free_gb:.2f} GiB < {min_free_gb:.2f} GiB). "
+        "Please stop other GPU jobs or lower memory settings."
+    )
+PY
+}
+
+echo "[INFO] ROOT_DIR=${ROOT_DIR}"
+echo "[INFO] TASK_SUITE_NAME=${TASK_SUITE_NAME}, TASK_ID_START=${TASK_ID_START}, NUM_TASKS_TO_EVAL=${NUM_TASKS_TO_EVAL}"
+echo "[INFO] NUM_TRIALS_PER_TASK=${NUM_TRIALS_PER_TASK}, SEED=${SEED}"
+echo "[INFO] CHECKPOINT=${CHECKPOINT}"
+echo "[INFO] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
+echo "[INFO] LOAD_IN_8BIT=${LOAD_IN_8BIT}, LOAD_IN_4BIT=${LOAD_IN_4BIT}"
+echo "[INFO] HF_HUB_OFFLINE=${HF_HUB_OFFLINE}, TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE}, HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE}"
+echo "[INFO] LIBERO_CONFIG_PATH=${LIBERO_CONFIG_PATH}"
+
+prepare_libero_config
+check_cuda
+
+python experiments/robot/libero/run_libero_eval.py \
+    --pretrained_checkpoint "${CHECKPOINT}" \
+    --task_suite_name "${TASK_SUITE_NAME}" \
+    --num_trials_per_task "${NUM_TRIALS_PER_TASK}" \
+    --task_id_start "${TASK_ID_START}" \
+    --num_tasks_to_eval "${NUM_TASKS_TO_EVAL}" \
+    --seed "${SEED}" \
+    --center_crop "${CENTER_CROP}" \
+    --use_wandb "${USE_WANDB}" \
+    --load_in_8bit "${LOAD_IN_8BIT}" \
+    --load_in_4bit "${LOAD_IN_4BIT}" \
+    --local_log_dir "${LOCAL_LOG_DIR}" \
+    --run_id_note "minimal_fresh_${TASK_SUITE_NAME}"
