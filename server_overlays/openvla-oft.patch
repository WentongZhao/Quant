+    if [[ "${USE_L1_REGRESSION}" == "1" ]]; then
+        out_args_ref+=(--use_l1_regression)
+    fi
+
+    if [[ "${USE_PROPRIO}" == "1" ]]; then
+        out_args_ref+=(--use_proprio)
