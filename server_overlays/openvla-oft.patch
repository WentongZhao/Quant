+def _autotune_openvla_oft_simplerenv_fp_args(args: argparse.Namespace) -> None:
+    """Apply safer defaults for OFT SimplerEnv-FP evaluation."""
+    if str(getattr(args, "model_backend", "")) != "openvla_oft":
+        return
+    if not bool(getattr(args, "fp_simplerenv_only", False)) or not bool(getattr(args, "eval_simplerenv", False)):
+        return
+
+    if not bool(getattr(args, "use_l1_regression", False)):
+        args.use_l1_regression = True
+        print("[main_quant] auto-set --use_l1_regression=True for openvla_oft SimplerEnv FP.")
+    if not bool(getattr(args, "use_proprio", False)):
+        args.use_proprio = True
+        print("[main_quant] auto-set --use_proprio=True for openvla_oft SimplerEnv FP.")
+    if int(getattr(args, "num_images", 1)) < 2:
+        args.num_images = 2
+        print("[main_quant] auto-set --num_images=2 for openvla_oft SimplerEnv FP.")
+
+
+def _resolve_oft_unnorm_key(
+    requested: str | None,
+    available_keys: set[str],
+    policy_setup: str | None,
+) -> str:
+    if requested and requested in available_keys:
+        return requested
+
+    preferred: list[str] = []
+    if policy_setup == "widowx_bridge":
+        preferred.extend(
+            [
+                "libero_spatial_no_noops",
+                "libero_object_no_noops",
+                "libero_goal_no_noops",
+                "libero_10_no_noops",
+            ]
+        )
+    else:
+        preferred.extend(
+            [
+                "libero_10_no_noops",
+                "libero_goal_no_noops",
+                "libero_object_no_noops",
+                "libero_spatial_no_noops",
+            ]
+        )
+    for key in preferred:
+        if key in available_keys:
+            return key
+    if len(available_keys) == 0:
+        return requested or ""
+    return sorted(available_keys)[0]
+
