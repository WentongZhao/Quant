+    "C1,0.765,0.222,c1,0.0125,0.0,0.0,0.999922"
+    "C2,0.865,0.222,c2,0.0125,0.0,0.0,0.999922"
+)
+
+# Apple-Drawer Visual Matching 3 个位置 (A0, B0, C0)
+APPLE_DRAWER_VM_POSITIONS=(
+    "A0,0.644,-0.179,a0,0.015,0.0,0.0,0.999888"
+    "B0,0.652,0.009,b0,0.0,0.0,0.0,1.0"
+    "C0,0.665,0.224,c0,0.0,0.0,0.0,1.0"
