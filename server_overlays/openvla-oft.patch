+def _set_reproducibility(seed: int) -> None:
+    import random as _py_random
+
+    _py_random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
