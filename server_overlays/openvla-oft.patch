+cd "$PROJECT_DIR"
+
+run_one() {
+  local w_bit="$1"
+  local a_bit="$2"
+  local cfg_tag="w${w_bit}a${a_bit}kv16"
+  local scale_dir="${SCALE_BASE}/${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}"
+  mkdir -p "$scale_dir"
+
+  # 1) build scales
+  python3 main_quant.py \
+    --model "$MODEL_DIR" \
+    --data "$DATA_DIR" \
+    --method smoothquant \
+    --alpha "$SQ_ALPHA" \
+    --sq_scale_mode "$SQ_SCALE_MODE" \
+    --w_bit "$w_bit" --a_bit "$a_bit" --k_bit 16 --v_bit 16 \
+    --scale_path "${scale_dir}/scale.pt" \
+    --run_process \
+    --deterministic \
+    # --calib_sampling "$CALIB_SAMPLING" \
+    # --use_l1_regression \
+    --calib_prompt_balance \
+    --n_samples "$N_SAMPLES" \
+    --omni_batch_size 1 \
+    --task_suite_name libero_10 \
+    --seed "$SEED" |& tee "${LOG_BASE}/smoothquant_${cfg_tag}_alpha${SQ_ALPHA}_${CALIB_TAG}_${N_SAMPLES}_scale.log"
+
+  # 2) eval
+  python3 main_quant.py \
+    --model "$MODEL_DIR" \
+    --data "$DATA_DIR" \
+    --method smoothquant \
+    --alpha "$SQ_ALPHA" \
+    --sq_scale_mode "$SQ_SCALE_MODE" \
