@@ -0,0 +1,429 @@
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Dict, Optional, Sequence
+import warnings
+
+import matplotlib.pyplot as plt
+import numpy as np
+import torch
+from PIL import Image
+from transforms3d.euler import euler2axangle
+
+from .runtime import ensure_oft_on_path
+
+try:
+    ensure_oft_on_path()
+    from prismatic.vla.constants import NUM_ACTIONS_CHUNK
+except Exception:
+    NUM_ACTIONS_CHUNK = 1
+
+
+_OPENVLA_PREPROCESS_IMPORTED = False
+_OPENVLA_PREPROCESS_FNS = None
+
+
+def _get_openvla_preprocess_fns():
+    global _OPENVLA_PREPROCESS_IMPORTED, _OPENVLA_PREPROCESS_FNS
+    if not _OPENVLA_PREPROCESS_IMPORTED:
+        _OPENVLA_PREPROCESS_IMPORTED = True
+        try:
+            ensure_oft_on_path()
+            from experiments.robot.openvla_utils import normalize_proprio, prepare_images_for_vla
+
+            _OPENVLA_PREPROCESS_FNS = {
+                "prepare_images_for_vla": prepare_images_for_vla,
+                "normalize_proprio": normalize_proprio,
+            }
+        except Exception:
+            _OPENVLA_PREPROCESS_FNS = None
+    return _OPENVLA_PREPROCESS_FNS
+
+
+def _fallback_prepare_images_for_vla(images: Sequence[np.ndarray]) -> Sequence[Image.Image]:
+    processed = []
+    for image in images:
+        if image.dtype != np.uint8:
+            image = np.clip(image, 0, 255).astype(np.uint8)
+        processed.append(Image.fromarray(image).convert("RGB"))
+    return processed
+
+
+class OpenVLAOFTInference:
+    def __init__(
+        self,
+        vla,
+        processor,
+        cfg,
+        action_head=None,
+        proprio_projector=None,
+        noisy_action_projector=None,
+        policy_setup: str = "google_robot",
+        action_scale: float = 1.0,
+        chunk_size: int = NUM_ACTIONS_CHUNK,
+    ):
+        self.vla = vla
+        self.processor = processor
+        self.cfg = cfg
+        self.action_head = action_head
+        self.proprio_projector = proprio_projector
+        self.noisy_action_projector = noisy_action_projector
+        self.policy_setup = policy_setup
+        self.action_scale = action_scale
+        self.chunk_size = chunk_size
+        self.device = torch.device("cuda", torch.cuda.current_device()) if torch.cuda.is_available() else torch.device("cpu")
+
+        self.task_description = None
+        self.action_deque = deque(maxlen=self.chunk_size)
+        self.sticky_action_is_on = False
+        self.gripper_action_repeat = 0
+        self.sticky_gripper_action = 0.0
+        self.previous_gripper_action = None
+        self.action_xyz_scale = 1.0
+        self.action_rot_scale = 1.0
+        self.gripper_delta_scale = 1.0
+        self.gripper_deadzone = 0.5
+        self._warned_missing_aux_views = False
+        self._warned_missing_openvla_preprocess = False
+        self._warned_missing_proprio_preprocess = False
+        self._warned_proprio_dim_mismatch = False
+
+        self._is_base_model = (
+            action_head is None
+            and not getattr(cfg, "use_l1_regression", False)
+            and not getattr(cfg, "use_diffusion", False)
+        )
+        self.set_task_runtime(policy_setup=policy_setup, action_scale=action_scale)
+
+    def set_task_runtime(
+        self,
+        *,
+        policy_setup: str,
+        action_scale: float,
+        unnorm_key: str | None = None,
+        num_images: int | None = None,
+        use_proprio: bool | None = None,
+        action_xyz_scale: float | None = None,
+        action_rot_scale: float | None = None,
+        gripper_delta_scale: float | None = None,
+        gripper_deadzone: float | None = None,
+        sticky_gripper_num_repeat: int | None = None,
+    ) -> None:
+        self.policy_setup = policy_setup
+        self.action_scale = float(action_scale)
+        self.sticky_gripper_num_repeat = 15 if policy_setup == "google_robot" else 1
+        if sticky_gripper_num_repeat is not None and int(sticky_gripper_num_repeat) > 0:
+            self.sticky_gripper_num_repeat = int(sticky_gripper_num_repeat)
+        if unnorm_key:
+            self.cfg.unnorm_key = unnorm_key
+        if num_images is not None:
+            self.cfg.num_images_in_input = int(num_images)
+        if use_proprio is not None:
+            self.cfg.use_proprio = bool(use_proprio)
+        if action_xyz_scale is not None:
+            self.action_xyz_scale = float(action_xyz_scale)
+        if action_rot_scale is not None:
+            self.action_rot_scale = float(action_rot_scale)
+        if gripper_delta_scale is not None:
+            self.gripper_delta_scale = float(gripper_delta_scale)
+        if gripper_deadzone is not None:
+            self.gripper_deadzone = float(gripper_deadzone)
+
+    def reset(self, task_description: str) -> None:
+        self.task_description = task_description
+        self.action_deque.clear()
+        self.sticky_action_is_on = False
+        self.gripper_action_repeat = 0
+        self.sticky_gripper_action = 0.0
+        self.previous_gripper_action = None
+
+    @staticmethod
+    def _extract_proprio_from_obs(obs: Any) -> Optional[np.ndarray]:
+        if not isinstance(obs, dict):
+            return None
+        state = obs.get("state")
+        if isinstance(state, np.ndarray):
+            return state
+        agent_state = obs.get("agent")
+        if isinstance(agent_state, dict):
+            if isinstance(agent_state.get("state"), np.ndarray):
+                return agent_state["state"]
+            qpos = agent_state.get("qpos")
+            qvel = agent_state.get("qvel")
+            if isinstance(qpos, np.ndarray) and isinstance(qvel, np.ndarray):
+                return np.concatenate([qpos, qvel], axis=-1)
+            if isinstance(qpos, np.ndarray):
+                return qpos
+        for key in ("proprio", "proprioception"):
+            val = obs.get(key)
+            if isinstance(val, np.ndarray):
+                return val
+        return None
+
+    def _prepare_images_for_vla(self, images: Sequence[np.ndarray]) -> Sequence[Image.Image]:
+        preprocess_fns = _get_openvla_preprocess_fns()
+        if preprocess_fns is not None:
+            return list(preprocess_fns["prepare_images_for_vla"](list(images), self.cfg))
+        if not self._warned_missing_openvla_preprocess:
+            warnings.warn("OpenVLA preprocessing utilities are unavailable; using fallback PIL conversion only.")
+            self._warned_missing_openvla_preprocess = True
+        return _fallback_prepare_images_for_vla(images)
+
+    def _normalize_proprio(self, proprio: np.ndarray) -> np.ndarray:
+        preprocess_fns = _get_openvla_preprocess_fns()
+        if preprocess_fns is None:
+            if not self._warned_missing_proprio_preprocess:
+                warnings.warn("OpenVLA proprio preprocessing utilities are unavailable; passing raw proprio as-is.")
+                self._warned_missing_proprio_preprocess = True
+            return np.asarray(proprio, dtype=np.float32)
+
+        proprio_norm_stats = self.vla.norm_stats[self.cfg.unnorm_key]["proprio"]
+        proprio_arr = np.asarray(proprio, dtype=np.float32)
+
+        target_dim = None
+        for key in ("p01", "p99", "low", "high"):
+            if key in proprio_norm_stats:
+                try:
+                    target_dim = int(np.asarray(proprio_norm_stats[key], dtype=np.float32).shape[-1])
+                    break
+                except Exception:
+                    target_dim = None
+        if target_dim is None:
+            for _, value in proprio_norm_stats.items():
+                try:
+                    arr = np.asarray(value, dtype=np.float32)
+                except Exception:
+                    continue
+                if arr.ndim >= 1 and arr.size > 1:
+                    target_dim = int(arr.shape[-1])
+                    break
+
+        if target_dim is not None and proprio_arr.shape[-1] != target_dim:
+            if not self._warned_proprio_dim_mismatch:
+                warnings.warn(
+                    f"Proprio dim mismatch: got {proprio_arr.shape[-1]}, expected {target_dim}. "
+                    "Applying truncate/pad alignment."
+                )
+                self._warned_proprio_dim_mismatch = True
+            if proprio_arr.shape[-1] > target_dim:
+                proprio_arr = proprio_arr[..., :target_dim]
+            else:
+                pad = np.zeros((target_dim - proprio_arr.shape[-1],), dtype=np.float32)
+                proprio_arr = np.concatenate([proprio_arr, pad], axis=-1)
+
+        return preprocess_fns["normalize_proprio"](proprio_arr, proprio_norm_stats)
+
+    def _set_num_images_in_input(self, num_images: int) -> None:
+        vision_backbone = getattr(self.vla, "vision_backbone", None)
+        if vision_backbone is None:
+            return
+        set_num_images = getattr(vision_backbone, "set_num_images_in_input", None)
+        get_num_images = getattr(vision_backbone, "get_num_images_in_input", None)
+        if not callable(set_num_images):
+            return
+
+        current_num_images = None
+        if callable(get_num_images):
+            try:
+                current_num_images = int(get_num_images())
+            except Exception:
+                current_num_images = None
+        if current_num_images != num_images:
+            set_num_images(num_images)
+
+    def _collect_policy_images(
+        self,
+        primary_image: np.ndarray,
+        obs: Optional[dict] = None,
+        obs_camera_name: Optional[str] = None,
+    ) -> Sequence[np.ndarray]:
+        expected_num_images = max(int(getattr(self.cfg, "num_images_in_input", 1)), 1)
+        images = [primary_image]
+        if expected_num_images == 1:
+            return images
+
+        if isinstance(obs, dict):
+            obs_image_dict = obs.get("image")
+            if isinstance(obs_image_dict, dict):
+                preferred_aux, fallback_aux = [], []
+                for camera_name, camera_obs in obs_image_dict.items():
+                    if obs_camera_name is not None and camera_name == obs_camera_name:
+                        continue
+                    if not isinstance(camera_obs, dict):
+                        continue
+                    rgb = camera_obs.get("rgb")
+                    if not isinstance(rgb, np.ndarray):
+                        continue
+                    if rgb.shape == primary_image.shape and np.array_equal(rgb, primary_image):
+                        continue
+                    camera_name_l = str(camera_name).lower()
+                    if any(tag in camera_name_l for tag in ("wrist", "hand", "gripper")):
+                        preferred_aux.append(rgb)
+                    else:
+                        fallback_aux.append(rgb)
+                for rgb in preferred_aux + fallback_aux:
+                    if len(images) >= expected_num_images:
+                        break
+                    images.append(rgb)
+
+        if len(images) < expected_num_images and not self._warned_missing_aux_views:
+            warnings.warn(
+                f"Expected {expected_num_images} policy image views, but only found {len(images)}. "
+                "Proceeding with available views."
+            )
+            self._warned_missing_aux_views = True
+        return images
+
+    def step(self, image: np.ndarray, task_description: Optional[str] = None, *args, **kwargs):
+        if task_description is not None and task_description != self.task_description:
+            self.reset(task_description)
+        if len(self.action_deque) == 0:
+            self._generate_action_chunk(image, **kwargs)
+        raw_action = self.action_deque.popleft()
+        action = self._process_action(raw_action)
+        return raw_action, action
+
+    def _generate_action_chunk(self, image: np.ndarray, proprio: Optional[np.ndarray] = None, **kwargs) -> None:
+        if self.task_description is None:
+            raise RuntimeError("task_description must be set before calling step()")
+
+        with torch.inference_mode():
+            obs = kwargs.get("obs")
+            obs_camera_name = kwargs.get("obs_camera_name")
+            policy_images = self._collect_policy_images(image, obs=obs, obs_camera_name=obs_camera_name)
+            pil_images = list(self._prepare_images_for_vla(policy_images))
+            self._set_num_images_in_input(len(pil_images))
+
+            prompt = f"In: What action should the robot take to {self.task_description}?\nOut:"
+            inputs = self.processor(prompt, pil_images[0], return_tensors="pt")
+
+            if len(pil_images) > 1:
+                extra_inputs = [self.processor(prompt, extra_image, return_tensors="pt") for extra_image in pil_images[1:]]
+                inputs["pixel_values"] = torch.cat(
+                    [inputs["pixel_values"]] + [extra["pixel_values"] for extra in extra_inputs],
+                    dim=1,
+                )
+
+            if "pixel_values" in inputs:
+                inputs["pixel_values"] = inputs["pixel_values"].to(self.device, dtype=torch.bfloat16)
+            if "input_ids" in inputs:
+                inputs["input_ids"] = inputs["input_ids"].to(self.device)
+            if "attention_mask" in inputs:
+                inputs["attention_mask"] = inputs["attention_mask"].to(self.device)
+            if "token_type_ids" in inputs:
+                inputs["token_type_ids"] = inputs["token_type_ids"].to(self.device)
+
+            proprio_input = proprio
+            if self.cfg.use_proprio:
+                if proprio_input is None:
+                    proprio_input = self._extract_proprio_from_obs(obs)
+                if proprio_input is not None:
+                    proprio_input = self._normalize_proprio(proprio_input)
+                    proprio_input = torch.from_numpy(np.asarray(proprio_input, dtype=np.float32)).to(self.device)
+
+            # Keep attention_mask for newer OpenVLA checkpoints whose
+            # predict_action path explicitly expects it.
+
+            if self._is_base_model:
+                pred = self.vla.predict_action(**inputs, unnorm_key=self.cfg.unnorm_key, do_sample=False)
+            else:
+                pred = self.vla.predict_action(
+                    **inputs,
+                    unnorm_key=self.cfg.unnorm_key,
+                    do_sample=False,
+                    proprio=proprio_input,
+                    proprio_projector=self.proprio_projector if self.cfg.use_proprio else None,
+                    noisy_action_projector=self.noisy_action_projector if getattr(self.cfg, "use_diffusion", False) else None,
+                    action_head=self.action_head,
+                    use_film=getattr(self.cfg, "use_film", False),
+                )
+            action_chunk = pred[0] if isinstance(pred, tuple) else pred
+
+        if isinstance(action_chunk, torch.Tensor):
+            action_chunk = action_chunk.detach().cpu().numpy()
+        action_chunk = np.asarray(action_chunk)
+        if action_chunk.ndim == 1:
+            action_chunk = action_chunk[None, :]
+
+        for t in range(action_chunk.shape[0]):
+            self.action_deque.append(
+                {
+                    "world_vector": action_chunk[t, :3].astype(np.float32),
+                    "rotation_delta": action_chunk[t, 3:6].astype(np.float32),
+                    "open_gripper": action_chunk[t, 6:7].astype(np.float32),
+                }
+            )
+
+    def _process_action(self, raw_action: Dict[str, np.ndarray]) -> Dict[str, np.ndarray]:
+        action = {}
+        action["world_vector"] = raw_action["world_vector"] * self.action_scale * self.action_xyz_scale
+        roll, pitch, yaw = np.asarray(raw_action["rotation_delta"], dtype=np.float64)
+        action_rotation_ax, action_rotation_angle = euler2axangle(roll, pitch, yaw)
+        action["rot_axangle"] = (action_rotation_ax * action_rotation_angle) * self.action_scale * self.action_rot_scale
+
+        if self.policy_setup == "google_robot":
+            current_gripper_action = raw_action["open_gripper"][0]
+            if self.previous_gripper_action is None:
+                relative_gripper_action = 0.0
+            else:
+                relative_gripper_action = (
+                    float(self.previous_gripper_action) - float(current_gripper_action)
+                ) * self.gripper_delta_scale
+            self.previous_gripper_action = float(current_gripper_action)
+
+            if np.abs(relative_gripper_action) > self.gripper_deadzone and not self.sticky_action_is_on:
+                self.sticky_action_is_on = True
+                self.sticky_gripper_action = relative_gripper_action
+
+            if self.sticky_action_is_on:
+                self.gripper_action_repeat += 1
+                relative_gripper_action = float(self.sticky_gripper_action)
+
+            if self.gripper_action_repeat == self.sticky_gripper_num_repeat:
+                self.sticky_action_is_on = False
+                self.gripper_action_repeat = 0
+                self.sticky_gripper_action = 0.0
+
+            action["gripper"] = np.asarray([relative_gripper_action], dtype=np.float32)
+        else:
+            action["gripper"] = np.asarray([2.0 * (raw_action["open_gripper"][0] > 0.5) - 1.0], dtype=np.float32)
+
+        action["terminate_episode"] = np.array([0.0], dtype=np.float32)
+        return action
+
+    def visualize_epoch(self, predicted_actions: Sequence[Dict], images: Sequence[np.ndarray], save_path: Optional[str] = None) -> None:
+        if save_path is None:
+            return
+
+        import os
+
+        os.makedirs(os.path.dirname(save_path), exist_ok=True)
+        if len(predicted_actions) == 0:
+            plt.figure(figsize=(6, 3))
+            plt.title("No predicted actions")
+            plt.savefig(save_path)
+            plt.close()
+            return
+
+        action_labels = ["x", "y", "z", "roll", "pitch", "yaw", "gripper"]
+        action_series = np.asarray(
+            [np.concatenate([a["world_vector"], a["rotation_delta"], a["open_gripper"]], axis=-1) for a in predicted_actions]
+        )
+
+        fig, axs = plt.subplots(2, 4, figsize=(20, 8))
+        axs = axs.flatten()
+        sampled_images = list(images[:: max(1, len(images) // 24)])
+        if len(sampled_images) > 0:
+            axs[0].imshow(np.concatenate(sampled_images, axis=1))
+        axs[0].set_title("observations")
+        axs[0].axis("off")
+
+        for i, label in enumerate(action_labels):
+            axs[i + 1].plot(action_series[:, i])
+            axs[i + 1].set_title(label)
+            axs[i + 1].set_xlabel("timestep")
+            axs[i + 1].grid(alpha=0.3)
+
+        fig.tight_layout()
+        fig.savefig(save_path)
+        plt.close(fig)
