+sanitize_tag() {
+    local raw="$1"
+    raw="${raw// /_}"
+    raw="${raw//\//_}"
+    raw="${raw//:/_}"
+    echo "${raw}"
+}
+
+apply_fast_dev_overrides() {
+    if [[ "${FAST_DEV}" != "1" ]]; then
+        return 0
+    fi
+
+    if [[ "${FAST_DEV_BANNER_PRINTED}" == "0" ]]; then
+        echo "[INFO] FAST_DEV=1 enabled: episodes<=${FAST_DEV_EPISODES}, xy_n=${FAST_DEV_XY_N}, robot_n=${FAST_DEV_ROBOT_N}"
+        FAST_DEV_BANNER_PRINTED=1
+    fi
+
+    local nxy="${FAST_DEV_XY_N}"
+    local nrobot="${FAST_DEV_ROBOT_N}"
+
+    # Reduce robot init grid (often a major multiplicative factor)
+    if [[ "${#ROBOT_INIT_XS[@]}" -gt "${nrobot}" ]]; then
+        ROBOT_INIT_XS=("${ROBOT_INIT_XS[@]:0:${nrobot}}")
+    fi
+    if [[ "${#ROBOT_INIT_YS[@]}" -gt "${nrobot}" ]]; then
+        ROBOT_INIT_YS=("${ROBOT_INIT_YS[@]:0:${nrobot}}")
+    fi
+    # Flattened quaternion array in groups of 4 values
+    local q_keep=$(( nrobot * 4 ))
+    if [[ "${#ROBOT_INIT_QUATS[@]}" -gt "${q_keep}" ]]; then
+        ROBOT_INIT_QUATS=("${ROBOT_INIT_QUATS[@]:0:${q_keep}}")
+    fi
+
+    if [[ "${OBJ_VARIATION_MODE}" == "xy" ]]; then
+        if [[ "${#OBJ_INIT_XS[@]}" -gt "${nxy}" ]]; then
+            OBJ_INIT_XS=("${OBJ_INIT_XS[@]:0:${nxy}}")
+        fi
+        if [[ "${#OBJ_INIT_YS[@]}" -gt "${nxy}" ]]; then
+            OBJ_INIT_YS=("${OBJ_INIT_YS[@]:0:${nxy}}")
+        fi
+    elif [[ "${OBJ_VARIATION_MODE}" == "episode" ]]; then
+        local start="${OBJ_EPISODE_START}"
+        local end="${OBJ_EPISODE_END}"
+        local fast_end=$(( start + FAST_DEV_EPISODES ))
+        if (( fast_end < end )); then
+            OBJ_EPISODE_END="${fast_end}"
+        fi
+    fi
+}
+
+get_eval_tag() {
+    if [[ -n "${CURRENT_TASK_LABEL}" ]]; then
+        sanitize_tag "${CURRENT_TASK_LABEL}"
+    else
+        sanitize_tag "${POLICY_SETUP}_${ROBOT}_${ENV_NAME}_${SCENE_NAME}"
+    fi
+}
+
+extract_simplerenv_avg_success() {
+    local log_file="$1"
+    local result_label="${2:-}"
+    if [[ ! -f "${log_file}" ]]; then
+        echo "NA|NA"
+        return 0
+    fi
+
+    local entire partial
+    if [[ -n "${result_label}" ]]; then
+        entire="$(grep -F "[${result_label}] Entire  success:" "${log_file}" | tail -n 1 | grep -oP '(?<=Entire  success: )[0-9.]+' || true)"
+        partial="$(grep -F "[${result_label}] Partial success:" "${log_file}" | tail -n 1 | grep -oP '(?<=Partial success: )[0-9.]+' || true)"
+    else
+        entire="$(grep -oP '(?<=Entire  success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+        partial="$(grep -oP '(?<=Partial success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+    fi
+
+    # Fallback for old format: "Average success: X.XXXX"
+    if [[ -z "${entire}" ]]; then
+        entire="$(grep -oP '(?<=Average success: )[0-9.]+' "${log_file}" | tail -n 1 || true)"
+    fi
+    [[ -z "${entire}" ]] && entire="NA"
+    [[ -z "${partial}" ]] && partial="NA"
+    echo "${entire}|${partial}"
+}
+
+append_task_summary() {
+    local task_label="$1"
+    local run_kind="$2"
+    local cfg_tag="$3"
+    local log_file="$4"
+    local result_label="${5:-}"
+    local success_pair
+    success_pair="$(extract_simplerenv_avg_success "${log_file}" "${result_label}")"
+    local entire partial
+    IFS='|' read -r entire partial <<< "${success_pair}"
+
+    if [[ -z "${TASK_SEEN[${task_label}]+x}" ]]; then
+        TASK_ORDER+=("${task_label}")
+        TASK_SEEN["${task_label}"]=1
+    fi
+
+    TASK_SUMMARY_LINES+=("${task_label}|${run_kind}|${cfg_tag}|${entire}|${partial}|${log_file}")
+}
+
+should_batch_fp_eval() {
+    [[ "${USE_BATCH_SIMPLERENV_FP}" == "1" && "${EVAL_BACKEND}" == "simplerenv" && "${MODE}" == "fp" ]]
+}
+
+enqueue_fp_eval_task() {
+    local task="$1"
+    local model="$2"
+    local data="$3"
+    local task_label="$4"
+
+    mkdir -p "${LOG_BASE}/${OUTPUT_TAG}"
+    if [[ -z "${BATCH_FP_JSON_PATH}" ]]; then
+        BATCH_FP_JSON_PATH="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_batch_tasks_$(date +%Y%m%d_%H%M%S).json"
+        echo "[]" > "${BATCH_FP_JSON_PATH}"
+    fi
+    if [[ -z "${BATCH_FP_LOG_PATH}" ]]; then
+        BATCH_FP_LOG_PATH="${LOG_BASE}/${OUTPUT_TAG}/fp_eval_batch.log"
+    fi
+
+    local robot_init_xs_csv robot_init_ys_csv robot_init_quats_csv obj_init_xs_csv obj_init_ys_csv
+    local obj_episode_range_csv add_kwargs_sep add_kwargs_blob
+    robot_init_xs_csv="$(IFS=,; echo "${ROBOT_INIT_XS[*]}")"
+    robot_init_ys_csv="$(IFS=,; echo "${ROBOT_INIT_YS[*]}")"
+    robot_init_quats_csv="$(IFS=,; echo "${ROBOT_INIT_QUATS[*]}")"
+    obj_init_xs_csv="$(IFS=,; echo "${OBJ_INIT_XS[*]:-}")"
+    obj_init_ys_csv="$(IFS=,; echo "${OBJ_INIT_YS[*]:-}")"
+    obj_episode_range_csv="${OBJ_EPISODE_START},${OBJ_EPISODE_END}"
+    add_kwargs_sep=$'\x1f'
+    add_kwargs_blob="$(IFS="${add_kwargs_sep}"; echo "${ADDITIONAL_ENV_BUILD_KWARGS[*]:-}")"
+
+    python3 - "${BATCH_FP_JSON_PATH}" "${task_label}" "${task}" "${model}" "${data}" \
+        "${UNNORM_KEY}" "${NUM_IMAGES}" "${POLICY_SETUP}" "${ACTION_SCALE}" "${ROBOT}" \
+        "${ENV_NAME}" "${SCENE_NAME}" "${robot_init_xs_csv}" "${robot_init_ys_csv}" "${robot_init_quats_csv}" \
+        "${CONTROL_FREQ}" "${SIM_FREQ}" "${MAX_EPISODE_STEPS}" "${RGB_OVERLAY_PATH}" "${OBS_CAMERA_NAME}" \
+        "${ENABLE_RAYTRACING}" "${ADDITIONAL_ENV_SAVE_TAGS}" "${OBJ_VARIATION_MODE}" "${obj_init_xs_csv}" "${obj_init_ys_csv}" \
+        "${obj_episode_range_csv}" "${add_kwargs_blob}" "${add_kwargs_sep}" <<'PY'
+import json, sys
+
+(
+    path, result_label, task_suite_name, model_path, data_path,
+    unnorm_key, num_images, policy_setup, action_scale, robot,
+    env_name, scene_name, robot_init_xs_csv, robot_init_ys_csv, robot_init_quats_csv,
+    control_freq, sim_freq, max_episode_steps, rgb_overlay_path, obs_camera_name,
+    enable_raytracing, additional_env_save_tags, obj_variation_mode, obj_init_xs_csv, obj_init_ys_csv,
+    obj_episode_range_csv, add_kwargs_blob, add_kwargs_sep,
+) = sys.argv[1:]
+
+def f_list(csv):
+    return [float(x) for x in csv.split(',') if x != '']
+
+def i_list(csv):
+    return [int(x) for x in csv.split(',') if x != '']
+
+obj = {
+    "result_label": result_label,
+    "task_suite_name": task_suite_name,
+    "model": model_path,
+    "data": data_path,
+    "unnorm_key": unnorm_key,
+    "num_images": int(num_images),
+    "policy_setup": policy_setup,
+    "action_scale": float(action_scale),
+    "robot": robot,
+    "env_name": env_name,
+    "scene_name": scene_name,
+    "robot_init_xs": f_list(robot_init_xs_csv),
+    "robot_init_ys": f_list(robot_init_ys_csv),
+    "robot_init_quats": f_list(robot_init_quats_csv),
+    "control_freq": int(control_freq),
+    "sim_freq": int(sim_freq),
+    "max_episode_steps": int(max_episode_steps),
+    "obj_variation_mode": obj_variation_mode,
+    "obj_init_xs": f_list(obj_init_xs_csv),
+    "obj_init_ys": f_list(obj_init_ys_csv),
+    "obj_episode_range": i_list(obj_episode_range_csv),
+    "enable_raytracing": str(enable_raytracing) == "1",
+    "additional_env_build_kwargs": [x for x in add_kwargs_blob.split(add_kwargs_sep) if x],
+}
+
+if rgb_overlay_path:
+    obj["rgb_overlay_path"] = rgb_overlay_path
+if obs_camera_name:
+    obj["obs_camera_name"] = obs_camera_name
+if additional_env_save_tags:
+    obj["additional_env_save_tags"] = additional_env_save_tags
+
+with open(path, 'r', encoding='utf-8') as f:
+    arr = json.load(f)
+arr.append(obj)
+with open(path, 'w', encoding='utf-8') as f:
+    json.dump(arr, f, ensure_ascii=False)
+PY
+
+    BATCH_FP_TASK_LABELS+=("${task_label}")
+    BATCH_FP_LOG_FILES+=("${BATCH_FP_LOG_PATH}")
+}
+
+flush_fp_batch_eval() {
+    if ! should_batch_fp_eval; then
+        return 0
+    fi
+    if [[ -z "${BATCH_FP_JSON_PATH}" || "${#BATCH_FP_TASK_LABELS[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    local model_args=()
+    build_model_args model_args
+
+    echo "[INFO] Running batched FP SimplerEnv eval (${#BATCH_FP_TASK_LABELS[@]} tasks, single model load) ..."
+    if [[ "${USE_NATIVE_OPENVLA_BRANCH}" == "1" ]]; then
+        echo "[INFO] USE_NATIVE_OPENVLA_BRANCH=1: dispatch to sibling SimplerEnv-OpenVLA-clean/main_quant.py"
+        python3 "${REPO_ROOT}/SimplerEnv-OpenVLA-clean/main_quant.py" \
+            --native-openvla \
+            --model "${MODEL_PATH}" \
+            --simplerenv_tasks_json "${BATCH_FP_JSON_PATH}" \
+            |& tee "${BATCH_FP_LOG_PATH}"
+    else
+        python3 main_quant.py \
+            --model "${MODEL_PATH}" \
+            --data "${DATA_PATH}" \
+            "${model_args[@]}" \
+            --eval_simplerenv \
+            --fp_simplerenv_only \
+            --simplerenv_tasks_json "${BATCH_FP_JSON_PATH}" \
+            --seed "${SEED}" \
+            --deterministic \
+            |& tee "${BATCH_FP_LOG_PATH}"
+    fi
+
+    local i task_label log_file
+    for i in "${!BATCH_FP_TASK_LABELS[@]}"; do
+        task_label="${BATCH_FP_TASK_LABELS[$i]}"
+        log_file="${BATCH_FP_LOG_FILES[$i]}"
+        append_task_summary "${task_label}" "fp" "-" "${log_file}" "${task_label}"
+    done
+
+    # reset batch state
+    BATCH_FP_TASK_LABELS=()
+    BATCH_FP_LOG_FILES=()
+    BATCH_FP_JSON_PATH=""
+    BATCH_FP_LOG_PATH=""
+}
+
+print_task_only_summary() {
+    if [[ "${#TASK_ORDER[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Final Task Success ======================"
+    for task_label in "${TASK_ORDER[@]}"; do
+        local parts=()
+        for record in "${TASK_SUMMARY_LINES[@]}"; do
+            local r_task run_kind cfg_tag entire partial log_file
+            IFS='|' read -r r_task run_kind cfg_tag entire partial log_file <<< "${record}"
+            if [[ "${r_task}" != "${task_label}" ]]; then
+                continue
+            fi
+
+            if [[ "${run_kind}" == "fp" ]]; then
+                parts+=("fp: entire=${entire} partial=${partial}")
+            else
+                parts+=("${cfg_tag}: entire=${entire} partial=${partial}")
+            fi
+        done
+
+        echo "${task_label}: ${parts[*]}"
+    done
+    echo "=========================================================="
+}
+
+print_task_summary() {
+    if [[ "${#TASK_SUMMARY_LINES[@]}" -eq 0 ]]; then
+        return 0
+    fi
+
+    echo
+    echo "================ Per-task Success Summary ================"
+    printf "%-30s %-10s %-12s %-10s %-10s\n" "task" "run" "config" "entire" "partial"
+    for record in "${TASK_SUMMARY_LINES[@]}"; do
+        local task_label run_kind cfg_tag entire partial log_file
+        IFS='|' read -r task_label run_kind cfg_tag entire partial log_file <<< "${record}"
+        printf "%-30s %-10s %-12s %-10s %-10s\n" "${task_label}" "${run_kind}" "${cfg_tag}" "${entire}" "${partial}"
+    done
+    echo "=========================================================="
+
+    print_task_only_summary
+}
