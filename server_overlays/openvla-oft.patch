+def _run_openvla_simplerenv_fp_mode(args: argparse.Namespace) -> None:
+    if not args.simplerenv_tasks_json:
+        raise NotImplementedError(
+            "simplerenv_fp now requires --simplerenv_tasks_json. "
+            "For official benchmark subsets, use --eval_mode simplerenv_official."
+        )
+
+    clean_root = _clean_repo_root()
+    if str(clean_root) not in sys.path:
+        sys.path.insert(0, str(clean_root))
+    ms2_pkg_root = clean_root / "ManiSkill2_real2sim"
+    if str(ms2_pkg_root) not in sys.path:
+        sys.path.insert(0, str(ms2_pkg_root))
+    from simpler_env.evaluation.maniskill2_evaluator import maniskill2_evaluator
+
+    OpenVLAInference = _load_openvla_fp_class(clean_root)
+    tasks = _load_simplerenv_task_list(args.simplerenv_tasks_json)
+    print(f"[SimplerEnv-FP] Loaded {len(tasks)} tasks from {args.simplerenv_tasks_json}")
+
+    model_cache: dict[str, Any] = {}
+    for i, task_dict in enumerate(tasks):
+        task_args, label = _build_task_args_from_dict(args, task_dict, i)
+
+        if not task_args.env_name or not task_args.scene_name:
+            raise ValueError(f"{label}: --env_name and --scene_name are required")
+        if task_args.action_scale <= 0:
+            raise ValueError(f"{label}: --action_scale must be positive")
+        if task_args.obj_variation_mode == "xy":
+            if len(task_args.obj_init_xs) == 0 or len(task_args.obj_init_ys) == 0:
+                raise ValueError(f"{label}: obj_init_xs and obj_init_ys are required when obj_variation_mode=xy")
+        else:
+            if len(task_args.obj_episode_range) != 2 or not (
+                0 <= task_args.obj_episode_range[0] < task_args.obj_episode_range[1]
+            ):
+                raise ValueError(f"{label}: obj_episode_range must be [start, end] with 0 <= start < end")
+
+        cache_key = str(task_args.model)
+        if cache_key not in model_cache:
+            model_cache[cache_key] = OpenVLAInference(
+                saved_model_path=task_args.model,
+                unnorm_key=getattr(task_args, "unnorm_key", None),
+                policy_setup=task_args.policy_setup,
+                action_scale=task_args.action_scale,
+            )
+        model = model_cache[cache_key]
+        _apply_policy_runtime_config(model, task_args.policy_setup, getattr(task_args, "unnorm_key", None))
+        model.action_scale = task_args.action_scale
+
+        runtime_args = _make_runtime_args_for_fp(task_args)
+        os.makedirs(task_args.logging_dir, exist_ok=True)
+        print(f"\n[{label}]")
+        eval_results = maniskill2_evaluator(model, runtime_args)
+        entire_arr, partial_arr = _normalize_eval_results(eval_results)
+        n = len(entire_arr)
+        avg_entire = float(np.mean(entire_arr)) if n > 0 else 0.0
+        avg_partial = float(np.mean(partial_arr)) if n > 0 else 0.0
+        print(f"[{label}] Entire  success: {avg_entire:.4f} ({avg_entire*100:.1f}%) — {int(np.sum(entire_arr))}/{n}")
+        print(f"[{label}] Partial success: {avg_partial:.4f} ({avg_partial*100:.1f}%) — {int(np.sum(partial_arr))}/{n}")
+
+
+def _strip_cli_args(argv: list[str], flags_with_values: set[str], boolean_flags: set[str]) -> list[str]:
+    stripped: list[str] = []
+    skip_next = False
+    for token in argv:
+        if skip_next:
+            skip_next = False
+            continue
+        if token in flags_with_values:
+            skip_next = True
+            continue
+        if token in boolean_flags:
+            continue
+        if any(token.startswith(prefix + "=") for prefix in flags_with_values | boolean_flags):
+            continue
+        stripped.append(token)
+    return stripped
+
