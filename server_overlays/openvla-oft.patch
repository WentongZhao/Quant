+
+check_vulkan() {
+    if [[ "${EVAL_BACKEND}" != "simplerenv" ]]; then
+        return 0
+    fi
+
+    echo "[INFO] Checking Vulkan availability for headless SimplerEnv eval..."
+
+    if ! command -v vulkaninfo >/dev/null 2>&1; then
+        echo "[WARN] vulkaninfo not found; skipping Vulkan preflight. If SimplerEnv still crashes,"
+        echo "       install vulkan-tools and verify the NVIDIA Vulkan driver inside this environment."
+        return 0
+    fi
+
+    local vulkan_summary
+    if ! vulkan_summary="$(vulkaninfo --summary 2>&1)"; then
+        echo "[ERROR] Vulkan preflight failed. SimplerEnv evaluation needs a working Vulkan renderer."
+        echo "${vulkan_summary}"
+        echo "[HINT] SAPIEN does not support CPU rendering for this path. Check VK_ICD_FILENAMES,"
+        echo "       the NVIDIA driver install, and whether the container exposes Vulkan libraries."
+        exit 1
+    fi
+
+    if ! grep -qiE "driverName[[:space:]]*=[[:space:]]*NVIDIA|deviceName[[:space:]]*=[[:space:]]*NVIDIA" <<<"${vulkan_summary}"; then
+        echo "[ERROR] Vulkan preflight did not find an NVIDIA Vulkan device."
+        echo "${vulkan_summary}"
+        echo "[HINT] This usually means the container cannot see the real Vulkan driver."
+        exit 1
+    fi
+
+    echo "[INFO] Vulkan preflight passed."
+}
