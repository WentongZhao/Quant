+# ---------- 1. Coke Can Visual Matching (pick_coke_can_visual_matching.sh) ----------
+run_google_coke_visual_matching() {
+    echo "[INFO] === Coke Can Visual Matching (4 URDF × 3 orientations) ==="
+    local -a opts=("lr_switch=True" "laid_vertically=True" "upright=True")
+    local -a labs=(horizontal vertical standing)
+    for uv in "${VISUAL_MATCHING_URDF_VERSIONS[@]}"; do
+        for i in "${!opts[@]}"; do
+            _init_coke_xy
+            ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+            RGB_OVERLAY_PATH="${SIMPLERENV_ROOT}/ManiSkill2_real2sim/data/real_inpainting/google_coke_can_real_eval_1.png"
+            ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}" "urdf_version=${uv}")
+            CURRENT_TASK_LABEL="coke_vm_${labs[$i]}_urdf_${uv}"
+            run_current_task
+        done
+    done
+}
+
+# ---------- 2. Coke Can Variant Aggregation (pick_coke_can_variant_agg.sh) ----------
+run_google_coke_variant_agg() {
+    echo "[INFO] === Coke Can Variant Aggregation ==="
+    local -a opts=("lr_switch=True" "laid_vertically=True" "upright=True")
+    local -a labs=(horizontal vertical standing)
+
+    # 2a) Base
+    for i in "${!opts[@]}"; do
+        _init_coke_xy
+        ENV_NAME="GraspSingleOpenedCokeCanInScene-v0"
+        ADDITIONAL_ENV_BUILD_KWARGS=("${opts[$i]}")
+        CURRENT_TASK_LABEL="coke_var_base_${labs[$i]}"
+        run_current_task
+    done
