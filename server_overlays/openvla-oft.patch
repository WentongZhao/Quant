+def _auto_oft_action_calibration(task_args: argparse.Namespace) -> tuple[float, float, float, float, int]:
+    env_name = str(getattr(task_args, "env_name", "")).lower()
+    policy_setup = str(getattr(task_args, "policy_setup", "")).lower()
+
+    xyz_scale, rot_scale, grip_scale = 1.0, 1.0, 1.0
+    deadzone = 0.5 if policy_setup == "google_robot" else 0.5
+    sticky_repeat = 15 if policy_setup == "google_robot" else 1
+
+    if "drawer" in env_name:
+        xyz_scale, rot_scale, grip_scale = 1.4, 1.25, 1.2
+        if policy_setup == "google_robot":
+            deadzone, sticky_repeat = 0.35, 18
+    elif ("pick" in env_name) or ("coke" in env_name):
+        xyz_scale, rot_scale, grip_scale = 1.3, 1.15, 1.5
+        if policy_setup == "google_robot":
+            deadzone, sticky_repeat = 0.30, 18
+    elif ("put" in env_name) or ("stack" in env_name):
+        xyz_scale, rot_scale, grip_scale = 1.2, 1.1, 1.2
+        if policy_setup == "google_robot":
+            deadzone, sticky_repeat = 0.35, 15
+    elif "move_near" in env_name:
+        xyz_scale, rot_scale, grip_scale = 1.15, 1.05, 1.0
+        if policy_setup == "google_robot":
+            deadzone, sticky_repeat = 0.40, 12
+
+    return xyz_scale, rot_scale, grip_scale, deadzone, sticky_repeat
