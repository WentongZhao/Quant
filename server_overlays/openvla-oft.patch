+validate_eval_scope() {
+    if [[ "${EVAL_BACKEND}" != "simplerenv" ]]; then
+        return 0
+    fi
+
+    if [[ "${GOOGLE_ONLY}" == "1" ]]; then
+        if [[ "${POLICY_SETUP}" != "google_robot" ]]; then
+            echo "[ERROR] GOOGLE_ONLY=1 时，POLICY_SETUP 必须为 google_robot，当前为 ${POLICY_SETUP}"
