+++ b/scripts/eval_libero_minimal_once.sh
@@ -0,0 +1,154 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Minimal OpenVLA-OFT LIBERO evaluation launcher.
+# Default behavior:
+# - run four LIBERO suites (spatial/object/goal/10)
+# - each task runs one rollout (num_trials_per_task=1)
+# - no wandb, no extra pruning logic
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "${ROOT_DIR}"
+
+export TOKENIZERS_PARALLELISM=false
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-7}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+# Default to offline/local-only behavior. Set any of these to 0 to allow network downloads.
+export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
+export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
+export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
+# Use repo-local LIBERO config to avoid cross-env path contamination from ~/.libero/config.yaml.
+export LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${ROOT_DIR}/.libero}"
+
+# all | single
+RUN_GROUP="${RUN_GROUP:-all}"
+TASK_SUITE_NAME="${TASK_SUITE_NAME:-libero_spatial}"
+
+# Keep this minimal and fast by default.
+NUM_TRIALS_PER_TASK="${NUM_TRIALS_PER_TASK:-1}"
+SEED="${SEED:-7}"
+USE_WANDB="${USE_WANDB:-False}"
+CENTER_CROP="${CENTER_CROP:-True}"
+LOAD_IN_8BIT="${LOAD_IN_8BIT:-False}"
+LOAD_IN_4BIT="${LOAD_IN_4BIT:-False}"
+LOCAL_LOG_DIR="${LOCAL_LOG_DIR:-${ROOT_DIR}/experiments/logs}"
+
+# Global checkpoint override for all suites (optional).
+PRETRAINED_CHECKPOINT="${PRETRAINED_CHECKPOINT:-}"
+
+# Suite-specific checkpoints (used when PRETRAINED_CHECKPOINT is empty).
+MODEL_ROOT="${MODEL_ROOT:-/data5/cgk_lyy_0/models}"
+CKPT_LIBERO_SPATIAL="${CKPT_LIBERO_SPATIAL:-${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-spatial}"
+CKPT_LIBERO_OBJECT="${CKPT_LIBERO_OBJECT:-${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-object}"
+CKPT_LIBERO_GOAL="${CKPT_LIBERO_GOAL:-${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-goal}"
+CKPT_LIBERO_10="${CKPT_LIBERO_10:-${MODEL_ROOT}/openvla-7b-oft-finetuned-libero-10}"
+
+check_env() {
+    python - <<'PY'
+import torch
+print(f"[INFO] torch={torch.__version__}, cuda={torch.version.cuda}, cuda_available={torch.cuda.is_available()}")
+if not torch.cuda.is_available():
+    raise SystemExit("[ERROR] CUDA is not available.")
+PY
+
+    python - <<'PY'
+import libero
+print("[INFO] LIBERO import ok:", libero.__file__)
+PY
+
+    python - <<'PY'
+import os
+from pathlib import Path
+import libero
+
+benchmark_root = (Path(libero.__file__).resolve().parent / "libero").resolve()
+cfg_dir = Path(os.environ["LIBERO_CONFIG_PATH"]).expanduser()
+cfg_dir.mkdir(parents=True, exist_ok=True)
+config_path = cfg_dir / "config.yaml"
+
+path_map = {
+    "benchmark_root": benchmark_root,
+    "bddl_files": benchmark_root / "bddl_files",
+    "init_states": benchmark_root / "init_files",
+    "datasets": (benchmark_root / "../datasets").resolve(),
+    "assets": benchmark_root / "assets",
+}
+with open(config_path, "w", encoding="utf-8") as f:
+    for key in ["benchmark_root", "bddl_files", "init_states", "datasets", "assets"]:
+        f.write(f"{key}: {path_map[key]}\n")
+
+print("[INFO] LIBERO benchmark_root:", benchmark_root)
+print("[INFO] LIBERO config:", config_path)
+PY
+}
+
+resolve_ckpt() {
+    local suite="$1"
+    if [[ -n "${PRETRAINED_CHECKPOINT}" ]]; then
+        echo "${PRETRAINED_CHECKPOINT}"
+        return 0
+    fi
+
+    case "${suite}" in
+        libero_spatial) echo "${CKPT_LIBERO_SPATIAL}" ;;
+        libero_object) echo "${CKPT_LIBERO_OBJECT}" ;;
+        libero_goal) echo "${CKPT_LIBERO_GOAL}" ;;
+        libero_10) echo "${CKPT_LIBERO_10}" ;;
+        *)
+            echo "[ERROR] Unknown suite: ${suite}" >&2
+            exit 1
+            ;;
+    esac
+}
+
+run_one_suite() {
+    local suite="$1"
+    local ckpt="$2"
+
+    echo
+    echo "[INFO] Running suite=${suite}"
+    echo "[INFO] checkpoint=${ckpt}"
+    echo "[INFO] num_trials_per_task=${NUM_TRIALS_PER_TASK}, seed=${SEED}, cuda=${CUDA_VISIBLE_DEVICES}"
+    echo "[INFO] offline: HF_HUB_OFFLINE=${HF_HUB_OFFLINE}, TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE}, HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE}"
+
+    if [[ "${HF_HUB_OFFLINE}" != "0" && "${HF_HUB_OFFLINE}" != "false" && ! -d "${ckpt}" ]]; then
+        echo "[ERROR] Offline mode is enabled, but checkpoint is not a local directory: ${ckpt}"
+        echo "[HINT] Set PRETRAINED_CHECKPOINT (or CKPT_LIBERO_*) to a local path under ${MODEL_ROOT},"
+        echo "       or set HF_HUB_OFFLINE=0 to allow downloading from Hugging Face."
+        exit 1
+    fi
+
+    python experiments/robot/libero/run_libero_eval.py \
+        --pretrained_checkpoint "${ckpt}" \
+        --task_suite_name "${suite}" \
+        --num_trials_per_task "${NUM_TRIALS_PER_TASK}" \
+        --seed "${SEED}" \
+        --center_crop "${CENTER_CROP}" \
+        --use_wandb "${USE_WANDB}" \
+        --load_in_8bit "${LOAD_IN_8BIT}" \
+        --load_in_4bit "${LOAD_IN_4BIT}" \
+        --local_log_dir "${LOCAL_LOG_DIR}" \
+        --run_id_note "minimal_once_${suite}"
+}
+
+main() {
+    check_env
+
+    case "${RUN_GROUP}" in
+        all)
+            local suites=(libero_spatial libero_object libero_goal libero_10)
+            for suite in "${suites[@]}"; do
+                run_one_suite "${suite}" "$(resolve_ckpt "${suite}")"
+            done
+            ;;
+        single)
+            run_one_suite "${TASK_SUITE_NAME}" "$(resolve_ckpt "${TASK_SUITE_NAME}")"
+            ;;
+        *)
+            echo "[ERROR] RUN_GROUP must be all or single. Current: ${RUN_GROUP}"
+            exit 1
+            ;;
+    esac
+}
+
+main "$@"
