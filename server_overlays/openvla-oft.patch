+#!/usr/bin/env bash
+set -euo pipefail
+
+# 推荐入口说明：
+# - OpenVLA 的 SimplerEnv 评测通过 main_quant.py 完成，而不是 simpler_env/main_inference.py。
+# - 原因是这里要直接复用 main_quant.py 中已经加载/量化完成的内存模型对象，
+#   避免重新从 checkpoint 构造策略时丢失量化状态。
+# - 本脚本只是对 main_quant.py 的常用参数做一层封装。
+
+# 当前脚本所在目录（避免仓库移动后路径错乱）
+ICML_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SIMPLERENV_ROOT="$(cd "${ICML_DIR}/.." && pwd)"
+REPO_ROOT="$(cd "${SIMPLERENV_ROOT}/.." && pwd)"
+cd "${ICML_DIR}"
+
+export DISPLAY=""
+export TOKENIZERS_PARALLELISM=false
+export OMP_NUM_THREADS=8
+export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
+export PYTHONPATH="${ICML_DIR}:${ICML_DIR}/LIBERO:${ICML_DIR}/LIBERO/libero:${SIMPLERENV_ROOT}:${SIMPLERENV_ROOT}/ManiSkill2_real2sim:${PYTHONPATH:-}"
+export MS2_RENDERER_LOG_LEVEL=error
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-7}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+
+CALIB_SAMPLING=proprio_stratified
+CALIB_TAG=proprio_stratified
+N_SAMPLES=256
+SEED=7
+
+# SmoothQuant knobs
+SQ_ALPHA=0.5
+SQ_SCALE_MODE=max
+
+LOG_BASE="${ICML_DIR}/smoothquant_logs"
+SCALE_BASE="${ICML_DIR}/smoothquant_scales"
+
+# 评测后端：
+#   libero     -> 跑 LIBERO 评测
+#   simplerenv -> 跑 SimplerEnv 评测
+EVAL_BACKEND="simplerenv"
+
+# 运行模式：
+#   fp    -> 只跑原模型基线评测
+#   quant -> 只跑量化流程
+#   all   -> 先跑原模型，再跑量化
+MODE="fp"
+
+# SimplerEnv evaluation config
+GOOGLE_ONLY=0
+POLICY_SETUP="widowx_bridge"
+ROBOT="widowx"
+ENV_NAME="PutCarrotOnPlateInScene-v0"
+SCENE_NAME="bridge_table_1_v1"
+LOGGING_DIR="${ICML_DIR}/simplerenv_results"
+RGB_OVERLAY_PATH="${SIMPLERENV_ROOT}/ManiSkill2_real2sim/data/real_inpainting/bridge_real_eval_1.png"
+OBS_CAMERA_NAME=""
+ACTION_SCALE="${ACTION_SCALE:-1.0}"
+ENABLE_RAYTRACING=0
+ADDITIONAL_ENV_SAVE_TAGS=""
+ADDITIONAL_ENV_BUILD_KWARGS=()
+CONTROL_FREQ=5
+SIM_FREQ=500
+MAX_EPISODE_STEPS=60
+ROBOT_INIT_XS=(0.147)
+ROBOT_INIT_YS=(0.028)
+ROBOT_INIT_QUATS=(0.0 0.0 0.0 1.0)
+OBJ_VARIATION_MODE="episode"
+OBJ_INIT_XS=()
+OBJ_INIT_YS=()
+OBJ_EPISODE_START=0
+OBJ_EPISODE_END=24
+
+# Action un-normalization key:
+# - If user explicitly exports UNNORM_KEY, treat it as a global override for all tasks.
+# - Otherwise auto-select by policy setup (widowx_bridge/google_robot).
+if [[ -n "${UNNORM_KEY+x}" ]]; then
+    UNNORM_KEY_GLOBAL_OVERRIDE="${UNNORM_KEY}"
+else
+    UNNORM_KEY_GLOBAL_OVERRIDE=""
+fi
+UNNORM_KEY_WIDOWX_DEFAULT="${UNNORM_KEY_WIDOWX_DEFAULT:-bridge_orig}"
+UNNORM_KEY_GOOGLE_DEFAULT="${UNNORM_KEY_GOOGLE_DEFAULT:-fractal20220817_data}"
+UNNORM_KEY="${UNNORM_KEY_GLOBAL_OVERRIDE:-${UNNORM_KEY_WIDOWX_DEFAULT}}"
+
+# Model / data config
+# 按需改成你本机实际路径；这里保留占位默认值。
+MODEL_PATH="${MODEL_PATH:-/data5/cgk_lyy_0/models/openvla-7b}"
+DATA_PATH="${DATA_PATH:-/data5/cgk_lyy_0/datasets/libero_10_no_noops/1.0.0}"
+# 仅用于日志/输出分组标签；不代表在跑 LIBERO benchmark。
+TASK_NAME="openvla_base"
+# 任务组：
+#   single      -> 仅跑当前 ENV_NAME/SCENE_NAME/ROBOT 配置
+#   widowx_all  -> 依次跑 Spoon/Carrot/Stack/Eggplant 四个 WidowX 任务
+#   google_sheet -> 依次跑表格里的 Google 任务列
+TASK_GROUP="${TASK_GROUP:-google_sheet}"
+
+# 输出分组标签（仅影响日志/scale目录命名，不影响评测后端与 task_suite_name）
+# - libero 后端：默认沿用 TASK_NAME
+# - simplerenv 后端：默认命名为 simplerenv_<TASK_NAME>_<TASK_GROUP>
+# 可通过环境变量 OUTPUT_TAG 手动覆盖。
+OUTPUT_TAG="${OUTPUT_TAG:-}"
+if [[ -z "${OUTPUT_TAG}" ]]; then
+    if [[ "${EVAL_BACKEND}" == "simplerenv" ]]; then
+        OUTPUT_TAG="simplerenv_${TASK_NAME}_${TASK_GROUP}"
+    else
+        OUTPUT_TAG="${TASK_NAME}"
+    fi
+fi
+
+# ============ 全量 Google 评测配置 ============
+# Visual Matching URDF 变体 (对齐参考脚本中的 urdf_version_arr)
+VISUAL_MATCHING_URDF_VERSIONS=(
+    None
+    "recolor_tabletop_visual_matching_1"
+    "recolor_tabletop_visual_matching_2"
+    "recolor_cabinet_visual_matching_1"
+)
+
